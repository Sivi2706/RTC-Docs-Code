\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Electronics architecture. Three Pico boards in three power domains (teal: logger; blue: recovery A; amber: recovery B); the logger can fail without affecting recovery, and recovery A can fail without affecting recovery B. A FRAM checkpoint memory on each Pico (I$^2$C1, Sec.~\ref {sec:state}) is omitted for clarity. Illustrative; wiring and fault independence remain to be approved.}}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:arch}{{2}{6}{Electronics architecture. Three Pico boards in three power domains (teal: logger; blue: recovery A; amber: recovery B); the logger can fail without affecting recovery, and recovery A can fail without affecting recovery B. A FRAM checkpoint memory on each Pico (I$^2$C1, Sec.~\ref {sec:state}) is omitted for clarity. Illustrative; wiring and fault independence remain to be approved}{figure.caption.2}{}}
