@article{ WOS:A1996VG83600009,
Author = {Theodore, JC and Guibert, JP and Selince, G},
Title = {Autonomous navigation for long range stand off missiles.},
Journal = {RECHERCHE AEROSPATIALE},
Year = {1996},
Number = {3},
Pages = {227-237},
Abstract = {This paper is concerned with precise autonomous navigation of low
   altitude cruise missiles and presents an overview of the different
   solutions already existing or under development in the near future.
   Capabilities and limitations of inertial navigation are first reviewed
   pointing out critical needs of auxiliary data based on observations
   extracted from the scene overflown.
   Navigation update concept is then presented. A review of data processing
   techniques and associated sensors is given with a specific emphasis on
   association trade-offs and their pros and cons.
   The navigation system of the Apache missile is then described as an
   illustration.
   Finally future prospects from technical development of sensors and data
   processing are underlined taking into account the major constraints
   namely cost and mission preparation complexity reduction.},
