@inproceedings{ WOS:001788453700490,
Author = {Tapu, Alexandru and Dragulinescu, Ana-Maria},
Book-Group-Author = {IEEE},
Title = {IoT-enabled Integrated Avionic System for Supersonic Multi-purpose
   Rockets with Real-Time Telemetry and Autonomous Flight Control},
Booktitle = {GLOBECOM 2025-2025 IEEE GLOBAL COMMUNICATIONS CONFERENCE},
Series = {IEEE Global Telecommunications Conference (Globecom)},
Year = {2025},
Pages = {2964-2969},
Note = {2025 Global Communications Conference-GLOBECOM, Taipei, TAIWAN, DEC
   08-12, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {Recent advances in the integration of Internet of Things (IoT)
   technologies and sensor networks have significantly enhanced the
   autonomy and telemetry capabilities of aerospace systems, particularly
   in unmanned aerial vehicles, small satellites, and sounding rockets.
   However, limited attention has been given to the specific challenges
   posed by reusable supersonic missiles, which require compact,
   cost-efficient, and robust avionics capable of real-time decision-making
   under extreme dynamic conditions. This paper presents the design,
   implementation, and validation of a high-performance avionic system
   developed for reusable supersonic missile platforms. The system features
   a modular sensor suite consisting of barometric transducers, inertial
   measurement units (IMUs), and a GNSS receiver, supporting data
   acquisition rates up to 400 Hz and real-time telemetry transmission at
   9.6 kbps. During test flights, the system demonstrated accurate tracking
   of ascent and descent phases, with apogee detection occurring at 42
   seconds and 6,600 meters altitude, and maximum recorded velocity
   exceeding 550 m/s. The onboard software integrates optimized sensor
   fusion and signal processing algorithms-including Kalman and
   complementary filters, and quaternion-based attitude estimation-enabling
   nine-degree-of-freedom orientation tracking and deterministic
   identification of events such as engine burnout, apogee, and parachute
   deployment.},
