Pages = {2278-2283},
Note = {International Conference on Mechatronics and Control (ICMC), Jinzhou,
   PEOPLES R CHINA, JUL 03-05, 2014},
Organization = {IEEE Ind Elect Soc; IEEE Harbin Sect; Bohai Univ; Beijing Aerosp Automat
   Control Inst; Harbin Inst Technol},
Abstract = {This After the alignment of the missile's inertial platform system, the
   inertial platform will be maintained in the inertial frame, this make
   the inspect of the platform misalignment hard to be achieved by using
   conventional algorithm. In this paper, an approach of misalignment
   self-inspect for missile's inertial platform is described. By using the
   in-motion alignment technique of strap-down inertial navigation system,
   the attitude of the inertial platform to local level frame can be
   described real-time by a direction cosine matrix. Then the direction
   cosine matrix at the time when the alignment has been done can be
   calculated to inspect the inertial platform misalignment. Simulation
   results show that the inertial platform misalignment can be inspected
   precisely by using the proposed approach.},
