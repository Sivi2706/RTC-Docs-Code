@inproceedings{ WOS:001659589700057,
Author = {Cortancioglu, Arda and Essiz, Gorkem and Avcioglu, Haydar Tolga},
Book-Group-Author = {AIAA},
Title = {Range Estimation Using Detector Image Size Measurements on IR Seeking
   Cruise Missile Systems},
Booktitle = {AIAA SCITECH 2025 FORUM},
Year = {2025},
Note = {2025 AIAA SCITECH Forum, Orlando, FL, JAN 06-10, 2025},
Abstract = {Cruise missile systems primarily depends on imaging infrared seekers
   (IIR) to engage with their target of interest, leveraging their passive
   nature to evade detection, compared to active sensor counterparts.
   Despite their advantage on active seekers, IIR ones lack the ability to
   provide significant range-to-go information, being used to optimize hit
   performance of the missile. In this paper, an innovative range
   estimation approach is introduced, utilizing image size measurements
   obtained from infrared detector of seeker and travelled distance data
   from inertial navigation system (INS) integrated through Extended Kalman
   Filter (EKF) framework. Performance of proposed range to go estimation
   algorithm is evaluated under potential scenarios for cruise missile
   missions. High-fidelity missile-target engagement simulation results
   verifies that performance of the proposed algorithm meet expectations
   for cruise missile missions and holds promising improvements for
   guidance performance.},
