@inproceedings{ WOS:000275973601464,
Author = {Shan Yanhu and Zhen Guoyong},
Editor = {Wen, TD},
Title = {The design and realization of data exchange protocol based on interface
   of USB 2.0},
Booktitle = {ISTM/2009: 8TH INTERNATIONAL SYMPOSIUM ON TEST AND MEASUREMENT, VOLS 1-6},
Year = {2009},
Pages = {3598-3601},
Note = {8th International Symposium on Test Measure, Chongqing, PEOPLES R CHINA,
   AUG 23-26, 2009},
Organization = {China Ordance Soc; Chinese Assoc Higher Educ},
Abstract = {A data exchange protocol between the test system and the PC computer is
   designed based on USB2.0 transmission control chip CY7C68013. The
   transmission system mainly uses master mode of GPIF. This paper gives
   the physical layer design of the hardware circuit of the system control
   module, and introduces the working principle and characteristics of
   CY7C68013 internal FIFO and programmable general-purpose interface
   (GPIF), and the configuration of the endpoint. The protocol effectively
   solves the problem of high-speed transmission of a wide range of data
   between the test system and the PC host. Now, the transport protocol has
   been successfully used in the general missile telemetry system.},
