Year = {2014},
Pages = {3854-3859},
Note = {11th World Congress on Intelligent Control and Automation, Shenyang,
   PEOPLES R CHINA, JUN 29-JUL 04, 2014},
Abstract = {In this paper, we investigate the problem of autonomous integrated
   navigation of strapdown inertial navigation system (SINS)/celestial
   navigation system (CNS) for a ballistic missile. To handle the nonlinear
   missile dynamic model, three filtering methods including extended Kalman
   filter (EKF), extended Kalman particle filter (EKPF) and unscented
   particle filter (UPF) are utilized to fusion the integrated navigation
   system and improve the navigation accuracy. The performance of the
   navigation system based on the three methods is analyzed and compared.
   Simulation results indicate that the UPF can provide the highest
   navigation accuracy with the price of highest computation burden.},
