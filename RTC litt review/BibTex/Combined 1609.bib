@inproceedings{ WOS:000582416900060,
Author = {Liu, Bohan and Zhao, Xiaoming and Zuo, Wenlong and Chen, Xin and Liang,
   Hu},
Book-Group-Author = {IEEE},
Title = {NOISE SUPPRESSION SOLUTION FOR ULTRA-HIGH PRECISION FIBER OPTIC
   GYROSCOPE},
