@article{ WOS:001764882900006,
Author = {Zhang, Chengjie and Fang, Zhigeng and Shi, Rui and Liu, Youpeng and
   Chen, Zhongwen},
Title = {Test Time Optimization for Highly Reliable Redundant Systems With
   Single-Machine Similarity and Nonuniform Labor-Hours},
Journal = {IEEE TRANSACTIONS ON RELIABILITY},
Year = {2026},
Volume = {75},
Pages = {1744-1752},
Abstract = {Reliability demonstration of highly reliable redundant systems
   traditionally requires large-sample, long-duration tests, resulting in
   prohibitively lengthy test cycles and excessive resource consumption.
   However, existing approaches have not fully exploited system redundancy
   structure and similarity to reduce test time. To address this gap, this
   article integrates redundancy structure, single-machine similarity, and
   nonuniform labor-hour information into a system-level test time
   minimization framework. First, an analytical expression for test time is
   derived by leveraging the sample-size expansion effect of redundant
   structures. Second, a similarity conversion coefficient is defined to
   incorporate single-machine similarity into the optimization model.
   Third, Bayesian methods are utilized to integrate prior test
   information. Through system-level optimization that optimally allocates
   reliability targets to individual units, this work achieves joint
   optimization of redundancy, similarity, and prior information for the
   first time. A case study demonstrates that the proposed approach reduces
   test time by up to 74\% compared with conventional methods that use
   similarity solely for prior construction. This study provides an
   efficient solution for rapid reliability verification of aerospace
   systems, and the proposed framework is applicable to other exponential
   lifetime systems with redundant architectures.},
