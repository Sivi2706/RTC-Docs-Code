Title = {A bond graph of linearized pitch-plane missile dynamics},
Booktitle = {PROCEEDINGS OF THE 1999 INTERNATIONAL CONFERENCE ON BOND GRAPH MODELING
   AND SIMULATION (ICBGM'99)},
Series = {SIMULATION SERIES},
Year = {1999},
Volume = {31},
