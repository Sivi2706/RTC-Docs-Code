@inproceedings{ WOS:000273183200364,
Author = {Yao, Jun and Wang, Xin and Li, Junmiao},
Book-Group-Author = {IEEE},
Title = {Influence on Rocket Fall Points Distribution Due to Random Wind},
Booktitle = {ICIEA: 2009 4TH IEEE CONFERENCE ON INDUSTRIAL ELECTRONICS AND
   APPLICATIONS, VOLS 1-6},
Year = {2009},
Pages = {1851-1854},
Note = {4th IEEE Conference on Industrial Electronics and Applications, Xian,
   PEOPLES R CHINA, MAY 25-27, 2009},
Organization = {IEEE, Ind Elect Chapter Singapore; NW Polytech Univ; IEEE Xian Sect;
   IEEE Control Syst Soc; IEEE Ind Elect Soc; Natl Nat Sci Fdn China; Inst
   Engn \& Technol; Shaanxi Key Lab Informat Acquist \& Proc},
Abstract = {Random wind is one of the important factors causing rocket fall points
   distribution. For the large and complex system, it is difficult to
   analyze the reliability using the analytic methods, but the computer
   simulation is an effective way. In this paper, simulation for flight
   control system is studied in detail by considering wind as typical
   random process. The engineered model of wind is established and
   randomized. While establishing the dynamics equations of the rocket's
   passive trajectory, theoretic analysis has been carried out using tire
   traditional statistical analysis approach-Monte-Carlo method in order to
   simulate fall points distribution and predict rocket impact point under
   random wind. Through simulation, the effect results of all parameters
   characterizing the nature of wind on rocket fall points distribution are
   obtained and effect of wind on the rocket fall points distribution is
   analyzed effectively. This provides the experiment data for increasing
   the firing accuracy of the rocket in order to decrease the fall points
   distribution of the rocket and correct trajectory. The results of this
   paper provide some theoretic reference for trajectory design.},
