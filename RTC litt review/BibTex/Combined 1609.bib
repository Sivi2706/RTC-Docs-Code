@inproceedings{ WOS:000455682100270,
Author = {Krishnan, Ranjani and Lalithambika, V. R.},
Book-Group-Author = {IEEE},
Title = {A Comparison of AFDX and 1553B Protocols Using Formal Verification},
Booktitle = {2018 INTERNATIONAL CONFERENCE ON ADVANCES IN COMPUTING, COMMUNICATIONS
   AND INFORMATICS (ICACCI)},
Year = {2018},
Pages = {1617-1623},
Note = {7th International Conference on Computing, Communications and
   Informatics (ICACCI), Bangalore, INDIA, SEP 19-22, 2018},
Organization = {PES Inst Technol, Bangalore South Campus; IEEE; IEEE Communicat Soc;
   IEEE Photon Soc; IEEE Robot \& Automat Soc},
Abstract = {Safety critical systems like aircrafts, launch vehicles and satellites
   require a reliable communication protocol to guarantee their functioning
   without errors. Equally important is the validation and verification of
   the hardware and software in such systems to avoid unexpected faults
   during flight. A comparison of two widely used standards, AFDX and
   MIL-STD-1553B, is attempted through formal verification in this work.
   The robustness of AFDX protocol, used in aviation, is validated by model
   checking with SPIN. Similarly, the MIL-STD-1553B protocol, widely used
   in the launch vehicle arena, is modelled and verified using SPIN. Each
   element in both protocols is represented as a process, along with
   necessary channels and timing parameters, and random errors are
   simulated. The required specifications are modelled using equivalent
   Linear Temporal Logic (LTL) properties. On simulation and verification,
   some of the properties are violated for AFDX, while all the properties
   are found to be satisfied for the 1553B model, thus proving the
   robustness of the 1553B protocol and its suitability for aerospace and
   military applications.},
