@article{ WOS:000242228100006,
Author = {Hall, Charles E. and Shtessel, Yuri B.},
Title = {Sliding mode disturbance observer-based control for a reusable launch
   vehicle},
Journal = {JOURNAL OF GUIDANCE CONTROL AND DYNAMICS},
Year = {2006},
Volume = {29},
