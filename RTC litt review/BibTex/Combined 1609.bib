@inproceedings{ WOS:000400689900213,
Author = {Daniel, Danish K. and Kiran, P. V. K. and Philip, Noel V.},
Book-Group-Author = {IEEE},
Title = {Fault-Tolerant Flight Profile Simulator for Launch Vehicle Applications},
Booktitle = {2016 IEEE ANNUAL INDIA CONFERENCE (INDICON)},
Series = {Annual IEEE India Conference},
Year = {2016},
Note = {IEEE Annual India Conference (INDICON), Bangalore, INDIA, DEC 16-18,
   2016},
Organization = {IEEE},
Abstract = {A simple, rugged and accurate Flight Profile Simulator (FPS) for launch
   vehicle hardware and software real-time testing is proposed in this
   paper. The launch vehicle onboard system is a MIL-STD-1553B based
   configuration with Onboard Computer (OBC) as Bus Controller (BC) and
   Navigation, Sequencing and Control subsystems as Remote Terminals (RT).
   The simulator acts as another RT on the 1553B bus and emulates input
   RT's like Inertial Navigation Sensor (INS) interface module and rate
   gyro package module. It simulates the analog pressures required for
   pnuemo-hydraulic algorithm as well as the fuel flow, oxidizer flow and
   temperatures required for onboard Mixture Ratio Control (MRC) algorithm.
   The proposed simulator is augmented using a fault-tolerant scheme that
   ensures all onboard elements are protected in case of any failure in any
   simulator hardware/software elements. The flight simulator has been used
   for realtime testing of launch vehicle avionics systems and close match
   is seen between test results and predicted reference.},
