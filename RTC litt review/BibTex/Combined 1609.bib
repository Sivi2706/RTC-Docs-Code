@article{ WOS:001839469300001,
Author = {Zhang, Ruitao and Fang, Yangwang and Guo, Hang and Chen, Zhan and Fu,
   Wenxing},
Title = {Fixed-time event-triggered group cooperative midcourse guidance law with
   collision avoidance and connectivity preservation},
Journal = {CHINESE JOURNAL OF AERONAUTICS},
Year = {2026},
Volume = {39},
Number = {9},
Month = {SEP},
Abstract = {To solve the problems of collision, communication distance constraints,
   and excessive communication burden when multiple missiles are
   coordinated against multiple maneuvering targets, this paper proposes a
   fixed-time event-triggered group cooperative head-on interception
   midcourse guidance law for missile formation with collision avoidance
   and connectivity preservation. Firstly, considering the impact of target
   maneuvering on the guidance system, an Adaptive Fixed-Time Disturbance
   Observer (AFxTDO) is introduced to estimate the target's acceleration.
   Secondly, for the leader missiles, a group cooperative head-on
   interception midcourse guidance law is designed, based on a Trajectory
   Shaping Guidance Law (TSGL) and a fixed-time eventtriggered consensus
   protocol with the total flight time of each leader missile as the
   coordination variable. This enhances communication efficiency and
   reliability, ensuring that all leader missiles simultaneously reach
   their respective mid-to-terminal guidance handover areas, while acting
   as the core to guide the follower missiles. Then, for the follower
   missiles, a novel Non-singular Terminal Sliding Model (NTSM) surface is
   designed by combining the Artificial Potential Function (APF), and based
   on this, a fixed-time event-triggered Formation Cooperative Midcourse
   Guidance Law (FCMGL) is proposed. The stability is proven using Lyapunov
   stability theory, with Zeno behavior excluded, ensuring collision
   avoidance and connectivity between the follower missiles.},
