@article{ WOS:001828086600030,
Author = {Younas, Waseem and Irfan Yousuf, Muhammad and Akram, Qurat Ul Ain},
Title = {Targeted Cyber Epidemics: Modeling of Multi-Stage APT Campaigns Through
   Epidemiological Approach},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {107014-107031},
Abstract = {In the era of cyber technology, the decisive battles are not fought with
   missiles but with malware, where state-sponsored Advanced Persistent
   Threats (APTs) launch covert campaigns to compromise the data integrity
   of opponents. To tackle such attacks, several compartmental models have
   been proposed for general malware and APTs; however, these approaches
   fail to model the complete multistage life cycle of an APT, including
   its hallmark characteristics of stealth, persistence, and long-term
   behavior. This paper introduces an Extended
   Susceptible-Exposed-Infected-Recovered (E-SEIR) model. Our model fills
   these gaps by introducing an explicit dormant phase, referred to as the
   exposed state, capturing how threats move intentionally between
   high-value and low-value assets, and showing how their spread is
   influenced by the measurable structure of the network. The proposed
   model captures the full APT life cycle, provides clear containment
   thresholds, reveals early warning intervals between exposed and active
   compromise, and maps directly to actionable controls: segmentation,
   faster isolation, and stronger detection and remediation even under
   partial telemetry. Across all scenarios examined, the proposed model
   consistently provides earlier detection signals and group-specific risk
   indicators compared to the classical SEIR baseline, underscoring both
   its methodological contribution and its operational value. By unifying
   attacker behavior, defensive posture, and system vulnerabilities, the
   model provides a realistic and actionable depiction of APT propagation
   in heterogeneous systems.},
