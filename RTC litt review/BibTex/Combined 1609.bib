@article{ WOS:000167886300070,
Author = {Brown, TG and Davis, B and Hepner, D and Faust, J and Myers, C and
   Muller, P and Harkins, T and Hollis, M and Miller, C and Placzankis, B},
Title = {Strap-down microelectromechanical (MEMS) sensors for high-G munition
   applications},
