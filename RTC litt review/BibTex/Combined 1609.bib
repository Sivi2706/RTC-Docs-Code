@article{ WOS:001841481600001,
Author = {Hrobar, Tomas and Silha, Jiri and Vananti, Alessandro and Schildknecht,
   Thomas},
Title = {Complex attitude determination of H-2A rocket bodies assuming free
   precession},
Journal = {ADVANCES IN SPACE RESEARCH},
Year = {2026},
