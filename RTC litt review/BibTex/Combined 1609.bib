   (SPIE)},
Year = {1997},
Volume = {3086},
Pages = {233-243},
Note = {Conference on Acquisition, Tracking, and Pointing XI, ORLANDO, FL, APR
   23-24, 1997},
Organization = {Soc Photo Opt Instrumentat Engineers},
Abstract = {In this paper, we describe a new method for terminal air-to-ground
   missile guidance based on infrared seeker. The aim is to hit a building
   which has been previously selected in a 3-D model of the scene. The
   proposed algorithm is divided in two steps: acquisition and tracking
   steps. Acquisition consists in estimating the location of the target in
   the first image and to reestimate the missile position. The second step
   is the tracking of the target along the sequence of images by predicting
   the target location in each image from the previous one. A supervisor
   module is in charge of verifying the corectness of the tracking, by
   doing some reacquisitions in background and ensure the coherence between
   reacquisitions and tracking. All computations (segmentation, missile
   position computation, acquisition, target prediction, correlation...)
   are real-time compatible.},
