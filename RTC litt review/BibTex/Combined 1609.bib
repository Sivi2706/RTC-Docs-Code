Title = {Avionic Data Acquisition System using MIL STD 1553B Controller with
   IRIG-B Timecode Decoder},
Booktitle = {2014 IEEE INTERNATIONAL CONFERENCE ON CIRCUIT, POWER AND COMPUTING
   TECHNOLOGIES (ICCPCT-2014)},
