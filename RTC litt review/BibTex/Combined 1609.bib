@article{ WOS:001642489400305,
Author = {Li, Haoyu and Guo, Haoyu and Yan, Yuhang and Han, Yu and Wang, Jingyu},
Title = {Research on missile midcourse guidance law based on reinforcement
   learning in continuous space},
Journal = {IFAC PAPERSONLINE},
Year = {2025},
Volume = {59},
Number = {20},
Pages = {1794-1799},
Note = {23rd IFAC Symposium on Automatic Control in Aerospace ACA, Harbin,
   PEOPLES R CHINA, AUG 02-06, 2025},
Organization = {Int Federat Automat Control},
Abstract = {This paper presents a comprehensive framework for designing multi-factor
   reward functions to train deep reinforcement learning (RL) policies in
   continuous-action missile midcourse guidance systems. Addressing the
   limitations of conventional methods in complex engagement scenarios, we
   propose a reward engineering methodology that strategically integrates
   1) terminal impact angle error, 2) zero-effort-miss (ZEM) minimization,
   3) energy-efficient control effort, and 4) tactical advantage
   preservation through dynamic reward weighting. A Proximal Policy
   Optimization (PPO) agent is trained in a dynamic simulation environment.
   The reward structure employs adaptive normalization and phase-dependent
   weight scheduling, with the terminal phase intensifying angular
   constraints while de-emphasizing energy costs. The trained policy
   exhibits superior generalization capability. The framework provides
   actionable insights for balancing competing guidance objectives in
   next-generation adaptive missile systems.},
