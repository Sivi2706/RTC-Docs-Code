Pages = {561-567},
Note = {9th Annual Space Flight Mechanics Meeting, BRECKENRIDGE, CO, FEB 07-10,
   1999},
Organization = {Amer Astronaut Soc; Amer Inst Aeronaut \& Astronaut},
Abstract = {This paper will address the analysis, simulation, and data review
   process used in the X-34 program for development of the GPS portion of
   the navigation system. An emphasis on how MATLAB and the Constellation
   Toolbox were used to generate simulations, process data, and develop
