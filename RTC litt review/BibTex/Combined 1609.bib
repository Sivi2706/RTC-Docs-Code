Title = {A Modular and Scalable Avionics Architecture for Autonomous Aerial and
   High-Dynamic Flight Systems},
Booktitle = {SIXTH CONGRESS ON INTELLIGENT SYSTEMS, CIS 2025, VOL 6},
Series = {Lecture Notes in Networks and Systems},
Year = {2026},
