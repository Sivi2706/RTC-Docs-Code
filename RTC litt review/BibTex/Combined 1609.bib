@article{ WOS:001905407900001,
Author = {Zhang, Shiqiang and Li, Kebo and Liang, Yangang},
Title = {Three-Dimensional Optimal Guidance Law for Boost-Coast Switching Phase
   of the Air-to-Air Missile},
Journal = {INTERNATIONAL JOURNAL OF AERONAUTICAL AND SPACE SCIENCES},
Year = {2026},
Month = {2026 OCT 16},
Abstract = {This paper proposes a two-phase optimal guidance law (OGL) for
   interception during the boost-coast switching phase of an air-to-air
   missile. Three-dimensional relative kinematics are established in a
   line-of-sight rotating coordinate system, allowing a planar guidance law
   to retain three-dimensional interception capability. A
   linear-time-varying guidance model is then formulated to describe the
   variations in the guidance-system time constant and the
   target-equivalent acceleration across the boost and coast phases. The
   two-phase OGL is derived from a weighted effort cost using the
   Cauchy-Schwarz inequality, and the weighting is shown to enforce command
   continuity across the boost-coast transition by construction,
   eliminating the need for ad hoc command smoothing. The effects of
   aerodynamic drag are explicitly included in the guidance model and the
   time-to-go estimation. An improved time-to-go estimator that accounts
   for thrust dynamics is also developed. Simulation results show that the
   proposed law reduces miss distance while maintaining robust and
   energy-efficient performance.},
Publisher = {SPRINGER},
Address = {ONE NEW YORK PLAZA, SUITE 4600, NEW YORK, NY, UNITED STATES},
