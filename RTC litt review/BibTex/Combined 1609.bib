Pages = {93-104},
Note = {44th Annual Technical Meeting of the
   Institute-of-Environmental-Sciences-and-Technology on the 21st Century -
   A New Frontier in International Information Exchange, PHOENIX, AZ, APR
   26-MAY 01, 1998},
Organization = {Inst Environm Sci \& Technol},
Abstract = {The Earth Observing System (EOS) spacecraft will launch on an Atlas IIAS
   launch vehicle on NASA's mission to planet Earth in late 1998. The new
   design of the spacecraft's pyroshock separation system was characterized
   by a series of separation test firings by the launch vehicle's
   contractor, Lockheed Martin Astronautics (LMA). The test data from these
   shock firings will be assessed in this paper, with particular emphasis
   on how the shock levels travels downward from the spacecraft's
   separation interface to the Centaur's (upper stage) equipment module and
   avionics components. The affect of component's weight and fidelity will
   be highlighted, in addition to discussing the shock attenuation with
   distance and across joints.},
