@inproceedings{ WOS:001463221800245,
Author = {Wei, Meng and Chen, Bing and Li, Haoxue and Zhang, Dong},
Editor = {Yan, L and Duan, H and Deng, Y},
Title = {Application of Adaptive Short Time Fourier Transform in Rocket Telemetry
   Data Processing},
Booktitle = {ADVANCES IN GUIDANCE, NAVIGATION AND CONTROL},
Series = {Lecture Notes in Electrical Engineering},
Year = {2023},
Volume = {845},
Pages = {2512-2521},
Note = {2022 International Conference on Guidance, Navigation and Control,
   Harbin, PEOPLES R CHINA, AUG 05-07, 2022},
Organization = {Harbin Engineering University},
Abstract = {How to achieve fast and accurate processing of rocket telemetry data has
   always been a hot issue for research. As a time-frequency analysis (TFA)
   method, Short-time Fourier transform (STFT) can be a favorable tool for
   processing rocket telemetry data because of the simple algorithm and
   definite physical meaning. However, because the traditional SFTF method
   uses a fixed window, the selection of the window function will have a
   great impact on the analysis results, resulting in unstable
   time-frequency analysis results. In this paper, based on the principle
   of signal matching, a short-time Fourier transform method based on
   adaptive windows is proposed, and the method is used for TFA of the
   measured rocket telemetry data, pointing out the advantages of the
   method over the traditional method in time-frequency aggregation.},
