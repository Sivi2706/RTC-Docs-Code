@inproceedings{ WOS:000080857900026,
Author = {Frazier, W and Mitchell, S and Weiss, M and Wiemer, D},
Editor = {Culp, RD and Weimer, DJ},
Title = {Initialization and early on-orbit performance of the Geosat Follow-On
   satellite},
Booktitle = {GUIDANCE AND CONTROL 1999},
Series = {ADVANCES IN THE ASTRONAUTICAL SCIENCES},
Year = {1999},
Volume = {101},
Pages = {405-419},
Note = {22nd Annual AAS Rocky Mountain Guidance and Control Conference,
   BRECKENRIDGE, CO, FEB 03-07, 1999},
Organization = {Amer Astronaut Sci},
Abstract = {The Geosat Follow-On (GFO) satellite was launched on Feb. 10, 1998. This
   paper describes the early on-orbit experiences of several of the lead
   engineering staff that worked on the program for many years during its
   development. The first two days were especially interesting, while an
   attitude control sign error causes a significant safe mode anomaly
   immediately after launch vehicle separation. Fortunately, this was
   rapidly diagnosed from stored telemetry, and corrected via software
   table upload.
   The spacecraft propulsion system was checked-out and used to modify the
   insertion orbit to approach the required Exact Repeat Orbit (ERO). The
   ERO was achieved using Delta Vs ranging from 7 m/s to 5 mm/s. These
   maneuvers were tailored to minimize fuel use, while accounting for the
   limited ground station coverage, as well as thermal limitations due to
   thruster heating of the Graphite-Cynate Ester structure. The ERO has
   been achieved and the ground track maintained to within the specified
   +/- 1 km error band.
   The primary payloads of Radar Altimeter and Water Vapor Radiometer have
   performed flawlessly during the initialization phase, consistently
   providing noise levels within specification. The Doppler Beacon and
   Laser Retroreflector orbit determination payloads have also performed to
   specification; however, the GPS receivers have been problematic and
   work-arounds are presently being pursued.},
