@inproceedings{ WOS:000425269300026,
Author = {Kocakarin, Isa and Yegin, Sr., Korkut},
Book-Group-Author = {IEEE},
Title = {Measurements of Signal Penetration into Mock Missiles},
Booktitle = {2017 IV INTERNATIONAL ELECTROMAGNETIC COMPATIBILITY CONFERENCE (EMC
   TURKIYE)},
Year = {2017},
Note = {4th International Electromagnetic Compatibility Conference (EMC
   Turkiye), Ankara, TURKEY, SEP 24-27, 2017},
Organization = {24-27 Sept. 2017, , Turkey},
Abstract = {Signal penetration into missiles through nose cone and apertures is
   critical for electro-optical guidance systems, navigation equipment and
   control of explosive ordnance. Penetrated signals are relatively small
   but hard to simulate by known computational methods. To corroborate
   simulation results, we created a scaled version of a missile and placed
   wire antennas inside this mock missile. The prototype has openings on
   the nose cone. Measurements are performed for different antenna sizes
   placed inside the nose cone. These measurements, then, are compared to
   numerically calculated simulation results. The extent of corroboration
   and possible ways to improve correct prediction of signal coupling are
   discussed.},
