@inproceedings{ WOS:001836695700568,
Author = {Kang, Baowen and Shang, Feng and Liu, HaoYi},
Book-Group-Author = {IEEE},
Title = {Design of a Four Arm Spiral Antenna for Missile Based Telemetry},
Booktitle = {2023 IEEE 11TH ASIA-PACIFIC CONFERENCE ON ANTENNAS AND PROPAGATION,
   APCAP 2023},
Year = {2023},
Note = {11th Asia-Pacific Conference on Antennas and Propagation-APCAP-Annual,
   Guangzhou, PEOPLES R CHINA, NOV 22-24, 2023},
Organization = {Institute of Electrical and Electronics Engineers Inc; South China
   University of Technology; Southeast University - China; Fuzhou
   University; Antennas and Propagation Society; Fragrant Mountain
   Microwave Co Ltd},
Abstract = {In response to issues such as miniaturization and conformal
   configuration of missile borne telemetry antennas, this paper designs a
   four arm spiral backward radiation right-handed circularly polarized
   antenna operating at 2.45GHz (2.44GHz-2.46GHz). Using a four port
   coaxial feed, circular polarization is achieved through a four phase
   feed through a quarter power divider. The antenna uses Raogers as the
   dielectric material, with an overall size of 11.59mm in height and 26mm
   in diameter. Through simulation software for parameter optimization, the
   simulation results show that the backward radiation gain is greater than
   -2dB, the -10dB return loss bandwidth is 2.45GHz (2.42GHz 2.48GHz), and
   the main polarization direction axis ratio is less than 0.1dB.},
