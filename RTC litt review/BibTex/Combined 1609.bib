Pages = {4041-4050},
Note = {2022 International Conference on Guidance, Navigation and Control,
   Harbin, PEOPLES R CHINA, AUG 05-07, 2022},
Organization = {Harbin Engineering University},
Abstract = {Due to the high sampling frequency of fast varying parameters in
   telemetry data, it is necessary to divide different periods for segment
   selection in the analysis process. Most of the existing segment
   selection methods are carried out by manually analyzing the time history
   curve of parameters, with large segment selection error and many manual
   interventions. Therefore, this paper introduces an adaptive processing
   method of fast varying parameters in telemetry data based on envelope
   extremum method, which distinguishes characteristic and
   non-characteristic signals, establishes different envelope extraction
   models, and ensures the richness of frequency and the maximization of
   amplitude of segment selection signal. The advantage of this method is
   fast, efficient, practical, and can greatly improve the data processing
   efficiency. It is verified by the measured rocket telemetry vibration
   signal that the processing effect is good.},
