@inproceedings{ WOS:000448917000073,
Author = {Krishnan, Ranjani and Lalithambika, V. R.},
Book-Group-Author = {IEEE},
Title = {Modelling and Validating 1553B Protocol Using the SPIN Model Checker},
Booktitle = {2018 10TH INTERNATIONAL CONFERENCE ON COMMUNICATION SYSTEMS \& NETWORKS
   (COMSNETS)},
Series = {International Conference on Communication Systems and Networks},
Year = {2018},
Pages = {472-475},
Note = {10th International Conference on Communication Systems and Networks
   (COMSNETS), Bangalore, INDIA, JAN 03-07, 2018},
Abstract = {The goal of this work is to validate a communication protocol used in
   safety critical systems using formal verification. The 1553B protocol, a
   widely used communication standard in launch vehicles, is modelled and
   verified using the model checker SPIN. The principal elements in this
   command-response protocol are a single Bus Controller (BC) and one or
   more Remote Terminals (RT). The required specifications are formally
   represented using equivalent Linear Temporal Logic (LTL) properties. On
   simulation and verification, all the properties are found to be
   satisfied for the model, thus proving the robustness of the 1553B
   protocol.},
