Title = {Visually Augmented Guidance System Realization for Landing Rocket Model},
Booktitle = {PROCEEDINGS OF THE 2021 IEEE INTERNATIONAL CONFERENCE ON AEROSPACE
   ELECTRONICS AND REMOTE SENSING TECHNOLOGY (ICARES 2021)},
Year = {2021},
Note = {5th IEEE International Conference on Aerospace Electronics and Remote
