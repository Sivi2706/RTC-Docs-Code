@article{ WOS:001883509500014,
Author = {Wu, Shihao and Wang, Zhaoqi and Lan, Wanshun and Zhao, Yafei and Liu,
   Xiqing and Liu, Yuanwei and Peng, Mugen},
Title = {Waveform Design With Holistic Utility-Driven Optimization for LEO
   Satellite Integrated Communication and Navigation},
Journal = {IEEE TRANSACTIONS ON VEHICULAR TECHNOLOGY},
Year = {2026},
Volume = {75},
Number = {9},
Pages = {19699-19713},
Month = {SEP},
Abstract = {The burgeoning demand for seamless integration of high-rate
   communication and precise positioning is catalyzing the development of
   integrated communication and navigation (ICAN) systems, particularly
   leveraging low Earth orbit satellite constellations. Existing studies
   predominantly rely on the functional superposition of conventional
   communication or navigation waveforms and metrics, failing to address
   the inherent performance trade-off. To bridge this gap, this work
   proposes an integrated waveform assisted by orthogonal frequency
   division multiplexing and Gold code. Binary selection and diagonal
   loading matrices are introduced to enable the joint allocation of
   subcarriers and power among communication data, pilot signals, and
   navigation chips, thereby simultaneously ensuring high spectral
   efficiency and superior ranging resolution. Furthermore, we define a
   convex and differentiable utility metric, incorporating a preference
   weighting parameter to flexibly balance the emphasis between
   communication and navigation. A successive convex Pareto algorithm is
   developed to obtain the optimal resource allocation scheme and trace the
   Pareto frontier. Simulation results demonstrate the advantage of our
   proposal which offers a versatile solution for ICAN services.},
