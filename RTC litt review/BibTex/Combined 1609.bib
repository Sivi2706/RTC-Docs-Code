@article{ WOS:001863238100039,
Author = {Zahid, Junaid and Harmin, Mohammad Yazdi and Md Rezali, Khairil Anas and
   Dawood, Sarmad},
Title = {Influence of Telemetry-Induced Data Quality Degradation on Operational
   Modal Analysis of a Launch Vehicle},
Journal = {JOURNAL OF AERONAUTICS ASTRONAUTICS AND AVIATION},
Year = {2026},
Volume = {58},
Number = {7, SI},
Pages = {1329-1336},
Month = {JUL},
Abstract = {Operational Modal Analysis (OMA) plays a vital role in the structural
   dynamic characterization of launch vehicles from in-flight data.
   However, inflight data acquisition is severely constrained by limited
   telemetry bandwidth, which degrades data quality. Previous flight
   programs have reported difficulties in identifying low-frequency
   vibration modes, primarily due to coarse sensor resolution and
   quantization effects. This paper investigates the influence of sampling
   rate and measurement resolution on the accuracy of Operational Modal
   Analysis (OMA) results that establish a guideline for selecting
   appropriate data acquisition settings and sensor configurations to
   ensure reliable modal identification under telemetry constraints. Finite
   element (FE) baseline model of a launch vehicle was developed to obtain
   simulated vibration response data at eight axial locations using a
   broadband excitation force along with a harmonic of 1 Hz at engine
   location to emulate control thrust. The data was analyzed using
   developed Frequency Domain Decomposition (FDD) and Stochastic Subspace
   Identification (SSI) methods. The results showed that reducing the
   sampling rate had minimal impact on modal identification accuracy,
   likely due to the absence of high-frequency content and measurement
   noise in the simulation. Nevertheless, measurement resolution
   significantly affects modal accuracy, as the least count increased, the
   identified modal frequencies and mode shapes became less reliable.
   Comparative analysis between FDD and SSI methods indicated that FDD
   method performed well for low-quality data due to its inherent
