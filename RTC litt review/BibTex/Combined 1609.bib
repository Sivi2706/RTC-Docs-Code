@inproceedings{ WOS:001409500407021,
Author = {Clawson, Jeffrey Scott and Christensen, Randall},
Book-Group-Author = {AIAA},
Title = {Linear Covariance Model Development for Target Engagements},
Booktitle = {AIAA SCITECH 2021 FORUM},
Year = {2021},
Note = {AIAA Science and Technology Forum and Exposition (AIAA SciTech Forum),
   ELECTR NETWORK, JAN 11-21, 2021},
Organization = {Amer Inst Aeronaut \& Astonaut},
Abstract = {A linear covariance simulation framework is developed and validated for
   a 2D target engagement scenario. The scenario comprises a single pursuer
   equipped with an inertial navigation system aided by absolute position
   measurements, as well as range, angle, and range rate measurements
   relative to the incoming target. The pursuer utilizes a proportional
   navigation guidance law to engage the target, modeled as nominally
   constant velocity perturbed by random accelerations. The linear
   covariance framework is developed by linearizing the differential and
   measurement equations about the nominal trajectory, and forming an
   augmented system comprising truth and navigation state dispersions. In
   contrast with sample-based methods, the developed linear covariance
   framework can calculate the truth state dispersion covariance and the
   estimation error covariance throughout the engagement in a single run.
   The computational efficiency is exploited to rapidly perform multiple
   analyses of a target engagement problem, including trajectory dispersion
   error budgets and final miss distance error budgets.},
