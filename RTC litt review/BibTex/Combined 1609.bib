@article{ WOS:001782123800001,
Author = {Manjunath, C. B. and Vivek, Atul S. and Rajasekharan, Rajesh and Sen,
   Vijay Kumar and Sajin, S. and Abhinaj, V and Chandra, Shishir Kumar S.
   and Anagha, P. and Sivaranjani, H. and Pandey, Ullekh and Prasanth, T.
   K. and Lakshmi, Kota Santosh and Kumar, Manoj and George, Jinu and
   Prabhu, V. R. and Vanitha, K. and Prajoob, K. and Pandey, Himanshu and
   Mathews, Sheeja and Nandi, Amarnath and Prasad, B. Biju},
Title = {Design, testing, and flight performance of Compact Research Module for
   Orbital Plant Studies (CROPS) - A miniature plant growth chamber for
   PSLV orbital experiment module},
Journal = {ACTA ASTRONAUTICA},
Year = {2026},
Volume = {247},
Pages = {591-605},
Month = {OCT},
Abstract = {Indian Space Research Organization (ISRO) has re-configured 4th stage of
   its Polar Satellite Launch Vehicle (PSLV) to serve as ``PSLV PS4 Orbital
   Experiment Module (POEM){''} for micro-gravity experiments, after
   satellite separation. Compact Research module for Orbital Plant Studies
   (CROPS) is envisaged as a multi-phase platform to develop and evolve
   ISRO's capabilities for growing and sustaining flora in
   extra-terrestrial environments. The first phase of CROPS is devised as a
   closed box experiment to demonstrate germination and growth of Cowpea
   (Vigna unguiculata) seeds to two leaf stage, onboard the POEM platform.
   The payload is designed as a semi-autonomous system, leveraging the
   power, telemetry and tele-command provisions available on the POEM
   platform. The payload primarily comprises of a hermetically sealed
   growth chamber filled with ambient air along with various subsystems to
   enable plant growth and monitoring. This includes a multi layer root
   substrate , water delivery module, LED lights, imaging system, thermal
   control system, sensors for environment monitoring, data acquisition and
   control unit, and power system. The payload, which is also the first
   space-borne plant growth experiment from India, was flown successfully
   in PSLV C60 POEM 4 mission and demonstrated seed germination and growth
   to two leaf stage under micro-gravity. The payload architecture,
   configuration of subsystems, along with the realization and testing
   philosophy is presented in this paper. The test results from the orbital
   experiments are also reported. The results/lessons learnt from first
   CROPS payload are expected to be a stepping stone for ISRO's future seed
   to seed life cycle experiments and food production stations for crew
   consumption for future long duration manned spaceflight missions.},
