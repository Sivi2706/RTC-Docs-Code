@article{ WOS:000822256100001,
Author = {Braun, Benjamin and Barf, Jochen},
Title = {Image processing based horizon sensor for estimating the orientation of
   sounding rockets, launch vehicles and spacecraft},
Journal = {CEAS SPACE JOURNAL},
