Title = {Implementation of Fault-tolerant Architecture for Central Data
   Processing System in Space Center},
Booktitle = {2014 14TH INTERNATIONAL CONFERENCE ON CONTROL, AUTOMATION AND SYSTEMS
   (ICCAS 2014)},
Series = {International Conference on Control Automation and Systems},
