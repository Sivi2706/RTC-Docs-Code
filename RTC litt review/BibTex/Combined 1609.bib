@inproceedings{ WOS:001463221800451,
Author = {Shi, Chunfeng and Chen, Xiyuan and Wang, Junwei},
Editor = {Yan, L and Duan, H and Deng, Y},
Title = {A Correcting Accelerometer Errors Algorithm for SINS/CNS Integrated
   System},
Booktitle = {ADVANCES IN GUIDANCE, NAVIGATION AND CONTROL},
