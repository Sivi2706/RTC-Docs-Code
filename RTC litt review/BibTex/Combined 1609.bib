   Engelbrecht, Carl S. and Ercol, Carl J. and Fielhauer, Karl B. and
   Grant, David G. and Hartka, Theodore J. and Hill, Tracy A. and Jaskulek,
   Stephen E. and Mirantes, Mary A. and Mosher, Larry E. and Paul, Michael
   V. and Persons, David F. and Rodberg, Elliot H. and Srinivasan, Dipak K.
   and Vaughan, Robin M. and Wiley, Samuel R.},
Title = {The MESSENGER spacecraft},
