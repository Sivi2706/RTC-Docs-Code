Title = {THE SURECA BIT-10 LONG DURATION BALLOON MISSION: A SUCCESSFUL
   QUALIFICATION TEST FOR A NEW IRIDIUM® TELEMETRY},
Booktitle = {20TH ESA SYMPOSIUM ON EUROPEAN ROCKET AND BALLOON PROGRAMMES AND RELATED
   RESEARCH},
