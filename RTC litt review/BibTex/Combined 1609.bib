@article{ WOS:001760391000002,
Author = {Iles, Gail N. and Kirby, James C. and Hewitt, Chris and Drummond, Nathan
   and Robinson, Craig G. and Moshovelis, Liam D. and Auld, Matthew W. and
   Florent, Nicholas C. and Chuah, Wei Qin and Millett, Kate S. and Ogawa,
   Hideaki},
Title = {Aeronautical Sounding Rocket Used as a Microgravity Platform for
   Scientific Experimentation in Australia},
Journal = {IEEE AEROSPACE AND ELECTRONIC SYSTEMS MAGAZINE},
Year = {2026},
Volume = {41},
Number = {5},
Pages = {26-38},
Month = {MAY},
Abstract = {Many countries around the world, such as Sweden, Brazil, Japan, and the
   United States, operate sounding rocket programs. These sounding rockets
   can reach apogee without entering space, or can follow a suborbital
   trajectory; both providing varying amounts of microgravity through the
   freefall portion of flight. With limited facilities in Australia, there
   is a reliance on aeronautical or ``amateur{''} rockets for microgravity
   research, therefore, a 3-m-long sounding rocket has been designed,
   built, and launched in Queensland, Australia. The rocket reached an
   apogee just over 30,000 ft providing a total of 16 s of microgravity for
   scientific research. The rocket included a fully functional avionics
   system, comms unit, and recovery system, which included a drogue and a
   main parachute that provided a controlled, 1-g landing. A 5-kg
   scientific payload on board was powered autonomously, comprising a jar
   of ferrofluid inside an experimental chamber. Scientific objectives for
   the experiment were to observe the self-agglomeration of a ferrofluid in
   microgravity, with a particular focus on the conditions required to
   produce spheres of ferrofluid or sharp ``spikes,{''} typical of 1-g
   experiments. During 16 s of microgravity, and in the absence of a
   magnetic field, in situ photographs show the ferrofluid forming small
   spheres similar to 3.5 mm in diameter, joined together in chains.},
