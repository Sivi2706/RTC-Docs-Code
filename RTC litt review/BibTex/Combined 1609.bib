Title = {Real-Time Multi-Constraint Guidance for Near Space Flight Vehicle Using
   Adaptive Gauss Pseudo-Spectral Optimization},
Booktitle = {2025 CHINA AUTOMATION CONGRESS, CAC},
Series = {Chinese Automation Congress},
Year = {2025},
Pages = {1820-1825},
Note = {2025 China Automation Congress-CAC, Harbin, PEOPLES R CHINA, SEP 26-28,
   2025},
Organization = {Institute of Electrical and Electronics Engineers Inc; Chinese
   Association of Automation; IEEE Systems Man and Cybernetics Society},
Abstract = {For the interception of a high-speed target in the near space, the
   optimal midcourse guidance of air-to-air missile is designed. The
   relative motion model of the missile and target in three-dimensional
   space is established, and the optimal midcourse guidance problem is
   formulated as an optimal control problem with constraints where the
   energy consumption is chosen as the performance index. With the state
   and control of the system discretized using Gauss pseudo-spectral
   method, the optimal control problem is formulated into a nonlinear
   programming problem (NLP)which can be solved to obtain open-loop optimal
   guidance commands. Then, in the receding horizon architecture, the NLP
   problem corresponding to the certain time horizon is repeatedly solved
   on line to implement the closed-loop guidance. The stability is proved
   for the closed-loop guidance system with the existence of external
   disturbances, model parameter uncertainties, and computational errors.
   Finally, numerical simulation is carried out to verify the feasibility
   of the design.},
