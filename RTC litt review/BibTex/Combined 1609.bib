@inproceedings{ WOS:A1997BJ97P00006,
Author = {Schmidt, R and Escoubet, CP and Goldstein, ML},
Editor = {Russell, CT},
Title = {Phoenix and cluster .2. Towards a recovery from the loss of cluster},
Booktitle = {RESULTS OF THE IASTP PROGRAM},
