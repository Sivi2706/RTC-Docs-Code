@article{ WOS:A1994MU60100003,
Author = {BURALLI, B and COROLLER, JF and SAUVAN, M and COPPOLA, J and DOMAINE, Y},
Title = {MISSILE ANTENNAS DEVELOPED BY AEROSPATIALE - EXISTING PRODUCTS AND
   EVOLUTION},
Journal = {ONDE ELECTRIQUE},
Year = {1994},
Volume = {74},
Number = {1},
Pages = {9-14},
Month = {JAN-FEB},
Note = {European Conference of Tests and Telemeasures, ARCACHON, FRANCE, JUN
   02-04, 1993},
Abstract = {Developed by Aerospatiale under previous, ballistic programs, the
   antennas presented in this paper now appear eligible for a broad range
   of applications on account of their high-performance and low-cost
   merits. They include: - a compact, UHF patch antenna; - a compact
   broadband antenna for GPS receive and transmit purposes; - a circular
   polarization, omnidirectional pattern, conical UHF antenna; -
   wide-bandpass or dual-frequency monolayer patches; - the so-called belt
   antenna.
   The paper details the characteristics and performance of these
   Aerospatiale antennas, most of which afford direct usability on such
   existing applications as Telemetry and Ranging; GPS, Transponder-based
   trajectography and Telecommand.
   In some cases, these antennas are usable, but for a few adjustments, on
   yet other applications, for example in the field of telecommunications,
   owing to their simple radiating structure.},
