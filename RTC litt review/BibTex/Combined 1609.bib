@article{ WOS:000251323100006,
Author = {Tsay, Tain-Sou},
Title = {Decoupling the flight control system of a supersonic vehicle},
Journal = {AEROSPACE SCIENCE AND TECHNOLOGY},
Year = {2007},
Volume = {11},
Number = {7-8},
Pages = {553-562},
Month = {NOV-DEC},
Abstract = {In this paper, a nonlinear decoupling technique is proposed for analyzes
   and designs of a serious aerodynamic coupled missile flight control
   system. Decoupling is obtained from multiplications of two measurable
   accelerations with three controllable output commands of the autopilot.
   They give exact signs and magnitudes proportional to aerodynamic
   decoupling. No matrix inversion of the system dynamic for decoupling is
   needed. From frequency responses of the rolling channel, it will be seen
   that the decoupling and robustness for copping with aerodynamic
   couplings can be obtained simultaneously. Furthermore, the decoupling
   characteristics are kept almost unchanged for large system parameter
   variations and uncertainties. The 5-DOF simulations give same
   conclusions. (c) 2007 Elsevier Masson SAS. All rights reserved.},
