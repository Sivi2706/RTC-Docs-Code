@inproceedings{ WOS:000589970100003,
Author = {Badura, Greg and Fernandez, Cody and Stewart, John},
Editor = {Turner, MD and Kamerman, GW},
Title = {Wave Optics Simulator for Lasers in Time-Evolving Turbulence},
Booktitle = {LASER RADAR TECHNOLOGY AND APPLICATIONS XXV},
