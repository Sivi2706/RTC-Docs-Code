@article{ WOS:000075921200009,
Author = {He, MY and Jiang, HL and Wei, J and Li, Y and Yang, XY and Li, J},
Title = {Neural network modeling of flight control system},
Journal = {IEEE AEROSPACE AND ELECTRONIC SYSTEMS MAGAZINE},
Year = {1998},
Volume = {13},
Number = {9},
Pages = {27-29},
Month = {SEP},
Abstract = {Mode:ling of angle tracking systems in the presence of actuator
   Iron-linearity such as angle, position and rate limits is a very
   significant and difficult task in the design and implementation of
   aircraft, target-tracking, and missile guided systems. A new recurrent
   neural network with time-delayed inputs and output feedback is used for
   the modeling of angle tracking systems, with emphasis on the neural
   network architecture, principles and algorithms. The neural network
   controller with modeling units for angle tracking is designed by using
   TMS320C25 processors. For time and size requirements, limited precision
   technology and look-up table technology are used in the design of the
   hardware and software systems. Given a set of input commands, the
   network is trained to control the system within the constraints imposed
   by actuators. The results show that the proposed networks are able to
   model the angle tracking system through learning without separate
   consideration of the non-linearity of actuators.},
