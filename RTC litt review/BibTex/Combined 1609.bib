@article{ WOS:001642489400450,
Author = {Wang, Fuke and Wang, Jiongqi and Wei, Juhui and Wang, Pengyi and He,
   Zhangming},
Title = {Online Rocket Telemetry Anomaly Detection based on Integrated LSTM Model},
Journal = {IFAC PAPERSONLINE},
Year = {2025},
Volume = {59},
Number = {20},
Pages = {2648-2653},
Note = {23rd IFAC Symposium on Automatic Control in Aerospace ACA, Harbin,
   PEOPLES R CHINA, AUG 02-06, 2025},
Organization = {Int Federat Automat Control},
Abstract = {Long short-term memory (LSTM) networks are crucial for time-series
   anomaly detection. However, naive models for dealing with cross-domain
   problems hardly perform well. This paper proposes a novel framework
   based on an integrated LSTM prediction model for rocket telemetry data.
   This method overcomes the poor generalization and low detection
   capability of traditional LSTM models on cross-domain tasks. A dynamic
   online learning mechanism is introduced to adjust the learning rate
   based on residuals. Its convergence is theoretically proven and
   validated experimentally, providing a new way to handle outliers during
   online learning. The paper also derives the relationship between anomaly
   detections significance level and model performance, showing theoretical
   detection capability under specific conditions. Simulation experiments
   validate the models good performance in detecting various anomalies in
   practical applications.},
