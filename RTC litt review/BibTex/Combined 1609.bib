@article{ WOS:000406773700018,
Author = {Roberts, T. M. and Lynch, K. A. and Clayton, R. E. and Weiss, J. and
   Hampton, D. L.},
Title = {A small spacecraft for multipoint measurement of ionospheric plasma},
