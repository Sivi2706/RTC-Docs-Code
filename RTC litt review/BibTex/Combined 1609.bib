@article{ WOS:000446940600186,
Author = {Wang, Yexing and Lei, Humin and Ye, Jikun and Bu, Xiangwei},
Title = {Backstepping Sliding Mode Control for Radar Seeker Servo System
   Considering Guidance and Control System},
Journal = {SENSORS},
Year = {2018},
Volume = {18},
Number = {9},
Month = {SEP},
Abstract = {This paper investigates the design of a missile seeker servo system
   combined with a guidance and control system. Firstly, a complete model
   containing a missile seeker servo system, missile guidance system, and
   missile control system (SGCS) was creatively proposed. Secondly, a
   designed high-order tracking differentiator (HTD) was used to estimate
   states of systems in real time, which guarantees the feasibility of the
   designed algorithm. To guarantee tracking precision and robustness,
   backstepping sliding-mode control was adopted. Aiming at the main
   problem of projectile motion disturbance, an adaptive radial basis
   function neural network (RBFNN) was proposed to compensate for
   disturbance. Adaptive RBFNN especially achieves online adjustment of
   residual error, which promotes estimation precision and eliminates the
   ``chattering phenomenon{''}. The boundedness of all signals, including
   estimation error of high-order tracking differentiator, was especially
   proved via the Lyapunov stability theory, which is more rigorous.
   Finally, in considered scenarios, line of sight angle (LOSA)-tracking
   simulations were carried out to verify the tracking performance, and a
   Monte Carlo miss-distance simulation is presented to validate the
   effectiveness of the proposed method.},
