@inproceedings{ WOS:000427082201122,
Author = {Li, Huijie and Cai, Yuanli},
Book-Group-Author = {IEEE},
Title = {NDOB-based three-dimensional guidance law with fast and finite-time
   convergence},
Booktitle = {2017 29TH CHINESE CONTROL AND DECISION CONFERENCE (CCDC)},
Series = {Chinese Control and Decision Conference},
Year = {2017},
Pages = {6360-6365},
Note = {29th Chinese Control And Decision Conference (CCDC), Chongqing, PEOPLES
   R CHINA, MAY 28-30, 2017},
Organization = {NE Univ, State Key Lab Synthet Automat Proc Ind; IEEE Ind Elect Chapter;
   Chinese Assoc Automat, Tech Comm Control \& Decis Cyber Phys Syst;
   Chongqing Univ; IEEE Control Syst Soc; Chinese Assoc Artificial
   Intelligence; Chinese Assoc Automat, Tech Comm Control Theory},
Abstract = {In this paper, a three-dimensional finite-time guidance law is proposed
   for both nonmaneuvering and maneuvering targets. Unlike the usual
   approach of decoupling the engagement dynamics into two mutually
   orthogonal two-dimensional planes, a fast and finite-time guidance law
   for the coupled engagement dynamics is derived by selecting a special
   Lyapunov function. The proposed guidance law is constructed through a
   combination of finite-time stability theory and nonlinear disturbance
   observer (NDOB) technique. More specifically, augmented functions are
   involved to improve the convergence of the guidance system, while the
   NDOBs are used to compensate the unknown target accelerations and handle
   the chattering problem. Finally, simulation results on three-dimensional
   missile-target interception examples are included to verify the
   effectiveness of the proposed approach.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Cai, YL (Corresponding Author), Xi An Jiao Tong Univ, Sch Elect \& Informat Engn, Xian 710049, Shaanxi, Peoples R China.
   Li, Huijie; Cai, Yuanli, Xi An Jiao Tong Univ, Sch Elect \& Informat Engn, Xian 710049, Shaanxi, Peoples R China.},
ISSN = {1948-9439},
ISBN = {978-1-5090-4657-7},
Keywords = {Three-dimensional guidance law; Finite-time convergence; Nonlinear
