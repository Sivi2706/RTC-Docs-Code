Year = {1998},
Volume = {98},
Pages = {205-224},
Note = {Annual American-Astronautical-Society Rocky Mountain Guidance and
   Control Conference, BRECKENRIDGE, CO, FEB 04-08, 1998},
Organization = {Amer Astronaut Soc},
Abstract = {The Boeing Company, under contract to the Air Force and Missile Systems
   Center, has completed qualification of the Boeing Flight Controller (FC)
   which will replace the existing Inertial Upper Stage Redundant Inertial
   Measurement Unit and Flight Computers. The FC is a fully single fault
   tolerant navigation system utilizing a pentad of Ring Laser Gyros (RLGs)
   and pendulous accelerometers. A Generalized Likelihood Test (GLT)
   approach is used for the Fault Detection and Isolation (FDI) function.
   This paper develops a process for selection of the critical FDI
   threshold parameters based on analytical models of sensor error
   characteristics as viewed in FDI parity space. The impact of sensor
   technology on threshold values is highlighted by comparisons between RLG
   and floated, single degree of freedom gyro designs. The paper concludes
   with a discussion of the FDI verification test program. Several
   previously unmodeled effects were identified including RLG specific
   phenomena that should be considered in any similar, future design.},
