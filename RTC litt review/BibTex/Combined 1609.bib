Title = {Study on Autopilot Dynamics with Robust Guidance Law and Terminal
   Constraint in Mechanical Engineering},
Booktitle = {ADVANCED RESEARCH ON INTELLIGENT SYSTEMS AND MECHANICAL ENGINEERING},
Series = {Advanced Materials Research},
Year = {2013},
