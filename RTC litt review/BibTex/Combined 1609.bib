Title = {Influence of the Effect of Zero-Frequency for Tail-controlled Missiles
   on Proportional Navigation Guidance},
Booktitle = {INTERNATIONAL CONFERENCE ON ELECTRICAL, CONTROL AND AUTOMATION
   ENGINEERING (ECAE 2013)},
Year = {2013},
Pages = {307-315},
Note = {International Conference on Electrical, Control and Automation
   Engineering (ECAE), Hong Kong, PEOPLES R CHINA, DEC 01-02, 2013},
Abstract = {A nondimensionalized proportional navigation guidance model is built
   taking into account the effect of low frequency right-half plane zeros
   for the tail-controlled aerodynamic radar guided homing missiles. The
   influence of the effect of zero-frequency on the stability region of the
   proportional navigation guidance system is analyzed in conjunction with
   the Rouths stability criterion. The impact on the guidance accuracy of
   the missile is addressed using the adjoint guidance model obtained by
   application of the adjoint technology. Simulation results are provided
   to demonstrate that the effect of zero-frequency not only reduces the
   stability region of guidance homing system especially when the radome
   refraction slope is positive, but also increases the miss distance of
   interceptor due to various stochastic error sources of the radar homing
   system. Conclusions presented in this paper may be beneficial to the
   tail-controlled missile system design preliminary sizing and the design
   of guidance and control system.},
