Author = {Huang, Min and Huang, Dou-dou and Zou, Jia-qi and Sun, Yu-liang},
Editor = {Zhang, F and Chai, L},
Title = {A Retrospective Analysis Method of Missile Guidance and Control Process
   Based on Measured Data},
Booktitle = {2025 10TH INTERNATIONAL CONFERENCE ON AUTOMATION, CONTROL AND ROBOTICS
   ENGINEERING, CACRE},
Series = {International Conference on Automation Control and Robotics Engineering},
Year = {2025},
Pages = {132-136},
Note = {10th International Conference on Automation Control and Robotics
   Engineering-CACRE, Wuxi, PEOPLES R CHINA, JUL 16-19, 2025},
Organization = {IEEE Robotics and Automation Society; Hong Kong University of Science \&
   Technology; Hong Kong Society of Mechanical Engineers},
Abstract = {After the live firing training of the missile, it is necessary to
   analyze the working process of the missile based on the measured data,
   so as to accurately locate the reasons why the missile works abnormally
   or misses the target. Among them, the guidance and control of the
   missile is often one of the important reasons causing the missile to
   miss the target. The analysis of the guidance and control process of an
   air defense missile was taken as an example. Through the comprehensive
   analysis of the guidance and control principle of the missile and the
   actual telemetry data collected, a retrospective analysis method for the
   missile's on-board equipment was put forward. This method includes the
   theoretical analysis of missile guidance and control process, the
   reading method of missile guidance and control telemetry data, the
   comparison analysis between the missile's theoretical guidance and
   control process and the actual guidance and control process, the
   in-depth analysis of missile's miss reasons, which can provide the
   method basis for the relevant scientific researchers to accurately and
   quickly find the reasons for the abnormal work of the missile or miss
   the target.},
