@inproceedings{ WOS:000629243503086,
Author = {Wang, Lei and Yan, Qi-fei and Fei, Chang-jiang and Zheng, Wei},
Editor = {Fu, J and Sun, J},
Title = {On-line compensation of disturbing gravity for ballistic missiles in the
   launching area},
Booktitle = {PROCEEDINGS OF THE 39TH CHINESE CONTROL CONFERENCE},
Series = {Chinese Control Conference},
Year = {2020},
Pages = {3357-3361},
Note = {39th Chinese Control Conference (CCC), Shenyang, PEOPLES R CHINA, JUL
   27-29, 2020},
Abstract = {With the improvement of hardware level of the inertial navigation
   system, the disturbing gravity of the earth gradually becomes one of the
   main factors affecting the accuracy of missiles. In this paper, the
   effect mechanism of the disturbing gravity as well as its error
   propagation mechanism along the trajectory are analyzed in the first
   place, and then an analytical formula for predicting the bum-out state
   deviation caused by the disturbing gravity is derived based on the state
   space perturbation method. By using this analytical formula, an on-line
   compensation strategy of disturbing gravity in the launching area is
   then presented under the closed-loop guidance framework. In the new
   guidance schedule, the disturbing gravity does not need to be calculated
   at each step, hut only at some equidistant discrete points. When the
   last-stage engine of missile is close to shutdown, the disturbing
   gravity function with respect to time is fitted by the precomputed
   discrete values and used to predict the burn-out state deviation
   according to the presented analytical formula and correct the required
   velocity online. Numerical simulations have been done to verified the
   method proposed in this paper, results imply that the presented
   analytical formula has relatively high precision with the relative error
   percentage below 2.5\% in each case, and the on-line compensation
   strategy is also effective with the landing error of missile less than
   3m in each case.},
