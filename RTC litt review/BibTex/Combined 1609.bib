@inproceedings{ WOS:000227984100001,
Author = {Bardanis, F and Pace, PE and Tummala, M},
Editor = {Savoie, M and Chu, HW and Michael, J and Pace, P},
Title = {Kill vehicle effectiveness for boost phase interception of ballistic
   missiles},
Booktitle = {INTERNATIONAL CONFERENCE ON COMPUTING, COMMUNICATIONS AND CONTROL
   TECHNOLOGIES, VOL 6, POST-CONFERENCE ISSUE, PROCEEDINGS},
Year = {2004},
Pages = {1-6},
Note = {International Conference on Computing, Communications and Control
   Technologies (CCCT 2004), Austin, TX, AUG 14-17, 2004},
Organization = {Univ Texas Austin; Int Inst Informat \& System; IEEE Comp Soc, Venezuela
   Chapter; Inter Amer Org Higher Educ},
Abstract = {Boost phase interception of ballistic missiles will be the primary
   response of a layered defense system for ballistic missile defense. The
   many advantages of boost phase interception are counterbalanced by the
   necessity to implement hit-to-kill technology in the kill vehicle, which
   typically employs an electro-optic seeker. Direct hit missile technology
   is constrained by the requirement to minimize miss distance between the
   kill vehicle and the optimum aimpoint on the target. This paper examines
   the kill vehicle effectiveness (miss distance), as a function of both
   the kill vehicle maximum acceleration capability and the guidance system
   time constant. The kill vehicle guidance system is modeled as a fifth
   order binomial with proportional navigation. In addition the miss
   distance is evaluated as a function of the apparent target displacement
   due to the transition of the aimpoint from the plume to warhead.},
