Year = {1993},
Volume = {6},
Number = {2},
Pages = {129-137},
Month = {AUG},
Abstract = {We present experimental results on FPGA use in special and general
   purpose processors, using as case studies a computational accelerator
   for gene sequence analysis, an integer implementation of the DLX
   microprocessor and a real-time signal processor for rocket telemetry.
   All these devices have been successfully prototyped, and are now
   completely functional. We present detailed analysis of our experience
   with FPGAs in these machines, describing savings in chip count, power
   consumption, area, and cost. For all quantitites except cost, measured
   savings were typically an order of magnitude improvement over discrete
   IC implementations.},
