@article{ WOS:001821615800001,
Author = {Srivastava, Vineet K. and Mishra, P. D.},
Title = {S-Band Antenna Angles Data Calibration Using Spacecraft Tracking},
Journal = {AEROTECNICA MISSILI E SPAZIO},
Year = {2026},
Volume = {105},
