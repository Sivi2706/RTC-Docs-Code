@inproceedings{ WOS:001324993504018,
Author = {Li, Heng and Yu, Jianglong and Zheng, Jiapei and Yang, Yikun and Dong,
   Xiwang and Tan, Qingke and Lv, Rui and Wang, Yanyan},
Editor = {Na, J and Sun, J},
Title = {Adaptive Finite-Time Guidance against a Maneuvering Target at a
   Designated Impact Time},
Booktitle = {2024 43RD CHINESE CONTROL CONFERENCE, CCC 2024},
Series = {Chinese Control Conference},
Year = {2024},
Pages = {3957-3962},
Note = {43rd Chinese Control Conference (CCC), Kunming, PEOPLES R CHINA, JUL
   28-31, 2024},
Organization = {Chinese Assoc Automat, Tech Comm Control Theory; Syst Engn Soc China;
   Kunming Univ Sci \& Technol; Yunnan Univ; Chinese Assoc Automat; CAS,
   Acad Math \& Syst Sci; China Soc Ind \& Appl Math; Shanghai Acad Syst
   Sci; Asian Control Assoc; IEEE Control Syst Soc; Inst Control, Robot, \&
   Syst; Soc Instrument \& Control Engineers; Yunnan Assoc Automat; Yunnan
   Mech Engn Soc; Kunming Instrument \& Control Soc},
Abstract = {This paper investigates the problem of intercepting a maneuvering target
   at a designated impact time. Firstly, a guidance model for intercepting
   a maneuvering target in the two-dimensional plane is established, and an
   expression for estimating the time-to-go for a maneuvering target is
   provided. Furthermore, an adaptive nonlinear guidance law with a
   designated impact time is designed based on the adaptive control theory
   and Lyapunov theory, and the stability of the guidance system is
   analyzed. After that, the proposed guidance law is extended to multiple
   missiles, enabling multiple missiles to attack a maneuvering target
   simultaneously or sequentially at specified times. Finally, numerical
   simulations are conducted to validate the effectiveness of the proposed
   guidance law.},
