@article{ WOS:000169800300006,
Author = {Lin, CL and Su, HW},
Title = {Adaptive fuzzy gain scheduling in guidance system design},
Journal = {JOURNAL OF GUIDANCE CONTROL AND DYNAMICS},
Year = {2001},
Volume = {24},
Number = {4},
Pages = {683-692},
Month = {JUL-AUG},
Abstract = {A dynamic backpropagation training algorithm for an adaptive fuzzy gain
   scheduling feedback control scheme was developed. This novel design
   methodology uses a Takagi-Sugeno fuzzy system to represent the fuzzy
   relationship between the scheduling variables and controller parameters
   (Takagi, T., and Sugeno, M., ``Fuzzy Identification of Systems and Its
   Applications to Modeling and Control,{''} IEEE Transactions on Systems,
   Man, and Cybernetics, Vol. 15, No. 1, 1985, pp, 116-132). Direct
   realistic extension applicable to the guidance system design is
   introduced, This application relates to terminal guidance design for
   guided missiles. Mach number, altitude, and time to go are used as
   measured, time-varying exogenous scheduling variables injected into the
   guidance law. Results from homing-loop simulations show that the
   presented approach offers better terminal guidance performance than the
   conventional proportional navigation guidance design, that is, less
   control effort and a smaller miss distance.},
