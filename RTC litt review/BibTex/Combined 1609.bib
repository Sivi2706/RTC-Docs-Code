@article{ WOS:000427244700012,
Author = {Chen, Zhongyuan and Chen, Wanchun and Liu, Xiaoming and Song, Chuang},
Title = {Development of an educational interactive hardware-in-the-loop missile
   guidance system simulator},
Journal = {COMPUTER APPLICATIONS IN ENGINEERING EDUCATION},
Year = {2018},
Volume = {26},
Number = {2},
Pages = {341-355},
Month = {MAR},
Abstract = {This paper presents a hardware-in-the-loop (HIL) simulator, named
   HIL-GSS, which aims to help the students of aerospace engineering learn
   control and missile guidance theories effectively by using interactive
   instrumentation. Electromechanical components and interactive panels are
   illustrated. Two case-based studies are presented to show the advantages
   that HIL-GSS offers to engineering education. Steady-state tracking
   errors of the PID controller based on the HIL-GSS are around zero. The
   final miss distance in the real-time HIL TV guidance engagement
   simulation is 0.2376m. Those results show the reliability of the
   proposed HIL simulator. In addition, the students' average response to
   survey questions is 4.22 (1-5 grade scale), which indicates that
   students strongly agree or agree that HIL-GSS is an effective
   educational tool.},
