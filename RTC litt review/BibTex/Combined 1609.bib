@inproceedings{ WOS:000084509700015,
Author = {Varadan, VK and Varadan, VV},
Editor = {Bergmann, NW and Reinhold, O and Tien, NC},
Title = {MEMS-IDT based micro accelerometers and gyroscopes},
Booktitle = {ELECTRONICS AND STRUCTURES FOR MEMS},
