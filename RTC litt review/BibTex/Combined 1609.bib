@article{ WOS:001777081300001,
Author = {Dai, Aixin and Xiao, Yancai and Shen, Haikuo and Zhi, Shaodan and Han,
   Shuo},
Title = {A dynamic graph temporal-spatial interaction method for anomaly
   detection in spacecraft multivariate telemetry data},
Journal = {MEASUREMENT SCIENCE AND TECHNOLOGY},
Year = {2026},
Volume = {37},
Number = {21},
Month = {MAY 22},
Abstract = {With the increasing digitization and intelligence of next-generation
   spacecraft, telemetry data exhibit increasingly complex characteristics,
   including dynamic inter-variable coupling, multivariate heterogeneity,
   and non-stationarity. Conventional anomaly detection approaches often
   struggle to effectively model the high-dimensional temporal-spatial
   dependencies inherent in such data. To overcome the limitations of
   existing deep learning methods in modeling dynamic topological evolution
   and heterogeneous telemetry, this paper proposes a dynamic graph
   temporal-spatial interaction multivariate anomaly detection (DGTSI-MAD)
   method. A novel dynamic graph construction module is designed to
   automatically learn the topology among telemetry variables evolving over
   time based on segmented data without prior knowledge, thus capturing the
   dynamic spatial dependencies. Furthermore, a heterogeneous feature
   differentiation strategy is introduced to map variables with different
   attributes into a unified high-dimensional latent space while preserving
   the semantic and temporal logic of discrete status variables. By
   integrating the temporal-spatial interaction mechanism and a dual-branch
   decision network, the model can simultaneously capture long-range
   temporal dependence and fine-grained spatial correlation, while
   maintaining high sensitivity to abrupt and distributed anomalies.
   Experimental results on a launch-vehicle Inertial Measurement Unit
   dataset and two public spacecraft telemetry benchmarks demonstrate the
   effectiveness of DGTSI-MAD. This method provides a more precise
   data-driven anomaly detection solution for multivariate telemetry data.},
