@article{ WOS:000383422100093,
Author = {Dombrowski, M. P. and LaBelle, J. and McGaw, D. G. and Broughton, M. C.},
Title = {An autonomous receiver/digital signal processor applied to ground-based
   and rocket-borne wave experiments},
