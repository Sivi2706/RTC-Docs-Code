Volume = {101},
Pages = {351-364},
Note = {22nd Annual AAS Rocky Mountain Guidance and Control Conference,
   BRECKENRIDGE, CO, FEB 03-07, 1999},
Organization = {Amer Astronaut Sci},
Abstract = {The Missile Technology Demonstration Program is a cooperative program
   between the Ballistic Missile Technology Office of the Air Force
   Research Laboratory, Kirtland AFB, New Mexico and the Theater Targets
   Product Office of the US Army Space and Missile Defense Command,
   Huntsville, Alabama. Through the launch of a series of ballistic missile
   experiments, technology demonstrations to validate the use of the Global
   Positioning Systems (GPS) for range safety and precision guidance,
   automated self-destruct algorithms, high speed penetrators and smart
   fuses have and will be executed. These demonstrations ultimately support
   developing the capability for global strike against weapons of mass
   destruction and hard and deeply buried targets using conventional means
   of deterrence. A sub-orbital missile night from the White Sands Missile
   Range (WSMR) was launched on 24 September 1998. Designated Missile
   Technology Demonstration-3 (MTD-3), it was the third flight of its kind
   having the principle objective of demonstrating GPS and Differential GPS
   (DGPS) technology applied to range safety and tracking and precision
   guidance. In addition to a tightly coupled Inertial Platform
   Assembly/DGPS navigation system, five GPS experiments were flown. Four
   of the experiments flew in the booster interstage module and one was a
   re-entry vehicle (RV) experiment. An additional experiment package in
   the MTD-3 RV comprised a 664-pound earth penetrator instrumented with
   two accelerator packages. The RV impacted the ground at approximately
   4000 feet/second. The flight path angle at impact was near vertical.
   Excellent miss distance and navigation accuracy was achieved. The impact
   site was located within the boundaries of the alternate Seismic Hardrock
   In-situ Source Test site on the north end of WSMR, which is of weathered
   granite composition. This paper provides a brief background on the MTD-1
   and MTD-2 flights and provides a more detailed discussion of the MTD-3
   mission and flight results.},
