Year = {2025},
Note = {2025 Microwaves Antennas and Propagation Conference-MAPCON-Annual,
   Kochi, INDIA, DEC 14-18, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {This paper presents the design aspects and realization of a dual
   circularly polarized aperture coupled antenna array for Launch Vehicle
   telemetry reception. An antenna array tile consists of 4x4 aperture
   coupled patch antenna elements, 4x4 quadrature hybrids and RHCP/LHCP
   feed network is realized using Rogers RO4003 substrate in a multi-layer
   configuration. Rohacell foam material, with a dielectric constant of
   1.06 and a thickness of 5 mm, is used between the patch array and the
   quadrature hybrid feed network to reduce weight and enhance impedance
   bandwidth. The antenna array has a 2:1 VSWR bandwidth of 11.5\% centered
   at 2.25GHz and gain of 16dBi throughout the required telemetry band of
   2.2GHz to 2.3GHz. Overall dimension of the antenna array tile is 300mm x
   300mm x 9mm.},
