Title = {High Precision and Fast Initial Alignment for Vehicle Mounted Guided
   Rocket in Erection Process},
Booktitle = {ADVANCES IN GUIDANCE, NAVIGATION AND CONTROL},
Series = {Lecture Notes in Electrical Engineering},
Year = {2023},
Volume = {845},
Pages = {2085-2093},
Note = {2022 International Conference on Guidance, Navigation and Control,
   Harbin, PEOPLES R CHINA, AUG 05-07, 2022},
Organization = {Harbin Engineering University},
Abstract = {Aiming at the requirements of high-precision pure inertial navigation
   performance and firepower rapid reaction for vehicle-mounted long-range
   guided rockets (LRGR), a high-precision and fast initial alignment
   method for the LRGR strapdown inertial navigation system (SINS) is
   proposed. It carries out around the erection of launch canister with the
   help of vehicle location and orientation navigation system (LONS) at the
   launch site. The simulation shows that the estimation error of
   horizontal misalignment angle is better than the limit alignment
   accuracy determined by the accelerometer, while the azimuth alignment
   accuracy can reach close to that of LONS. It not only reduces the time
   spent for the initial aliment of LRGR at the launch site, but also
   relaxes the required performance index of the LRGR gyro. This proposed
   method improves firepower reaction speed and pure inertial navigation
   accuracy for LRGRs and has great practical engineering significance.},
