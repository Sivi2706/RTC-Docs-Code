@inproceedings{ WOS:000265094200030,
Author = {Sun, Ping and Liu, Kun},
Editor = {Loach, K},
Title = {Missile Autopilot Design Based on State Dependent Riccati Equation},
Booktitle = {2009 INTERNATIONAL ASIA CONFERENCE ON INFORMATICS IN CONTROL,
   AUTOMATION, AND ROBOTICS, PROCEEDINGS},
Year = {2009},
Pages = {134-138},
Note = {International Asia Conference on Informatics in Control, Automation and
   Robotics, Bangkok, THAILAND, FEB 01-02, 2009},
Organization = {Int Sci \& Engn Sco},
Abstract = {In this paper a control approach is presented for flight control system
   of a rigid body missile using both State Dependent Riccati Equation
   (SDRE) method and Fast Output Sampling (FOS) technique. The dynamics and
   kinematics for missile attitude stable problem are of typical nonlinear
   character. SDRE technique has been well applied to this kind of highly
   nonlinear control problems. But in practice the system states needed in
   the SDRE method are sometimes difficult to obtain. FOS method, which
   makes use of only the output samples, is combined with SDRE to
   accommodate the incomplete system state information. Thus, the control
   approach is more practical and easy to implement. The method and its
   stabilization are examined under numerical simulations and the results
   show that the proposed method produces excellent results and multi-model
   robust stabilization is achieved.},
