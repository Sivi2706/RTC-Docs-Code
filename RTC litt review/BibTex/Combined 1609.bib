Year = {2019},
Note = {IEEE Aerospace Conference, Big Sky, MT, MAR 02-09, 2019},
Organization = {IEEE},
Abstract = {The study is to perform dynamic link analysis to determine the earliest
   separation time of the Space Vehicle (SV) from the Launch Vehicle (V)
   while meeting the SV link requirements for Telemetry, Tracking and
   Control (TT\&C) uplink \& downlink services from/to ground stations.
   Successful rocket launch required adequate link coverage throughout the
   flight and good Radio Frequency (RF) performance. The presentation will
   discuss the concept of the dynamic link analysis, SV antenna switching
   schedule, recommended SV separation time, as well as the performance for
   different launch scenarios within the 24-hour launch window. Topics will
   include antenna patterns, launch trajectories, elevation angle, and
   clock \& cone angle geometry, and dynamic link budget.},
