Pages = {3061-3069},
Month = {MAY},
Abstract = {This paper presents a new approach in nonlinear guidance law design. The
   new guidance law is developed based on partial stability theorem and
   enables the missile to intercept highly maneuvering targets with
   zero-miss-distance within a finite interception time. The approach is
   advantageous from practical view-points since it leads to classification
   of state variables of the guidance system dynamic with respect to their
   required stability properties and tries to adapt with practical
   situations. Effectiveness of the proposed guidance law in achieving
   zero-miss-distance within a finite interception time is demonstrated
   analytically and through computer simulations.},
