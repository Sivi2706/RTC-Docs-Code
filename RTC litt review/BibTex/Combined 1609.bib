@inproceedings{ WOS:000428518302154,
Author = {Chopra, Rinkee and Kumar, Girish},
Book-Group-Author = {IEEE},
Title = {Compact Dumbbell Shaped Microstrip Antenna with Suppressed Harmonics},
Booktitle = {2017 PROGRESS IN ELECTROMAGNETICS RESEARCH SYMPOSIUM - FALL (PIERS -
   FALL)},
Series = {Progress in Electromagnetics Research Symposium},
Year = {2017},
Pages = {2838-2843},
Note = {Progress in Electromagnetics Research Symposium - Fall (PIERS - FALL),
   Singapore, SINGAPORE, NOV 19-22, 2017},
Organization = {Inst Elect \& Elect Engineers; Nanyang Technol Univ; Electromagnet Acad;
   Inst Elect \& Elect Engineers Geoscience \& Remote Sensing Soc; Comp
   Simulat Technol; Off Naval Res Global; Interhorizon Corp Pte Ltd; Linbou
   Nearfield Technol Co Ltd; Rohde \& Schwarz; YSL Photon; Zhejiang Univ,
   Electromagnet Acad; Singapore Exhibit \& Convent Bur; YourSingapore},
Abstract = {In this paper, a circular compact dumbbell shaped microstrip antenna is
   designed in normal mode suspended configuration at 2.25 GHz. Two
   symmetric slots in circular patch are cut to reduce the size of antenna.
   Parametric study of slot length and width is done to optimize the
   dimensions of slot. The size of the designed antenna is reduced by 72\%
   in comparison to conventional circular microstrip antenna. Various
   performance parameters like gain, bandwidth are compared and analyzed.
   Compact dumbbell shaped microstrip antenna suppresses the higher order
   harmonics. Radome and cavity are used to protect the antenna from
   environment and unwanted interference. Compact antenna with radome
   provides more bandwidth due to the superstrate loading effect. 225 MHz
   bandwidth is achieved at 2.25 GHz for the designed compact
   configuration. Peak gain of 7 dBi is obtained for this configuration.
   Half power beam width of 90 is achieved with broadside and stable
   radiation pattern throughout the bandwidth. Front to back lobe ratio of
   better than 13 dB and cross polar level of better than 28 dB is
   achieved. Antenna is fabricated and results are measured to verify the
   concept. This antenna can be used in telemetry systems which are used to
   study missile health parameters.},
