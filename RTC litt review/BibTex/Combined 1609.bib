@inproceedings{ WOS:A1997BJ77Q00004,
Author = {Braghin, M and Rustichelli, S and Pavanello, R and Bock, D},
Editor = {Guyenne, TD},
Title = {Peculiar aspects of INTEGRAL test program},
Booktitle = {THIRD INTERNATIONAL SYMPOSIUM ON ENVIRONMENTAL TESTING FOR SPACE
   PROGRAMMES},
Series = {ESA SPECIAL PUBLICATIONS},
Year = {1997},
Volume = {408},
Pages = {39-46},
Note = {3rd International Symposium on Environmental Testing for Space
   Programmes, ESTEC, NOORDWIJK, NETHERLANDS, JUN 24-27, 1997},
Organization = {European Space Agcy, ESTEC},
Abstract = {The INTEGRAL Satellite will enable scientific measurements of galactic
   sources in the field of the gamma ray spectrum. It will be designed,
   integrated and verified by Alenia Spazio Torino as Prime Contractor of
   ESA. This is a Cornerstone of the ESA Space Programs scenario named
   `'Horizon 2000 Plus''.
   The INTEGRAL project shows some specific features in the field of design
   approach and verification. In the design field, the spacecraft design
   will make maximum reuse of the Service Vehicle Module (SVM) designed for
   another ESA satellite making observations in the X-ray band: XMM. The
   reason is that the SVM design for XMM is considered sufficiently close
   to the INTEGRAL needs, due to the similarity of the missions defined for
   the two satellites. INTEGRAL will use the SVM with limited modifications
   necessary to adapt it to the requirements that are peculiar of this
   project, and to interface it with the Payload Module (PLM) carrying the
   scientific instruments. The qualification aspects are also not usual in
   the INTEGRAL project, because the XMM will be qualified against an
   environment that is induced by the usage of the Ariane 5 launcher, while
   it is required to INTEGRAL to be able to be launched by either Ariane 5
   itself or Proton, a well known Russian missile, introducing a different
   induced environment. This implies that the verification by similarity of
   the XMM SVM can be applied only partially, and its qualification will
   have to be completed with a delta activity taking care of the additional
   requirements due to Proton.
   As a programmatic approach, ESA has addressed Alenia Spazio to make use,
   for the INTEGRAL system qualification tests, of models of the SVM built
   for the XMM test campaign, i.e. the Structural and Thermal Model (STM)
   for mechanical tests and the thermal balance test, and the Engineering
   Model (EM) for functional testing of the on-board avionics. This
   requirement will be met introducing a refurbishment activity on the
   models, to implement on them the design changes needed to update them to
   the INTEGRAL configuration.
   It is the first time that the commonality concept is applied on ESA
   scientific satellites, using a recurring SVM. The peculiarity of this
   approach is discussed in detail.},
Publisher = {EUROPEAN SPACE AGENCY},
Address = {8-10 RUE MARIO NIKIS, 75738 PARIS, FRANCE},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Braghin, M (Corresponding Author), ALENIA AEROSP TORINO,CORSO MARCHE 41,I-10146 TURIN,ITALY.},
ISSN = {0379-6566},
ISBN = {92-9092-315-6},
