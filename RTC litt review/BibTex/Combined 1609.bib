@inproceedings{ WOS:001659589700423,
Author = {Chua, Darell and Kumar, Anchit and Pertsel, Anthony and Morris, Karcher},
Book-Group-Author = {AIAA},
Title = {Vertically-Integrated Modular Distributed Data Acquisition System For
   Cryogenic Liquid Bi-Propellant Rocket and Component Testing Based On
   SAMDAS Architecture},
Booktitle = {AIAA SCITECH 2025 FORUM},
Year = {2025},
Note = {2025 AIAA SCITECH Forum, Orlando, FL, JAN 06-10, 2025},
Abstract = {This study introduces Vertical Integration through the Scalable And
   Modular Distributed Avionics System (SAMDAS) architecture for use in
   data acquisition systems. The Vertically-Integrated Modular Distributed
   Data Acquisition System (VIMDAQ) is a fully integrated hardware and
   software solution designed to enhance data acquisition and control in
   liquid cryogenic bipropellant rocketry. Utilizing open source and
   commercially available software and hardware components, SAMDAS replaces
   intermediate dedicated software and hardware layers with a common-type
   modular, distributed network system. Bench and field tests, including
   LOX/LNG igniter trials in the Mojave Desert, demonstrated the system's
   robustness, reliability, and flexibility. Iterative feedback from field
   deployments and user evaluations informed significant design
   refinements, emphasizing adaptability and reliability. Key features
   include real-time status verification, error isolation, intuitive user
   experience, and scalability. Results from real-world deployment of
   VIMDAQ highlight the practical advantages of SAMDAS for use in data
   acquisition technology for high-risk environments, including complex
   industrial and aerospace applications.},
