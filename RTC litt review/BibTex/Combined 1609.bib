@inproceedings{ WOS:001409507007065,
Author = {Goodman, John L.},
Book-Group-Author = {AIAA},
Title = {Helmut Horn and the Origin of the Saturn V Iterative Guidance Mode (IGM)},
Booktitle = {AIAA SCITECH 2021 FORUM},
Year = {2021},
Note = {AIAA Science and Technology Forum and Exposition (AIAA SciTech Forum),
   ELECTR NETWORK, JAN 11-21, 2021},
Organization = {Amer Inst Aeronaut \& Astonaut},
Abstract = {The development of the Iterative Guidance Mode (IGM), a closed loop,
   exo-atmospheric, explicit guidance algorithm that ran on a digital
   flight computer, was one of many technological innovations that enabled
   the success of the Apollo Program. Circa 1960 or 1961, Helmut Horn, a
   Peenemunde veteran and branch chief at the NASA Marshall Space Flight
   Center, embedded a simplified and modified version of Derek Lawden's
   bilinear tangent steering law in the equations of motion to obtain
   computer generated, approximately optimal powered flight trajectories.
   Such a method could potentially provide optimal trajectories much faster
   and more reliably than existing calculus of variations optimization
   software. Horn's idea led to development of IGM to serve as on-board
   guidance for several Saturn I, and all Saturn IB and Saturn V launch
   vehicles.},
