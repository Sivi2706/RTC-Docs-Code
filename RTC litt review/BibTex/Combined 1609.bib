Year = {2013},
Pages = {481-484},
Note = {International Conference on Electrical, Control and Automation
   Engineering (ECAE), Hong Kong, PEOPLES R CHINA, DEC 01-02, 2013},
Abstract = {The guided munitions guidance system in the blind area after the attack
   process is analyzed, using the chain to obtain the detection information
   of the target distance, to estimate the final rendezvous state; the beam
   scattering model is built to analyze the fragment to the warhead part of
   the target. Simulation results show that using two-way data chain
   between missile and target, according to the feedback information of
   target missile can be effectively estimated to the target attitude and
   killing probability of the missile to hold the target damage. It can
   improve perception capability and combat effectiveness of the flight
   platform in the war battlefield.},
