@inproceedings{ WOS:000175678400105,
Author = {Percival, JW and Nordsieck, KH},
Editor = {Harnden, FR and Primini, FA and Payne, HE},
Title = {The ST5000: An attitude determination system with low-bandwidth digital
   imaging},
Booktitle = {ASTRONOMICAL DATA ANALYSIS SOFTWARE AND SYSTEMS X},
Series = {ASTRONOMICAL SOCIETY OF THE PACIFIC CONFERENCE SERIES},
Year = {2001},
Volume = {238},
Pages = {463-466},
Note = {10th Annual Conference for Astronomical Data Analysis Software and
   Systems (ADASS 2000), BOSTON, MA, NOV 12-15, 2000},
Organization = {Akibia Inc; Canada France Hawaii Telescope; NASA; Space Telescope Sci
   Inst; Smithsonian Astrophys Observ; NOAO},
Abstract = {The Space Astronomy Laboratory is building an attitude determination and
   digital imaging system with embedded compression. The attitude
   determination system uses a 30-square-degree field of view and an
   embedded star catalog to determine the Right Ascension and Declination
   of its line of sight to better than 5 arcseconds. The digital imaging
   subsystem uses a scheme of ``progressive image transmission{''} in which
   the image is sent out over a very-low-bandwidth channel, such as a
   spacecraft telemetry downlink, in such a way that it can be
   reconstructed ``on the fly{''} and updated as more data arrive. Large
   (768 x 474) useful images can be obtained over a 4-kbit downlink in as
   little as 10 seconds.
   In addition to its use in sounding rockets and spacecraft, we are
   planning to use it for two ground-based applications at the Southern
   Africa Large Telescope (SALT). We will explore its use in generating
   real-time measurements of the telescope pointing, independent of the
   telescope control system, and we will use the low bandwidth imaging
   capability for public outreach.},
