Title = {Research of Real-Time Deterministic Ethernet in Launch Vehicle},
Booktitle = {PROCEEDINGS OF 2020 IEEE 5TH INFORMATION TECHNOLOGY AND MECHATRONICS
   ENGINEERING CONFERENCE (ITOEC 2020)},
Year = {2020},
Pages = {995-999},
Note = {IEEE 5th Information Technology and Mechatronics Engineering Conference
   (ITOEC), ELECTR NETWORK, JUN 12-14, 2020},
Organization = {IEEE; GUAST},
Abstract = {The demands of mass data transmission, intelligent test and fast
   launching technology requires the backbone communication network of the
   launch vehicle to be scalable and flexible. By improving the link layer
   and application layer protocols in the commercial Ethernet transmission
   process, a real-time deterministic network based on high-precision clock
   synchronization is proposed to meet the working requirements of the
   on-board control system and telemetry system. The simulation results
   verify the correctness and feasibility of the real-time deterministic
   Ethernet for spacecraft. The method provides support for engineering
   practice.},
