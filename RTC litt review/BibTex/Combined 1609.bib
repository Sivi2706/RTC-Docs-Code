@inproceedings{ WOS:001008282005010,
Author = {Mier-Hicks, Fernando and Grip, Havard Fjaer and Kalantari, Arash and
   Moreland, Scott and Pipenberg, Benjamin and Keennon, Matthew and Canham,
   Timothy K. and Pauken, Michael and Decrossas, Emmanuel and Tzanetos,
   Theodore and Balaram, J. (Bob)},
