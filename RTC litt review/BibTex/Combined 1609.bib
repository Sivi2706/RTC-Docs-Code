   IEEE},
Title = {Affordable Moving Surface Target Engagement},
Booktitle = {2002 IEEE AEROSPACE CONFERENCE PROCEEDINGS, VOLS 1-7},
Series = {IEEE AEROSPACE CONFERENCE PROCEEDINGS},
Year = {2002},
Pages = {2545-2551},
Note = {IEEE Aerospace Conference, BIG SKY, MT, MAR 09-16, 2002},
Organization = {IEEE Aerosp \& Electr Syst Soc; Aerosp Corp; AstroExpo com; Circle Mt
   Co; GEB Software Technologies; Jet Propulsion Lab; Opt Energies
   Technologies Inc; Profet Enterprises},
Abstract = {This paper presents the results of the Defense Advanced Research Project
   Agency-funded Affordable Moving Surface Target Engagement program. The
   overall objective was to develop affordable technologies to engage
   moving surface targets such as tanks, tactical ballistic missile
   transporters and small boats. The Northrop Grumman team used moving
   target indicator sensors on multiple aircraft to individually track
   moving ground targets. Report data were shared between sensor platforms
   to form an accurate multi-laterated track. These highly accurate track
   data were transmitted to a Lockheed Martin Precision Direct Attack
   Munition, which was released from an F-16 aircraft and guided by an
   inertial navigation system with updates from a differentially-coffected
   carrier-phase Global Positioning System receiver. The sensor platforms
   provided continuous target location updates to the weapon during flight.
   The final demonstration flight was completely successful. The Northrop
   Grumman high update rate, multi-laterated moving target indicator
   concept scored a direct hit on a remote controlled van moving at 25
   miles per hour. The views expressed in this paper are those of the
   authors and do not represent views of the U.S. government or their
   contractors.},
