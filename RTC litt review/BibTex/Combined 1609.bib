@inproceedings{ WOS:000225274000049,
Author = {Summers, J},
Book-Group-Author = {ieee},
Title = {Tactical, real-time space surveillance using multiple, ``disposable{''}
   satellites},
Booktitle = {2004 IEEE AEROSPACE CONFERENCE PROCEEDINGS, VOLS 1-6},
Series = {IEEE AEROSPACE CONFERENCE PROCEEDINGS},
Year = {2004},
Pages = {518-524},
Note = {IEEE Aerospace Conference, Big Sky, MT, MAR 06-13, 2004},
Organization = {Aerosp \& Elect Syst Soc; IEEE},
Abstract = {Because of the growing diversity and technical sophistication of the
   countries that threaten the United States, there is a growing need for a
   rapidly deployed, elusive tactical satellite architecture. This would
   entail identification of the global points of interest and strategically
   placing satellites into operation within days, if not hours. It is
   envisioned this need would typically be short lived, on the order of six
   months, and reside primarily in low earth orbit (LEO).
   Enabling to this paradigm is an agile launch platform with versatile
   trajectory, and the ability to ``scramble{''} to launch in a very short
   time. The current thinking is the development of a small, responsive
   launch vehicle or air launching from existing military aircraft.
   However, both these scenarios require drastic reductions resulting in
   satellite volume and mass on the order of 100 kg and approximately 1
   cubic meter.
   An approach to achieving these reductions is to adopt a philosophy of
   mission success through quantity versus quality. To adopt a ``machine
   gun{''} mentality of firing many low cost, ``disposable{''} rounds to
   ensure one reaches the target. This would require acceptance of
   significant sacrifices in capability and reliability at the single
   spacecraft level. Accepting such a drop off in performance and life
   would in turn drive down cost and turn around time, while increasing
   opportunity for component commonality and mass production.
   The challenge then becomes defining a per unit cost low enough that
   cumulatively amounts to mission cost equal or less than the same mission
   performed by a single, highly reliable satellite.
   The cost to perform a three-year mission using one, highly redundant
   satellite currently ranges from \$50-100M. Analysis predicts, due to the
   reductions in performance and reliability, it would take approximately
   twelve, single ``disposable{''} assets to perform the same mission. This
   suggests the allowable cost for a tactical asset at roughly \$4.2 M to
   preserve an equivalent mission cost.
   Staying within the cost goal for multiple satellites requires
   development of a mass producible standard bus that provides optimum
   performance to a wide range of users. To achieve this, mission needs of
   the user community could be categorized to establish a few, broad
   capability niches. These would be the basis for a family of ``core{''}
   vehicles designed to satisfy the needs of each niche.
   Within each niche the core vehicles would be outfitted with mission
   specific, modular ``kits{''}, made up from stores of components with
   standardized interfaces to focus their performance on unique mission
   needs.
   To enable the idea of ``disposable{''} sats continued technology
   development is needed. As part of its on-going small satellite
   developments, MicroSat Systems Inc. (MSI) has taken steps toward
   satellite component miniaturization and rapid satellite processing
   techniques that take advantage of web-based design and test tools.
   Flexible photovoltaics and batteries, miniature mass memory storage
   devices, conformal avionics, and modular, ``smart{''}
   mechanical/electrical interfaces can enable drastic reductions in
   package size without sacrificing performance.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Summers, J (Corresponding Author), MicroSat Syst Inc, 8130 Shafter Pkwy, Littleton, CO 80127 USA.
   MicroSat Syst Inc, Littleton, CO 80127 USA.},
DOI = {10.1109/AERO.2004.1367635},
ISSN = {1095-323X},
