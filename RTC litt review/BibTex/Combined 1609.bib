@article{ WOS:001457783700013,
Author = {Li, Jun and Zhang, Shifeng and Yang, Huabo and Jiang, Zhenyu and Bai,
   Xibin},
Title = {INS Adaptive Rotational Modulation Method Based on Norm Control of
   Circumstance Function Matrix},
Journal = {IEEE SENSORS JOURNAL},
Year = {2025},
Volume = {25},
Number = {7},
Pages = {11651-11664},
Month = {APR 1},
Abstract = {The rotational inertial navigation system (RINS) can reduce its error by
   regularly changing the inertial device's attitude. But the pre-designed
   rotation scheme of the traditional rotational modulation method will
   lose its optimality under high dynamic conditions or framework control
   error. In this article, we overcome this problem by adaptive planning of
   the next rotation in the operation. First, this article interprets the
   rotation modulation technique as controlling the circumstance function
   matrix (CFM), which records the information of uncompensated navigation
   errors. Then, a general method of rotation scheme design using numerical
   optimization is established. Finally, the adaptive rotational modulation
   method is proposed, which is a model predictive controller using the
   norm of the CFM as a control variable. In this way, the rotation
   instruction is generated online through rolling optimization. Numerical
   simulation shows that this adaptive rotation modulation method is
   superior to the traditional way under high dynamic conditions such as
   rocket launch. Moreover, a fixed point navigation experiment proves that
   the adaptive rotation modulation method has higher navigation accuracy
   than the traditional method under framework rotation error.},
