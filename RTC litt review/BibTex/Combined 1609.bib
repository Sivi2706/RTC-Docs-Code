@inproceedings{ WOS:001463221800112,
Author = {Zhang Jianhai and Song Lupeng and Dong, Zhang and Guo Weina and Sun
   Shouhang},
Editor = {Yan, L and Duan, H and Deng, Y},
Title = {Rocket Telemetry Data Evaluation Method Based on Data Threshold
   Envelopment Analysis},
Booktitle = {ADVANCES IN GUIDANCE, NAVIGATION AND CONTROL},
Series = {Lecture Notes in Electrical Engineering},
Year = {2023},
Volume = {845},
Pages = {1126-1135},
Note = {2022 International Conference on Guidance, Navigation and Control,
   Harbin, PEOPLES R CHINA, AUG 05-07, 2022},
Organization = {Harbin Engineering University},
Abstract = {In order to accurately evaluate the flight performance of rocket,
   accurately locate the cause of rocket failure and optimize the engine
   design, it is necessary to conduct in-depth analysis on the measured
   data of launch vehicle. In this paper, based on the in-depth analysis of
   a large number of successful history test data of the same type, a data
   analysis and evaluation method based on the threshold envelope is
   proposed. The method is used to evaluate the data to be analyzed. If the
   data to be analyzed falls between the threshold envelope lines, the
   reliability of the data to be analyzed is considered high. If the data
   to be analyzed is out of the scope of the envelope in some locations or
   overall, it is considered that there may be anomalies in the data to be
   analyzed, and it is necessary to pay attention to them and make a
   comprehensive analysis in combination with other relevant data. The
   evaluation method is efficient and easy to operate, which provides an
   important basis for rocket anomaly analysis and fault location.},
