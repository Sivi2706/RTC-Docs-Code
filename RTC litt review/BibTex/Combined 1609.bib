@inproceedings{ WOS:000258321201149,
Author = {Jackson, Bill},
Book-Group-Author = {IEEE},
Title = {A low-cost, responsive microsat bus utilizing COTS parts and components},
Booktitle = {2008 IEEE AEROSPACE CONFERENCE, VOLS 1-9},
