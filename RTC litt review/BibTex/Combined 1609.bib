@inproceedings{ WOS:000262289601093,
Author = {Gu, Wenjin and Zhang, Ruchuan and Zhao, Hongchao},
Editor = {Xia, GP and Deng, XQ},
Title = {SLIDING MODE GUIDANCE LAW FOR SUPER-SONIC MISSILE BASED ON FUZZY CMAC
   NEURAL NETWORK},
Booktitle = {PROCEEDINGS OF THE 38TH INTERNATIONAL CONFERENCE ON COMPUTERS AND
   INDUSTRIAL ENGINEERING, VOLS 1-3},
Year = {2008},
Pages = {2659-2664},
Note = {38th International Conference on Computers and Industrial Engineering,
   Beihang Univ, Beijing, PEOPLES R CHINA, OCT 31-NOV 02, 2008},
Abstract = {A novel guidance algorithm for super-sonic missile was proposed in this
   study. The main objective of this paper was to improve the performance
   of missile guidance law considering control loop when uncertainty was
   considered. Firstly, the normal form of the fourth order state equation
   for integrated guidance and control loop about the yaw plane was
   formulated by feedback linearization technique. Next the proposed
   approach adopted the sliding mode control algorithm with adaptation for
   the uncertainties of guidance dynamics and target acceleration based on
   backstepping and fuzzy CAM C (FCMAC) neural network (NN) algorithm,
   which was employed to estimate the nonlinear function and state
   derivatives of guidance system. And stability analysis has been done for
   the overall system including the guidance and control loop. Finally, the
   simulation results show the effectiveness of the proposed guidance law.},
