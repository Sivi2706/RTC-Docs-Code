@inproceedings{ WOS:000288362800014,
Author = {Miyamoto, Shintaro and Fukuda, Keita and Abe, Koichiro and Kamoda,
   Hiroshi and Goto, Hirotaka and Nishihara, Ken and Shiegtomi, Akihito and
   Fujii, Susumu and Sagara, Shinichi and Yonemoto, Koichi},
Book-Group-Author = {Chinese Society of Aeronautics and Astronautics (CSAA)},
Title = {Launch Campaign of KIT Student's Experimental Rocket ``Ninja-10{''} and
   ``Sakura{''} in France},
Booktitle = {PROCEEDINGS OF 2010 ASIA-PACIFIC INTERNATIONAL SYMPOSIUM ON AEROSPACE
   TECHNOLOGY, VOL 1 AND 2},
Year = {2010},
Pages = {58-61},
Note = {Asia-Pacific International Symposium on Aerospace Technology, Xian,
   PEOPLES R CHINA, SEP 13-15, 2010},
Organization = {NW Polytechn Univ; AVIC First Aircraft Design \& Res Inst; AVIC Aircraft
   Strength Res Inst},
Abstract = {Small experimental rockets have been developed by the student group of
   Kyushu Institute of Technology for the rocket launch campaign held in
   France since 2006. This paper introduces the newest design of two
   rockets. One of the rockets, which is designated Ninja-10, aims at point
   tracing using by parafoil during the recovery gliding flight. After
   ignition, the rocket reaches to an altitude of about 635m in 12 seconds.
   During the coasting flight up to the apogee, the roll is controlled by
   ailerons to maintain the doors of ejection system bay upward. At the
   apogee, the door of ejection system bay opens, and a drogue chute is
   ejected to deploy parafoil. When the rocket begins to perform a steady
   gliding flight and the onboard microcomputer establishes signal
   processing from GPS satellites, the navigation calculation starts to
   guide the rocket to an aiming point. Another rocket, which is designated
   Sakura, aims at supersonic flight. After ignition, the rocket reaches
   the speed of sound in 4 sec. The location, acceleration and velocity of
   rocket are measured using GPS receiver, accelerometer and 1-hole pitot
   tube in order to study transonic aerodynamic characteristics flying from
   subsonic to supersonic speed. The measured data is recorded onboard and
   transmitted by telemetry system to ground.},
