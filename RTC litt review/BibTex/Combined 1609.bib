Note = {20th Chinese Control and Decision Conference, Yantai, PEOPLES R CHINA,
   JUL 02-04, 2008},
Abstract = {To aim at the characteristic of launch vehicle flight safety control,
   according to the dynamic characteristic and statistical characteristic
   of the data respectively from the telemetry and Exteiror, this paper
   proposes a layered multi-stage dynamic combination Kalman filtering
   fusion method based on the trajectory examination and the sequential
   fusion, solves the problem that the reliability of fusion data is
   reduced because of the fused sensor's blunder error or losing target and
   gains the accurate parameter and trajectory of launch vehicle Right. It
   builds the description model of launch vehicle flying status under the
   constraint of safety flight, uses the backward reasoning and matches the
   fact satisfying the condition recursively in real-time, providing the
   actual information of launch vehicle flight to safety control
   supervisors. The practical application indicated that the method
   proposed by this paper is feasible.},
