@article{ WOS:000224539500020,
Author = {Kodeki, K and Fukushima, K and Inoue, M and Kashiwase, T and Shimizu, T
   and Sakao, T and Kano, R and Hara, H and Nagata, S and Yoshida, T and
   Tsuneta, S},
Title = {Design and performance of tip-tilt mirror system for solar telescope},
Journal = {JOURNAL OF SPACECRAFT AND ROCKETS},
Year = {2004},
Volume = {41},
Number = {5},
Pages = {868-876},
Month = {SEP-OCT},
Abstract = {The tip-tilt mirror (TTM) system was developed for the extreme
   ultraviolet (XUV) Cassegrain telescope aboard the Institute of Space and
   Astronautical Science sounding rocket. The spatial resolution of the
   telescope is about 5 arcsec, whereas the rocket pointing is only
   controlled to be within +/-0.5 deg of the target (sun) without
   additional stability control. To stabilize the XUV image within about 5
   arcsec on the focal plane, the TTM system controls the tilt of the
   secondary mirror with two-axis fixed-coil magnetic actuators. The TTM
   system has a wide tilt angle and can drive the large secondary mirror at
   high frequency. The two position-sensitive detectors, one placed in the
   telescope and the other in the TTM mechanical structure, are used for
   closed-loop control of the TTM. The closed-loop control system, which
   has command and telemetry, is executed by the flight software on the
   digital signal processor. The TTM has a launch-lock mechanism to protect
   against launch vibrations up to about 16G. The sounding rocket was
   launched from the Kagoshima Space Center on 31 January 1998. The TTM
   worked perfectly during the flight and achieved better than the expected
   5-arcsec stability on the focal plane during CCD charge-coupled device
   exposures.},
