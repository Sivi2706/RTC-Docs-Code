Title = {Performance evaluation of selected ionospheric delay models during
   geomagnetic storm conditions in low-latitude region},
Journal = {RADIO SCIENCE},
Year = {2011},
Volume = {46},
Month = {JUN 29},
Abstract = {Investigation of space weather effects on GPS satellite navigation
   systems is very crucial in high-precision positional applications such
   as aircraft landings and missile guidance, etc. The geomagnetic storms
   can drastically affect the total electron content (TEC) of the
   ionosphere even in low latitudes, especially for Indian region as it
   comes under low-latitude region. Hence, the performance of three
   prominent ionospheric models is investigated for adverse ionospheric
   conditions using 17 GPS TEC stations data. The models characterized the
   ionospheric disturbances due to two magnetic storms well.},
