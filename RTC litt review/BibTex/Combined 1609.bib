Title = {Case study: Monte Carlo testing of the Titan launch vehicle flight
   control subsystem},
Booktitle = {PROCEEDINGS OF THE MILITARY, GOVERNMENT AND AEROSPACE SIMULATION},
Year = {1999},
Pages = {143-148},
Note = {1999 Advanced Simulation Technologies Conference (ASTC 99), SAN DIEGO,
   CA, APR 11-15, 1999},
Organization = {Soc Comp Simulat Int},
Abstract = {Testing of advanced flight control systems typically involves
   simulations of the subject hardware with nominal, dispersed, and
   worst-case scenarios for system parameters. The task is particularly
   demanding for large, complex systems such as the Titan IV-B heavy lift
   launch vehicle system during booster flight control, due to many
   inherent sources of system uncertainty. The Monte Carlo approach is an
   attractive solution for modeling reasonable worst-case test scenarios.
   With faster computing speeds now available, a series of 1400 simulation
   tests can be reasonably executed to characterize vehicle dispersions.
   Analex has utilized the Monte Carlo approach in their Titan Universal
   Validation Tool (TUVT) for independent testing of the Titan IV-B vehicle
   booster flight software control subsystem. The model requirements,
   implementation considerations, lessons learned and simulation results
   for two Titan IV-B missions are presented. The Monte Carlo technique was
   found to be a practical tool for verifying dispersed vehicle performance
   against specific mission requirements.},
