@article{ WOS:001814106500001,
Author = {dos Santos, Carlos Renato and Costa Pinto, Adriano and da Silva Pinho,
   Marcelo and Cristina M Nascimento Leite, Valeria and Reboucas de
   Medeiros, Renato and de Oliveira Moraes, Alison},
Title = {Very-low bit rate spectral vibration compression for aerospace telemetry},
Journal = {MEASUREMENT SCIENCE AND TECHNOLOGY},
Year = {2026},
Volume = {37},
Number = {27},
Month = {JUL 10},
Abstract = {Vibration data obtained from sounding rocket missions is critical for
   structural analysis, model verification, and refinement of the
   qualification environment. Because of their high sampling rates,
   vibration channels usually consume most of the telemetry bandwidth,
   causing strict constraints on instrumentation and telemetry. In
   aerospace applications, vibration data analysis primarily focuses on
   spectral and energy-related features rather than waveform details. This
   paper introduces an embedded vibration data compression system that
   specifically targets the high-bandwidth requirements of vibration
   channels in aerospace telemetry systems, enabling operation in a very
   low bit rate environment. The proposed system integrates spectral
   features with structural modeling concepts developed from modal
   analysis. Rather than transmitting detailed spectral information, the
   system leverages inter-sensor correlations to predict vibration
   responses, transmitting only spectral summaries and error components
   while intentionally omitting low-energy components. System performance
   is assessed using energy metrics in accordance with aerospace
   qualification standards, with special attention to maintaining the
   root-mean-square acceleration error within 5\% for the frequency range
   considered, as recommended by NASA's finite element modeling continuous
   improvement community. The new approach maintains a telemetry spectral
   efficiency of rho < 0.2 bits s(-1) Hz(-1), an improvement of more than
   an order of magnitude over traditional vibration telemetry systems,
   which operate at 12-15 bits s(-1) Hz(-1). The entire compression method
   is developed on a microcontroller-supported embedded system that is
   compatible with avionics systems on board an aircraft and tested under
   real-time processing requirements, simulating flight scenarios. Although
   motivated by sounding rocket missions, the proposed framework is also
   applicable to other bandwidth-constrained vibration-based monitoring
   systems, including industrial condition monitoring applications such as
   rolling bearing fault detection and predictive maintenance, as well as
   edge-based sensing platforms.},
