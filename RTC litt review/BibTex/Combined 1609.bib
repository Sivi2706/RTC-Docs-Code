@article{ WOS:000306352000006,
Author = {Goldan, Orly and Gutman, Shaul},
Title = {Adjoint Stability and Miss Distance in Proportional Navigation},
Journal = {JOURNAL OF GUIDANCE CONTROL AND DYNAMICS},
Year = {2012},
Volume = {35},
Number = {4},
Pages = {1089-1093},
Month = {JUL-AUG},
Note = {AIAA Guidance, Navigation, and Control Conference, Portland, OR, AUG
   07-13, 2011},
Organization = {AIAA},
Abstract = {In this paper, the performances of bounded evasive maneuvers against a
   missile guided by proportional navigation (PN) are considered.
   Naturally, guidance systems operate on a finite time interval, and the
   miss distance is measured at the end of this interval. Can a rational
   evasive maneuver force an increasing miss with an increasing time
   interval? A positive answer implies that an evasive target may force
   unbounded miss distance by starting the maneuver early enough. Taking
   the time interval to infinity, the connection of bounded miss distance
   in PN with asymptotic stability of the adjoint system is shown. Although
   this is clear on an intuitive level, it is important to present a
   rigorous proof and the correspondent conditions. In particular, under
   mild conditions, the worst miss is bounded over the infinite flight
   time.},
