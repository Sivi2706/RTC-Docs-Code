@inproceedings{ WOS:A1997BJ29B00550,
Author = {Tournes, C and Shtessel, YB and Wells, E},
Book-Group-Author = {AMER AUTOMAT CONTROL COUNCIL},
Title = {Upper stage rocket guidance and control using discontinuous reaction
   control thrusters via sliding modes},
Booktitle = {PROCEEDINGS OF THE 1997 AMERICAN CONTROL CONFERENCE, VOLS 1-6},
Series = {PROCEEDINGS OF THE AMERICAN CONTROL CONFERENCE},
Year = {1997},
Pages = {2547-2551},
Note = {1997 American Control Conference, ALBUQUERQUE, NM, JUN 04-06, 1997},
Organization = {Amer Automat Control Council; Int Federat Automat Control},
Abstract = {In spring 1995 a very significant academic project took place at the
   University of Alabama in Huntsville. This integrated project supported
   by NASA Marshal Flight Center and major aerospace, companies aimed at
   designing the MSLS upper stage, based on an hybrid rocket design. This
   project included the design of the avionics system, and of the Guidance
   and Control Subsystem (G\&C). This paper presents the architecture of
   the G\&C, and the design of corresponding algorithms. Given the
   discontinuous nature of the attitude thrusters used in the Reaction
   Control System (RCS), the proposed design is based on Output Tracking
   Sliding Mode technique. The proposed implementation of the design
   replaces the traditional high frequency relay switching by a so called
   Smoothing Sliding Mode Controller {[}1]. It uses a saturation law, where
   the amplitude of the control modulates the duration of thruster's
   pulses.},
