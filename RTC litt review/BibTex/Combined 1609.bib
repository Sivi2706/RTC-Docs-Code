Language = {English},
Affiliation = {Dunham, DW (Corresponding Author), KinetX Inc, 2050 East ASU Circle,Suite 107, Tempe, AZ 85284 USA.
   Dunham, David W.; Farquhar, Robert W., KinetX Inc, Tempe, AZ 85284 USA.
   Loucks, Michel, Space Explorat Engn, Friday Harbor, WA 98250 USA.
   Roberts, Craig E., Ai Solut Inc, Lanham, MD 20706 USA.
   Wingo, Dennis; Colleluori, Marco, SkyCorp Inc, Moffett Field, CA 94035 USA.
