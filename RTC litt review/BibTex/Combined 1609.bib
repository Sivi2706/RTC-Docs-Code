Note = {31st Chinese Control Conference, Hefei, PEOPLES R CHINA, JUL 25-27, 2012},
Organization = {CAA, Tech Comm Control Theory; Syst Engn Soc China; Univ Sci \& Technol
   China},
Abstract = {The determination of switch time of lateral thrust for the blended
   control missiles in the situation of target maneuver is researched.
   Firstly, the characteristics, which are finite time, non-zero initial
   conditions and strongly time-varying, are analyzed for the terminal
   guidance system. Based on this, the linear time-varying(LTV) model is
   established for terminal guidance system. Secondly, the finite time
   generalized H-2 performance measure and corresponding criterion are
   given for a blended control system. Finally, the Relationship between
   zero effort miss distance (ZEM) and switch time of lateral thrust is
   analyzed under different target maneuver (CA , Singer , Weaving), which
   provide the basis for the determination of switch time of lateral thrust
   for the blended control missiles.},
