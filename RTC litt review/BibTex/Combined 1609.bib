@inproceedings{ WOS:001556889805053,
Author = {Wu, Ying and Wang, Qi},
Book-Group-Author = {IEEE},
Title = {Guidance Information Estimation for Strapdown Imaging Seeker by Using
   UKF},
Booktitle = {2025 37TH CHINESE CONTROL AND DECISION CONFERENCE, CCDC},
Series = {Chinese Control and Decision Conference},
Year = {2025},
