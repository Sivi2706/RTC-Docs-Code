@article{ WOS:000490921800005,
Author = {Park, Jang-Seong and Lee, Dong-Hee and Park, Sang-Hyuk and Kim,
   Yoon-Hwan},
Title = {Impact Angle Control for Non-maneuvering Target with Look Angle
   Measurements and Line of Sight},
Journal = {JOURNAL OF THE KOREAN SOCIETY FOR AERONAUTICAL AND SPACE SCIENCES},
Year = {2019},
Volume = {47},
Number = {7},
Pages = {508-516},
Abstract = {In this paper, we propose a guidance law to control Impact Angle in
   consideration of look angle limit of the missile with strapdown seeker
   on the non-maneuvering target. The proposed law is based on sliding mode
   algorithm and generates acceleration commands using look angle and line
   of sight information provided by the strapdown seeker and navigation
   system. And, target velocity and target path angle are provided by like
   TADS (Target Acquisition and Designation System) at launch time. We can
   confirm that the target interception and impact angle control are
   possible through the convergence of the proposed sliding surface. In
   addition, it is possible to confirm that the sign of derivative result
   of the look angle at the maximum and minimum look angle is opposite to
   the sign of the look angle, so the look angle limit is not exceeded.},
