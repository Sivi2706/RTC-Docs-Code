@inproceedings{ WOS:000071918000035,
Author = {Es-Said, OS and Foyos, J and Heng, V},
Editor = {Bryskin, BD},
Title = {Preliminary results on the effect of 45° rolling mode on the mechanical
   properties of P/M rhenium},
Booktitle = {RHENIUM AND RHENIUM ALLOYS},
Year = {1996},
Pages = {355-371},
Note = {International Symposium on Rhenium and Rhenium Alloys devoted to the
   70th Anniversary of the Discovery of Rhenium, at the 1997 TMS Annual
   Meeting, ORLANDO, FL, FEB 10-13, 1997},
Organization = {Minerals Met \& Mat Soc, SMD Refractory Met Comm; Minerals Met \& Mat
   Soc, MDMD Powder Mat Comm},
Abstract = {A novel processing technique which utilizes the 45 degrees rolling mode
   is introduced. Samples cut from a rhenium billet were successfully
   rolled without intermittent annealing; once along the length of the
   samples, the second time along the width and at a 45 degrees angle in
   between both directions. Edge cracks were the slowest to initiate in the
   45 degrees rolling mode. An optimum processing method of light rolling
   (10 - 12\% reduction in thickness) along the 45 degrees direction,
   followed by intermittent annealing (1650 degrees C/30 min. in Hz
   atmosphere) was then carried out. The partial reduction and intermittent
   annealing were repeated until an 82.9\% reduction was achieved with a
   tensile strength of 2388 MPa (346.6 Ksi) and 3.3\% elongation. This
   processing technique has the potential of producing ultra high strength,
   very thin sheets, which are vital for space nuclear power applications
   and missile guidance systems.},
