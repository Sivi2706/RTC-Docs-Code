@article{ WOS:000234329300012,
Author = {Merali, Z},
Title = {Gyroscope sets course to fight cancer},
Journal = {NEW SCIENTIST},
Year = {2006},
Volume = {188},
Number = {2531},
Pages = {10},
Month = {DEC-JAN},
Abstract = {Miniaturized gyroscopes more commonly found in missile guidance systems
   can make sensitive biosensors for fast cancer diagnosis.
   Micro-gyroscopes comprise a chip with a vibrating disc the size of a
   grain of sand mounted at its center. The vibrations are highly sensitive
   to acceleration, so the chips are used to detect motion in rockets and
   aircraft. However, Calum McNeil at the University of Newcastle, UK, have
   created a gyroscopic disc less than 0,1 millimetres across. This allows
   the gyroscope to weigh proteins and therefore identify particular
   proteins produced by cancer cells.},
