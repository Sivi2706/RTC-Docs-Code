@inproceedings{ WOS:000389769800080,
Author = {Poli, Matteo and Madonna, Alberto and Donchev, Tihol and Martignago,
   Diego and Pezzato, Mattia and Trevisi, Filippo and Di Iorio, Eugenio and
   Scalzi, Davide and Nalin, Francesco and Stanco, Andrea and Debei,
   Stefano and Bettanini, Carlo},
Book-Group-Author = {IEEE},
Title = {Autonomous Re-Entry System Technology Demonstrator for Sounding Rockets
   Development of an automated control system as recovery device for
   precise landing of sounding rockets},
Booktitle = {2016 IEEE METROLOGY FOR AEROSPACE (METROAEROSPACE)},
Year = {2016},
Pages = {439-443},
Note = {3rd IEEE International Workshop on Metrology for Aerospace
   (MetroAeroSpace), Univ Studi Firenze, Florence, ITALY, JUN 21-23, 2016},
Organization = {IEEE; IEEE Instrumentat \& Measurement Soc; IEEE AESS},
Abstract = {The Nimbus Project team, made of young engineers and university
   students, is developing an Autonomous Re-Entry System (ARES) based on a
   controlled paraglider. The target is to use the ARES to autonomously
   recover a reusable sounding rocket in a specific area dedicated for
   landing. The system is mainly divided in two parts: the paraglider wing
   with a traditional configuration of a ram-air parachute and the control
   box which houses the main control electronics. Furthermore, the sounding
   rocket is attached to the control box and a ground station receives
   telemetry or sends telecommands for both the rocket and the control box.
   In order to test the system in-flight independently from the launch of a
   rocket, a fully functional Technology Demonstrator has been developed.
   It is built from Commercial-Off-The-Shelf items and components and from
   custom composite parts. The mass of the wing is about 200g for a surface
   of 1.1m(2) and the control box mass is 550g. The electronics
   communicates through telemetry and telecommands with a ground PC.
   Attitude and position sensors are used in the control loop and three
   modes of operation can be selected. The ARES has been already flight
   tested in direct control mode.},
