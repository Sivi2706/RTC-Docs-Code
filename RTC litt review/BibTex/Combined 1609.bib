Year = {2024},
Pages = {2441-2445},
Note = {2024 China Automation Congress, Qingdao, PEOPLES R CHINA, NOV 01-03,
   2024},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {This paper explores a method for accurately identifying the longitudinal
   characteristic parameters of a missile using an Extended Kalman Filter
   (EKF) in the missile guidance system, followed by the application of a
   pole placement algorithm to optimize the control system. Firstly, the
   EKF algorithm eliminates observation and system noise to provide
   high-precision estimation and filtering of the missile's longitudinal
   motion states (such as position, velocity, and acceleration), thereby
   accurately understanding the current state of the missile. Subsequently,
   the pole placement algorithm adjusts the controller parameters according
   to the desired system dynamic characteristics, optimizing system
   stability and dynamic performance. This method achieved a remarkable
   improvement in the missile guidance system's performance, achieving a
   relative identification error of less than 4\%, while ensuring the
   overload has a rapid rise time without overshoot.},
