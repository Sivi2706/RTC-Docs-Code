@article{ WOS:000076831700038,
Author = {Stassinopoulos, EG and Stauffer, CA and Brucker, GJ},
Title = {Miniature high-let radiation spectrometer for space and avionics
   applications},
Journal = {NUCLEAR INSTRUMENTS \& METHODS IN PHYSICS RESEARCH SECTION
   A-ACCELERATORS SPECTROMETERS DETECTORS AND ASSOCIATED EQUIPMENT},
Year = {1998},
Volume = {416},
Number = {2-3},
Pages = {531-535},
Month = {OCT 21},
Abstract = {This paper reports on the design and characterization of a small,
   low-power, and low-weight instrument, a High-LET Radiation Spectrometer
   (HiLRS), that measures energy deposited by heavy ions in microelectronic
   devices. The HiLRS operates on pulse-height analysis principles and is
   designed for space and avionics applications. The detector component in
   the instrument is based on large scale arrays of p-n junctions. In this
   system, the pulse amplitude from a particle hit is directly proportional
   to the particle LET. A prototype flight unit has been fabricated and
   calibrated using several heavy ions with varying LETs and protons with
   several energies. The unit has been delivered to the Ballistic Missile
   Defense Organization (BMDO) c/o the Air Force Research Laboratory in
   Albuquerque, NM, for integration into the military Space Technology
   Research Vehicle (STRV), a US-UK cooperative mission. Another version of
   HiLRS is being prepared for delivery in April to the Hubble Space
   Telescope (HST) project, to fly on the HST Orbital Systems Test (HOST)
   platform on a shuttle mission. (C) 1998 Elsevier Science B.V. All rights
   reserved.},
