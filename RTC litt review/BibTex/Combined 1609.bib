@inproceedings{ WOS:001008282003056,
Author = {O'Farrell, Clara and Leylek, Emily A. and Lobbia, Marcus A. and Siegel,
   Katherine J. Y.},
Book-Group-Author = {IEEE},
Title = {ASPIRE2: The Mars Sample Retrieval Lander's Supersonic Parachute Test
   Program},
Booktitle = {2023 IEEE AEROSPACE CONFERENCE},
