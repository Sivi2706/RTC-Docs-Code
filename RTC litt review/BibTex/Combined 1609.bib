@inproceedings{ WOS:000263681700011,
Author = {Maier, A. and Kiesel, S. and Trommer, G. F.},
Editor = {Trommer, GF},
Title = {Comparison of Different SAR/INS Integration Techniques},
Booktitle = {SYMPOSIUM GYRO TECHNOLOGY 2008},
Series = {SYMPOSIUM GYRO TECHNOLOGY},
Year = {2008},
Note = {Symposium Gyro Technology, Karlsruhe, GERMANY, SEP 16-17, 2008},
Organization = {Univ Karlsruhe, German Inst Navigat},
Abstract = {Integrated navigations systems are widely used in aircraft or missile
   systems to provide accurate navigation information containing position,
   velocity and attitude. These navigation systems rely on two or more
   sensors, which are combined in a navigation filter. An inertial
   navigation system provides accurate relative position updates along
   short periods of time. To ensure long term accurate and autonomous
   navigation information a synthetic aperture radar (SAR) system is
   introduced.
   The synthetic aperture sensor captures the earth's surface in range and
   cross range coordinates. The image is matched to a map which contains
   specific well visible and unambiguous features such as crossroads or
   courses of rivers. The position shift between the SAR image and the
   reference feature is used to aid the navigation information.
   It is shown, that is possible to provide three-dimensional update
   information from SAR measurements. The performances of extended Kalman
   filter and sigma-point Kalman filter SAR/INS navigation systems will be
   compared in numerical simulations. Additionally, simulation results of a
   combination of SAR/INS and standard terrain referenced navigation will
   be presented.},
