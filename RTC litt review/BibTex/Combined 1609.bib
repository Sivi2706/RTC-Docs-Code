Pages = {497-512},
Month = {APR},
Abstract = {We analyse the performance of the additive observable proportional
   navigation guidance system, which is well-suited for low-cost homing
   missiles with bearings-only measurements. Closed-form solutions are
   derived for both manoeuvring and non-manoeuvring targets. Guidelines on
   how to select the navigation constants of the control law:are resented.
   We show that the additive observable proportional navigation guidance
   system can cover a larger capture area than can a conventional
   proportional navigation system.},
