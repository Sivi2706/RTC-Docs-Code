@article{ WOS:001737626400001,
Author = {Zhang, Wenchao and Cao, Lei and Liu, Yuxin and Wei, Dongyan and Zhao,
   Hui and Yuan, Hong},
Title = {Robust Pedestrian Localization via Dual-IMU Magnetic Velocity Estimation
   With Spatial Constraints},
Journal = {IEEE TRANSACTIONS ON INDUSTRIAL ELECTRONICS},
Year = {2026},
Volume = {73},
Number = {9},
Pages = {13960-13971},
Month = {SEP},
Abstract = {The traditional gait model methods based on inertial navigation system
   (INS) for pedestrian location have drawbacks such as the insufficient
   robustness, the poor adaptability, and a lack of physical significance
   of coefficients. This article proposes an innovative approach that
   utilizes two 9-axis inertial measurement units (IMUs) mounted on the
   human body. The forward velocity is estimated using magnetic field data
   collected sequentially from front and rear magnetometers passing through
   the same location. Concurrently, lateral velocity is calculated using
   the inverted pendulum model (IPM) derived from the analysis of human
   motion. Based on the assumption of the rigidity of the human torso, the
   spatial constraint between the two IMUs is applied to mitigate
   positional drift. Subsequently, data from the IMUs, velocity
   observations, and spatial constraints are integrated within a Kalman
   filter framework. To reduce the influence of outliers in forward
   velocity estimation and enhance system stability, an innovation-based
   Kalman filter is implemented by constructing a normalized innovation
   vector, enabling real-time detection and rejection of anomalies in the
   forward velocity measurements. Experiments carried out in magnetically
   rich environments, including indoor offices and underground parking
   lots, demonstrate that the proposed method improves localization
   accuracy by at least 50\% compared to existing methods. The proposed
   method facilitates reliable and autonomous pedestrian localization in
   indoor settings, utilizing only 9-axis IMUs.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
Address = {445 HOES LANE, PISCATAWAY, NJ 08855-4141 USA},
Type = {Article},
Language = {English},
Affiliation = {Zhang, WC (Corresponding Author), Chinese Acad Sci, Aerosp Informat Res Inst, Beijing 100094, Peoples R China.
