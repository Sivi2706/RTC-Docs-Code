Book-Group-Author = {IEEE},
Title = {Comparison of Antenna for DTI Rocket Telemetry System},
Booktitle = {2016 SECOND ASIAN CONFERENCE ON DEFENCE TECHNOLOGY (ACDT)},
Year = {2016},
Pages = {105-110},
Note = {2nd Asian Conference on Defence Technology (ACDT), Chiang Mai, THAILAND,
   JAN 21-23, 2016},
Organization = {Defence Technol Assoc; IEEE; Defence Technol Inst; Thammasat Univ; ISTI;
   Minist Defence; Maejo Univ; NSTDA},
Abstract = {This paper focuses on design, implementation and test of antennas for
   transmitting telemetry data from a DTI's mm rocket. It is a ballistic
   rocket which rolls about its longitudinal axis during the flight, making
   it challenging to design a suitable antenna. Three types of antenna are
   studied, namely monopole, patch, and wraparound antennas. They are
   designed, realized, verified, and compared based on their return losses
   and radiation patterns. An analysis is made on the effect of antenna
   design and rocket structure towards the radiation pattern. Finally,
   suitability of each antenna for using on the rocket is discussed.},
