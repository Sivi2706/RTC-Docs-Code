Note = {IEEE Space, Aerospace and Defence Conference (SPACE), Bangalore, INDIA,
   JUL 22-23, 2024},
Organization = {IEEE},
Abstract = {The Launch vehicle avionics rely on batteries for flight power, but for
   ground testing, batteries are impractical. Power supplies simulate
   batteries for each avionic subsystem, requiring complex ground systems
   and interfaces. During launch countdown, power must seamlessly
   transition from external to internal sources. This paper proposes an
   advanced, reliable power distribution system using a unified bus,
   minimizing interconnects, enhancing redundancy, and reducing mass. It
   discusses system configuration, design constraints, and fault protection
   techniques to ensure reliability during critical phases.},
