@article{ WOS:A1992KJ45900004,
Author = {HYSLOP, GL and SCHATTLER, H and TARN, TJ},
Title = {DESCENT ALGORITHMS FOR OPTIMAL PERIODIC OUTPUT-FEEDBACK CONTROL},
Journal = {IEEE TRANSACTIONS ON AUTOMATIC CONTROL},
Year = {1992},
Volume = {37},
Number = {12},
Pages = {1893-1904},
Month = {DEC},
Abstract = {Periodic output feedback is investigated in the context of linear
   quadratic regulation for finite dimensional, time-invariant linear
   systems. In this method, discrete output samples are multiplied by a
   periodic gain function to generate a continuous feedback control. The
   optimal solution is obtained in two steps by separating the continuous
   time from the discrete-time structure. First, the optimal pole placement
   problem under periodic output feedback is solved explicitly under the
   assumption that the behavior at the sample times has been specified in
   terms of a gain matrix G. Then the minimum value, which depends on G, is
   substituted into the overall objective. This results in a
   finite-dimensional optimization problem over all admissible gain
   matrices G. The solution of this minimization problem defines the
   optimal periodic output feedback control via the formulas of the optimal
   pole placement problem. Hence, the optimal control problem under
   periodic output feedback has been reduced to a finite dimensional,
   nonlinear programming problem. For this problem here, steepest descent
   and a direct iterative method are formulated and compared. Numerical
   examples are presented for the harmonic oscillator and a missile
   longitudinal flight control system perturbed by noise. They show that
   the performance using periodic output feedback can almost be equivalent
   to the performance using optimal continuous state feedback.},
