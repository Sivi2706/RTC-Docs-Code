@inproceedings{ WOS:000088917700001,
Author = {Ruffin, PB},
Editor = {Varadan, VK},
Title = {Progress in the development of gyroscopes for use in tactical weapon
   systems},
Booktitle = {SMART STRUCTURES AND MATERIALS 2000: SMART ELECTRONICS AND MEMS},
Series = {PROCEEDINGS OF THE SOCIETY OF PHOTO-OPTICAL INSTRUMENTATION ENGINEERS
   (SPIE)},
Year = {2000},
Volume = {3990},
