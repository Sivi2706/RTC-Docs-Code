@inproceedings{ WOS:000243873602029,
Author = {Wu Tianbao and Huang Xianlin and Li Haijun and Hu Haidong},
Book-Group-Author = {IEEE},
Title = {Design of an online error compensator by the approach of nonlinear
   dynamic inverse},
Booktitle = {2006 CHINESE CONTROL CONFERENCE, VOLS 1-5},
Year = {2006},
Pages = {1056+},
Note = {25th Chinese Control Conference, Harbin, PEOPLES R CHINA, AUG 07-10,
   2006},
Abstract = {In this paper, it is discussed how to design an online error compensator
   for a fight control system by the method of nonlinear dynamic inverse.
   By the theory of nonlinear dynamic inverse, a pseudo-linear system can
   be attained from the original nonlinear system by means of
   linearization-via-feedback and dynamic redeem. Next, the controller can
   be designed by using linear theories. In this paper, firstly, we deeply
   analyze the principle of the dynamic inverse control and the cause of
   the inverse error. Secondly, we review the principle of the
   self-adaptive inverse control and methods of eliminating the sensor
   noise and disturbance. Finally, we present the method which not only has
   compensation messages but also can be used in the online dynamic inverse
   error compensation. Our method is applied to the flight control system
   design of the cruise missile. Simulations show that the designed system
   is robust and has a satisfactory dynamical performance.},
