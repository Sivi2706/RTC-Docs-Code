@inproceedings{ WOS:000077255200018,
Author = {Wheeler, C and Morris, J},
Book-Group-Author = {SAFE
   SAFE},
Title = {Evolution of ejection seat pintle technology},
Booktitle = {THIRTY-SIXTH ANNUAL SYMPOSIUM SAFE ASSOCIATION, PROCEEDINGS},
Year = {1998},
Pages = {142-149},
Note = {36th Annual SAFE Symposium, PHOENIX, AZ, SEP 14-16, 1998},
Organization = {SAFE Assoc},
Abstract = {Since the first pintle technology program began in September 1991,
   pintle system design for ejection seats has evolved into smaller, more
   compact packages. In the Controlled Thrust for Aircrew Escape Systems
   (CTAES) Program, the pintle rocket motor was designed as a relatively
   low risk, reusable heavyweight system to demonstrate the on-command
   controllable thrust capabilities while satisfying thrust and total
   impulse requirements defined for an advanced seat.
   The 4th Generation Escape System Technologies Demonstration Program (4th
   Gen), which began in January 1993, required a re-usable system for
   demonstration and sled testing. The system had to mount on an existing
   AGES II seat, chosen as the demonstration testbed by prime contractor
   Boeing (formerly McDonnell Douglas Aerospace), and withstand the g-loads
   and shocks associated with sled testing. In order to meet the motor and
   flight control system requirements, critical actuator performance i.e.,
   slew rates and frequency response, were doubled compared to CTAES.
   Since a 4th Gen type system was difficult to integrate on existing
   aircraft ejection seats, the Multi-Axis Pintle Attitude Control (MAXPAC)
   concept for retrofitting and upgrading seats like the AGES II was
   conceived. MAXPAC was designed to replace existing underseat rocket
   motors where size, weight, and cost were the driving design parameters.
   As part of this, fail-safe technology was instituted using springs to
   force balance the pintle. A higher operational pressure was used to
   reduce pintle and thruster size.
   A comparison of CTAES, 4(th) Gen, and MAXPAC clearly shows a trend
   toward reduced size, weight, and cost while continuing to offer unique
   escape system performance capability.},
