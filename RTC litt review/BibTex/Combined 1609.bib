@inproceedings{ WOS:000459239500155,
Author = {Sun, Jingliang and Liu, Chunsheng and Dai, Jiao},
Book-Group-Author = {IEEE},
Title = {Robust optimal control for missile-target guidance systems via adaptive
   dynamic programming},
Booktitle = {2018 CHINESE AUTOMATION CONGRESS (CAC)},
Series = {Chinese Automation Congress},
Year = {2018},
Pages = {836-841},
Note = {Chinese Automation Congress (CAC), Xian, PEOPLES R CHINA, NOV 30-DEC 02,
   2018},
Organization = {CAA; IEEE; IEEE Syst Man \& Cybernet Soc},
Abstract = {In this paper, the problem of intercepting a maneuvering target is posed
   in an optimal control problem for nonlinear systems with mismatched
   uncertainties. By incorporating the uncertain term into the cost
   function, the robust optimal control problem is transformed into an
   equivalent optimal regulation control problem for nominal system. A
   feedback form solution is derived using adaptive dynamic programming
   (ADP) technique by constructing a critic network with a novel weight
   adaptation law. Moreover, a robust term is added to guarantee the
   closed-loop system is asymptotically stable. Finally, simulations
   results demonstrate the effectiveness of proposed robust optimal control
   method for intercepting a maneuvering target.},
