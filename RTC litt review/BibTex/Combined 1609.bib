@article{ WOS:001363481800001,
Author = {Ferro, Carlo and Cafaro, Matteo and Maggiore, Paolo},
Title = {Optimizing Solid Rocket Missile Trajectories: A Hybrid Approach Using an
   Evolutionary Algorithm and Machine Learning},
Journal = {AEROSPACE},
Year = {2024},
