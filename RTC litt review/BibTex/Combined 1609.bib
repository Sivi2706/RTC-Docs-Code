Booktitle = {SEVENTH INTERNATIONAL SYMPOSIUM ON INSTRUMENTATION AND CONTROL
   TECHNOLOGY: OPTOELECTRONIC TECHNOLOGY AND INSTUMENTS, CONTROL THEORY AND
   AUTOMATION, AND SPACE EXPLORATION},
