@article{ WOS:000463305200021,
Author = {Zhao, Zhenhua and Li, Chuntao and Yang, Jun and Li, Shihua},
Title = {Output feedback continuous terminal sliding mode guidance law for
   missile-target interception with autopilot dynamics},
Journal = {AEROSPACE SCIENCE AND TECHNOLOGY},
Year = {2019},
Volume = {86},
Pages = {256-267},
Month = {MAR},
Abstract = {This paper proposes an output feedback continuous terminal sliding mode
   guidance law (CTSMGL) for three-dimensional missile-target interception
   with consideration of second-order autopilot dynamics. The proposed
   output feedback CTSMGL not only guarantees the rates of the
   line-of-sight angles converge to zero in finite time but also ensures
   the continuity of control action. Besides, only the relative range and
   velocity information of guidance system has been utilized in its design
   process. Simulations of a practical interception process under three
   types of maneuvering targets are carried out and the simulation results
   illustrate the effectiveness of the proposed guidance method. (C) 2019
   Elsevier Masson SAS. All rights reserved.},
