@inproceedings{ WOS:000280804302201,
Author = {Dong Yu-hua and Xiao Ying and Xu Shuang},
Editor = {Qiu, PH and Yiu, C and Zhang, H and Wen, XB},
Title = {Research on Telemetry Vibration Signal Processing by Hilbert-Huang
   Transform},
Booktitle = {PROCEEDINGS OF THE 2009 2ND INTERNATIONAL CONGRESS ON IMAGE AND SIGNAL
   PROCESSING, VOLS 1-9},
Year = {2009},
Pages = {4259-4262},
Note = {2nd International Congress on Image and Signal Processing, Tianjin,
   PEOPLES R CHINA, OCT 17-19, 2009},
Organization = {Tianjin Univ Technol; IEEE Engn Med \& Biol Soc (EMBS)},
Abstract = {The vibration signal of telemetry in missile weapon test has non-linear
   and non-stationary on the feature segments, so the method of the data
   processing by Hilbert-Huang transform (HHT) combined with wavelet
   de-noising is proposed in this paper. At first, zero drift and trend
   terms must be removed from the signal. Secondly, the intrinsic mode
   functions (IMF) can be got by empirical mode decomposition (EMD) and
   wavelet de-noising for each IMF. At last, the time-frequency spectrum is
   obtained by hilbert transform. The results of the data processing tests
   following the above flow show that the time-frequency spectrum has
   higher time-frequency resolution.},
Publisher = {IEEE},
Address = {345 E 47TH ST, NEW YORK, NY 10017 USA},
