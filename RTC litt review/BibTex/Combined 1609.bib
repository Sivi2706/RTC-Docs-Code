Year = {2009},
Pages = {480-483},
Note = {International Conference on Information Technology and Computer Science,
   Kiev, UKRAINE, JUL 25-26, 2009},
Abstract = {Inertial Measurement Unit (IMU) is the core part of missile guidance
   system. Its performance can affect the hit-point deviation directly. In
   order to achieve a good striking effect, we should estimate IMU
   performance to choose the IMUs with high quality to complete certain
   task. But for the purpose of saving resource and using every set of IMU
   adequately, estimation methods in different trajectories are brought
   forward under the background of strapdown inertial measurement unit
   (SIMU). So the research takes hit accuracy as final estimation
   criterion, uses trajectory characteristics and aim characteristics as
   the methods to choose different SIMUs for different trajectories. The
   experiment testifies applying the methods can achieve the goal of
   choosing SIMUs in the certain condition, and it can instruct SIMU usage
   in practice.},
