@inproceedings{ WOS:000086712200105,
Author = {Turner, A and Rodden, J and Tse, M},
Book-Group-Author = {AIAA
   AIAA},
Title = {GPS spacecraft navigation for orbit determination and satellite
   constellation control},
Booktitle = {COLLECTION OF THE 18TH AIAA INTERNATIONAL COMMUNICATIONS SATELLITE
   SYSTEMS CONFERENCE AND EXHIBIT, TECHNICAL PAPERS, VOLS 1 AND 2},
Year = {2000},
Pages = {863-880},
Note = {18th AIAA International Communications Satellite Systems Conference and
   Exhibit, OAKLAND, CA, APR 10-14, 2000},
Organization = {Amer Inst Aeronaut \& Astronaut; IEEE},
Abstract = {The use of Global Position System (GPS) receivers for on-board
   spacecraft navigation vastly improves the timeliness of orbit
   determination (OD) immediately following spacecraft separation from the
   launch vehicle (LV) and preceding, following, and even during orbit
   raising maneuvers versus conventional methods based upon ground
   measurement of spacecraft position. This application resolves many new
   problems posed by the use of large constellations of spacecraft, as
   opposed to earlier programs where only a few spacecraft are involved.
   These new problems have driven the development of new technology, which
   has involved the production of the GPS Tensor(R) at Space Systems/Loral.
   This paper describes the use of GPS navigation for Globalstar(TM)
   constellation mission operations from current night experience.
   Individual state vectors obtained from a single telemetry master frame
   from the GPS Tensor(R) receiver have been used to perform OD in near
   real time and obtain an initial ``first cut{''} of the spacecraft orbit
   following the conclusion of a maneuver or an LV separation event, as
   will be discussed.},
