@inproceedings{ WOS:001466551900145,
Author = {de Celis, Raul and Cadarso, Luis},
Book-Group-Author = {IEEE},
Title = {DEVELOPMENT OF A NEURAL NETWORK-BASED CONTROLLER FOR SHORT-RANGE ROCKETS},
Booktitle = {2021 WINTER SIMULATION CONFERENCE, WSC},
Series = {Winter Simulation Conference Proceedings},
Year = {2021},
Note = {2021 Winter Simulation Conference-WSC, Phoenix, AZ, DEC 12-15, 2021},
Abstract = {Improving accuracy is a critical component of rocket-based defense
   systems. Accuracy may become independent of range when using inertial
   navigation systems. This is especially true for short-range man-portable
   air-defense systems, which are usually composed of portable missiles,
   whose movement is governed by non-linear and rapidly changing forces and
   moments. Effective guidance strategies for these systems could improve
   the weapon's precision. This research introduces a new non-linear neural
   network-based controller to improve navigation and control systems by
   lowering the circle error probable, which is a measure of accuracy.
   Nonlinear simulations based on actual flight dynamics are used to train
   the neural networks. The simulation results show that the presented
   approach performs well in a 6-DOF simulation environment, featuring high
   accuracy and robustness against parameter uncertainty.},
