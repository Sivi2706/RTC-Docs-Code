@article{ WOS:000773643100006,
Author = {Zhang, Xiaoyu and Dong, Fei and Zhang, Peng},
Title = {A new three-dimensional fixed time sliding mode guidance with terminal
   angle constraints},
Journal = {AEROSPACE SCIENCE AND TECHNOLOGY},
Year = {2022},
Volume = {121},
Month = {FEB},
Abstract = {In this paper, a continuous fixed-time guidance law with terminal angle
   constraints considering coupled dynamics is proposed for intercepting
   maneuvering targets in three-dimensional space. First, a fast fixed-time
   nonsingular sliding manifold is designed to guarantee the line-of-sight
   angle tracking errors and angular rates to zero in a fixed time. Next, a
   novel sliding mode reaching law is proposed to weaken the chattering
   phenomenon and guarantee guidance system states converge to sliding mode
   manifold in a fixed time. Finally, numerical simulations are conducted
   to validate the effectiveness and superiority of the proposed guidance
   law. (c) 2022 Elsevier Masson SAS. All rights reserved.},
