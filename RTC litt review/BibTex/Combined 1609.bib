@article{ WOS:000317442600014,
Author = {Sun, Sheng and Zhou, Di and Hou, Wen-tao},
Title = {A guidance law with finite time convergence accounting for autopilot lag},
Journal = {AEROSPACE SCIENCE AND TECHNOLOGY},
Year = {2013},
Volume = {25},
Number = {1},
Pages = {132-137},
Month = {MAR},
Abstract = {By considering the dynamics of a missile's autopilot as a first-order
   lag, a guidance law with finite time convergence is designed based on
   target-missile relative motion equations. It is rigorously proved that
   states of the guidance system converge to a sliding-mode in finite time
   and the line-of-sight (LOS) angular rate converges to zero in finite
   time under the proposed guidance law. Simulation results show that the
   guidance law is robust against target maneuvers and is able to
   compensate for the autopilot lag. (C) 2012 Elsevier Masson SAS. All
   rights reserved.},
