@inproceedings{ WOS:A1997BJ31H00027,
Author = {Giza, RH and Acevedo, PA and Bliss, JD},
Editor = {Murrer, RL},
Title = {Ultraviolet scene simulation for missile approach warning system testing},
Booktitle = {TECHNOLOGIES FOR SYNTHETIC ENVIRONMENTS: HARDWARE-IN-THE-LOOP TESTING II},
Series = {PROCEEDINGS OF THE SOCIETY OF PHOTO-OPTICAL INSTRUMENTATION ENGINEERS
   (SPIE)},
Year = {1997},
Volume = {3084},
