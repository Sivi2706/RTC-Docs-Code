Pages = {253-260},
Note = {4th International Conference on Bond Graph Modeling and Simulation
   (ICBGM 99), SAN FRANCISCO, CA, JAN 17-20, 1999},
Organization = {Soc Comp Simulat Int},
Abstract = {This paper presents a generalized bond graph and explicit state-space
   model of linearized pitch-plane missile dynamics suitable for flight
   control system design and analysis. The bond graph encapsulates the
   physical and computational relationships between rigid body and
   aeroelastic dynamic phenomena. The missile is treated as a free-free
   beam with aerodynamic forcing at the cg and force/moment loading at the
   control surface hingeline. Aerodynamic forces and moments are
   implemented in the bond graph as modulated effort sources. Submodels of
   rigid body, control surface, and flexible body dynamics are derived
   separately and then connected together to form the final system
   description. Power continuity is preserved at the rigid body connections
   using explicit inertial field constructs. The multibody nature of this
   problem leads to a set of implicit differential algebraic equations that
   can be reduced to explicit state-space form using a transformation of
   variables.},
