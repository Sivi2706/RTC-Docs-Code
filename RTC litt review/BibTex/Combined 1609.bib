@article{ WOS:000436774300007,
Author = {Zheng, Yongbin and Chen, Huimin and Zhou, Zongtan},
Title = {Angle Measurement of Objects outside the Linear Field of View of a
   Strapdown Semi-Active Laser Seeker},
Journal = {SENSORS},
Year = {2018},
Volume = {18},
Number = {6},
Month = {JUN},
Abstract = {The accurate angle measurement of objects outside the linear field of
   view (FOV) is a challenging task for a strapdown semi-active laser
   seeker and is not yet well resolved. Considering the fact that the
   strapdown semi-active laser seeker is equipped with GPS and an inertial
   navigation system (INS) on a missile, in this work, we present an angle
   measurement method based on the fusion of the seeker's data and GPS and
   INS data for a strapdown semi-active laser seeker. When an object is in
   the nonlinear FOV or outside the FOV, by solving the problems of space
   consistency and time consistency, the pitch angle and yaw angle of the
   object can be calculated via the fusion of the last valid angles
   measured by the seeker and the corresponding GPS and INS data. The
   numerical simulation results demonstrate the correctness and
   effectiveness of the proposed method.},
