@article{ WOS:001853494700001,
Author = {Feng, Jingheng and Lang, Xiaoyu and Dong, Ning and Chen, Zhen and Liu,
   Xiangdong},
Title = {Matrix-gain-scheduling-based robust adaptive output feedback control for
   acceleration tracking of reusable launch vehicle},
Journal = {AEROSPACE SCIENCE AND TECHNOLOGY},
Year = {2026},
Volume = {179},
Number = {3},
Month = {DEC},
Abstract = {The strong channel coupling, control effectiveness degradation, and
   structural parameter perturbations pose severe challenges to flight
   control system design of reusable launch vehicles(RLV). Adaptive control
   is recognized as an effective approach to handle such uncertainties, yet
   conventional adaptive controllers often require full-state measurements
   and struggle with slow convergence and inter-channel coupling in RLV's
   flights. To address these issues, this paper proposes a
   matrix-gain-scheduling-based robust adaptive output feedback control
   scheme for RLV's acceleration tracking. The proposed output feedback
   controller only requires the accelerations and angular rates available
   from a standard low-cost IMU, without direct measurements of the angle
   of attack or the sideslip angle. The gain-scheduled controller, with
   bounded and strongly active full-rank scheduling matrices, inherits the
   very strictly passive(VSP) property of subcontrollers and offers
   superior design flexibility compared to scalar-scheduling. This
   theoretical result generalizes the VSP-preserving gain-scheduling
   framework from scalar-scheduling to matrix-scheduling, thereby providing
   a passivity-based foundation for applying channel-dependent and
   cross-channel scheduling weights to coupled RLV acceleration tracking
   control. Numerical simulations validate that the proposed controller
   maintains stable and precise acceleration command tracking even with
   large parameter deviations from nominal values, providing a promising
   solution for high-performance acceleration tracking of RLV.},
Publisher = {ELSEVIER FRANCE-EDITIONS SCIENTIFIQUES MEDICALES ELSEVIER},
Address = {65 RUE CAMILLE DESMOULINS, CS50083, 92442 ISSY-LES-MOULINEAUX, FRANCE},
