@inproceedings{ WOS:000337527200061,
Author = {Zhou, Qiang and Xiang, Qiao and Liu, Yabin},
Editor = {Yu, S},
Title = {Study on the Design and Modeling of a BMK Remote Telemetry Data
   Acquisition Card},
Booktitle = {INTERNATIONAL CONFERENCE ON ELECTRICAL, CONTROL AND AUTOMATION (ICECA
   2014)},
Year = {2014},
Pages = {438-446},
Note = {International Conference on Electrical, Control and Automation (ICECA),
   Shanghai, PEOPLES R CHINA, FEB 22-23, 2014},
Abstract = {BMK remote telemetry data bus is a typical Time Division Multiplexing
   (TDM) unidirectional data bus, which has been widely used in flight
   control systems of air-to-air missiles. In research and test in
   production line, the flow of almost all test items have connection with
   BMK remote telemetry data. To meet this requirement, a BMK remote
   telemetry data acquisition card based on CPCI bus is developed. In this
   design, a Petri Net Model is established and analyzed. The theoretical
   analysis shows that the Petri Net Model of this card is bounded, live,
   reachable, deadlock-free, and conflict-free. The analysis also
   demonstrated that this card is able to work steadily and continuously.
   Self-tests and experiments also prove that this design is reasonable and
   this card can realize acquisition, decoding and storage of BMK remote
   telemetry data continuously without frame loss.},
