@article{ WOS:000296824900012,
Author = {Hinks, Joanna C. and Psiaki, Mark L.},
Title = {Solution Strategies for an Extension of Wahba's Problem to a Spinning
   Spacecraft},
Journal = {JOURNAL OF GUIDANCE CONTROL AND DYNAMICS},
Year = {2011},
Volume = {34},
Number = {6},
Pages = {1734-1745},
Month = {NOV-DEC},
Note = {AIAA Guidance, Navigation and Control Conference and Exhibit, Honolulu,
   HI, AUG 18-21, 2008},
Organization = {Amer Inst Aeronaut \& Astronaut (AIAA)},
Abstract = {Several methods have been devised to estimate the optimal attitude
   quaternion and angular velocity for an axially symmetric spacecraft
   given only a time series of vector attitude measurements and a
   rigid-body model of the spacecraft dynamics. These methods solve a
   generalization of the Wahba problem that is applicable to a
   low-complexity spinning spacecraft such as a sounding rocket. They have
   the advantages of enabling rate estimation without gyros and avoiding
   the divergence issues of an extended Kalman filter. Measurements at
   different times are combined via the closed-form quaternion state
   transition matrix that makes use of Euler equations for a rigid body.
   The problem takes the form of six or more nonlinear equations in six or
   seven unknowns, and these equations can be partially solved
   analytically-to facilitate a numerical solution of the remainder.
   Representative simulation results illustrate both the merits of these
   solution strategies and some of the practical issues that arise during
   implementation.},
