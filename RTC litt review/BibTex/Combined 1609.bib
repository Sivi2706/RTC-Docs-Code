@article{ WOS:000075627800005,
Author = {Es-Said, OS and Foyos, J and Smith, ML and Hernandez, I and Cuevas, L
   and Dizon, J and Heng, V},
Title = {The effect of 45° rolling process on the mechanical properties of P/M
   rhenium},
Journal = {MATERIALS AND MANUFACTURING PROCESSES},
Year = {1998},
Volume = {13},
Number = {5},
Pages = {693-717},
Abstract = {A novel processing technique which utilizes the 45 degrees rolling mode
   is introduced. An optimum processing method of light rolling (10-12\%
   reduction in thickness) along the 45 degrees direction, followed by
   intermittent annealing (1650 degrees C / 30 min. in H-2 atmosphere) was
   carried out. The partial reduction and intermittent annealing were
   repeated until an 82.9\% reduction was achieved with a tensile strength
   of 2388 MPa (346.6 Ksi) and 3.3\% elongation. Additional experiments
   were performed to test the feasibility of increasing the percentage of
   reduction in thickness in cold rolling from the conventional 10-15\% to
   20-55\% along the 45 degrees direction. Although extensive microcracking
   occurred, intermediate strengths were achieved and ductility was
   retained. This processing technique has the potential of producing ultra
   high strength, very thin sheets, which are vital for space nuclear power
   applications and missile guidance systems.},
