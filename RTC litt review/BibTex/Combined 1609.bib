Organization = {NE Univ; Chinese Assoc Automat, Tech Comm Control \& Decis Cyber Phys
   Syst; IEEE Control Syst Soc; Chinese Assoc Artificial Intelligence;
   Chinese Assoc Automat, Tech CommControl Theory; NE Univ, State Key Lab
   Synthet Automat Proc Ind},
Abstract = {This paper proposes a guidance algorithm based on strap-down devices to
   obtain more accurate guidance information for small missile system. This
   paper establishes a mathematic model of inertial devices to get the
   navigation information of the SINS. Then the calculation results of the
   navigation system are used to establish the mathematical model of the
   inertial line-of-sight angular velocity of the strap-down seeker. So,
   the extraction of guidance infomiation can he realized. In order to
   reduce the influence of system noise, this paper designs extended Kalman
   filter and unscented Kalman filter to filter the guidance information
   separately and compares these two filter results with the data from the
   track generator. The simulation results show that the guidance algorithm
   is effective and can obtain the guidance information to meet the
   requirements.},
