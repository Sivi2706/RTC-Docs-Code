@inproceedings{ WOS:000321793000017,
Author = {Rao, Sudhakara K.},
Editor = {Springer, AM},
Title = {Development of Control and Guidance System for SLV-3, India's First
   Satellite Launch Vehicle-Some Reflections},
Booktitle = {HISTORY OF ROCKETRY AND ASTRONAUTICS},
Series = {AAS History Series},
Year = {2012},
Volume = {38},
Pages = {303-320},
Note = {41st Histgory Symposium of the International-Academy-of-Astronautics
   (IAA), Hyderabad, INDIA, SEP 24-28, 2007},
Organization = {Int Acad Astronaut},
Abstract = {SLV-3, India's first satellite launch vehicle was developed in the 1970s
   and was launched successfully in 1980. It had four solid stages. The
   first three stages were 3-axis stabilized and the fourth stage was spin
   stabilized. SLV-3 used an open loop guidance system with a vehicle
   attitude programmer (VAP) providing preprogrammed pitch attitude
   commands from lift-off to third stage separation. A platform based
   inertial measurement unit (IMU) was used for attitude reference. An
   analog autopilot was used for processing the attitude data and rate gyro
   outputs and generating commands to control power plants of the first
   three stages for controlling the vehicle in all three axes. Development
   of such a control and guidance system was challenging especially when
   there was no previous experience or any other input from external
   sources. This chapter describes personal reflections of the author who
   was closely associated with the development of many of these critical
   subsystems at Vila-am Sarabhai Space Centre, Trivandrum, about the
   technology challenges during development and testing of such a system.
   The chapter presents developmental efforts and strategy for C\&G system.
   Also highlighted are a few details about control systems design, 6-D
   simulations, real time simulations using the hybrid computer and finally
   the hardware-in-loop simulation for end-to-end checks of the control and
   guidance system. The chapter concludes with the acknowledgement to many
   individuals who were associated with the development.},
