   Balch, Michael; Tandy, Dave, Adv Opt Syst Inc, 6767 Old Madison Pike,Suite 410, Huntsville, AL 35806 USA.},
DOI = {10.1117/12.720302},
Article-Number = {65550F},
ISSN = {0277-786X},
