Title = {Adaptive Integral Sliding Mode Guidance Law with Impact Angle Constraint
   Considering Autopilot Lag},
Booktitle = {2019 3RD INTERNATIONAL CONFERENCE ON ARTIFICIAL INTELLIGENCE, AUTOMATION
   AND CONTROL TECHNOLOGIES (AIACT 2019)},
Series = {Journal of Physics Conference Series},
Year = {2019},
Volume = {1267},
Note = {3rd International Conference on Artificial Intelligence, Automation and
   Control Technologies (AIACT), Xian, PEOPLES R CHINA, APR 25-27, 2019},
Organization = {Xidian Univ; Hong Kong Soc Mech Engineers; York Univ; Fudan Univ},
Abstract = {For the interception problem of maneuvering targets, considering impact
   angle constraint and first-order autopilot lag, an adaptive integral
   sliding mode guidance law is designed. A new nonsingular finite-time
   integral sliding mode surface is constructed, which consists of LOS
   angle, LOS angular rate and LOS angular acceleration, and ensures that
   the states of the guidance system converge to zero on the sliding mode
   surface in a finite time. Moreover, an adaptive law is designed to
   estimate the upper bound of the target's unknown acceleration. The
   Lyapunov stability theory proves that the guidance system can converge
   to zero strictly in a finite time with the proposed guidance law.
   Finally, the simulation results verify the effectiveness of the designed
   guidance law.},
