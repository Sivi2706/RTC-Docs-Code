@article{ WOS:000171195100014,
Author = {Steinberg, RA and Kester, RW and Klein, LE and Belle, JS and Patterson,
   RA},
Title = {SM-2 Block IVA image-based 6-DOF simulation incorporating IR seeker
   flight code and online image rendering},
Journal = {JOHNS HOPKINS APL TECHNICAL DIGEST},
Year = {2001},
Volume = {22},
Number = {3},
Pages = {333-346},
Month = {JUL-SEP},
Abstract = {Enabling a missile defense capability in Standard Missile-2 (SM-2) Block
   IVA has entailed, among other changes, incorporating an imaging infrared
   (IR) seeker into the missile's guidance system. A signal-to-noise (SNR)
   model was the first IR model implemented in the APL SM-2
   six-degree-of-freedom (6-DOF) simulation, enabling statistical
   performance assessments under a wide range of engagement conditions.
   However, many applications demand a higher level of fidelity than is
   obtainable with an SNR model. To serve this need, an image-based
   simulation incorporating components of the IR seeker flight code and
   online target image rendering has been fully integrated with the 6-DOF
   simulation. This article presents a survey of some of the development,
   validation, and application activities conducted in connection with the
   new image-based 6-DOF simulation.},
