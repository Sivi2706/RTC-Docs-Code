@article{ WOS:001849164400001,
Author = {Han, Wenting and Cheng, Long and Han, Wenjing and Liu, Bingqin and Yu,
   Moyao and Wang, Yingwei},
Title = {Anomaly detection in IMU based on quantile regression-temporal pattern
   attention-transformer and covariance matrix adaptation evolution
   strategy},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2027},
Volume = {333},
Number = {B},
Month = {JAN 1},
Abstract = {The inertial navigation system supplies accurate position, attitude, and
   velocity for the rocket, serving as the key for precise guidance and
   stable flight. Anomaly detection of inertial measurement unit plays an
   important role in improving the reliability of inertial navigation
   system. Traditional threshold-based methods often suffer from high false
   alarm rates and struggle to detect gradual anomaly. To address these
   challenges, this paper proposes a regression-based anomaly detection
   method for inertial measurement unit using quantile regression-temporal
   pattern attention-Transformer and covariance matrix adaptation evolution
   strategy. First, to overcome the lack of abnormal samples, the
   Transformer model is improved by combining temporal pattern attention
   and quantile regression method. The normal output envelope is obtained
   by quantile regression-temporal pattern attention-Transformer interval
   prediction model using only normal samples. The envelope can be
   adaptively adjusted based on the fluctuations of the output signal,
   reducing the impact of local interference in the signal on the
   effectiveness of anomaly detection. Then, for the problem of determining
   the anomaly detection threshold, covariance matrix adaptation evolution
   strategy is used to optimize the extreme values of multidimensional
   features in the envelope. The extreme values are used as the abnormal
   thresholds to distinguish normal and abnormal samples. The experimental
   results show that the proposed method has an anomaly detection rate of
   99.34\% for multiple anomalies, which verifies the practicability and
   feasibility.},
