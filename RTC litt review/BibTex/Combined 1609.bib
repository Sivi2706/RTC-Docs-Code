Title = {Robust H∞ Performance Analysis Framework for a Missile
   Terminal Guidance System},
Booktitle = {PROCEEDINGS OF THE 27TH CHINESE CONTROL CONFERENCE, VOL 3},
Year = {2008},
Pages = {728-732},
Note = {27th Chinese Control Conference, Kunming, PEOPLES R CHINA, JUL 16-18,
   2008},
Organization = {Chinese Assoc Automat, Tech Comm Control Theory; Kunming Univ Sci \&
   Technol; Yunnan Div, Chinese Assoc Automat; IEEE Control Syst Soc; Soc
   Instrument \& Control Engineers; Inst Control Robot \& Syst Korea; IEEE
   Control Syst Soc, Singapore Chapter; CAS, Inst Syst Sci, Acad Math \&
   Syst Sci; Yunnan Normal Univ; CAI Div, Hong Kong Inst Engineers},
Abstract = {In this paper, robust H-infinity-like performance of a missile terminal
   guidance system that incorporates non-zero initial conditions and
   terminal constraints is analyzed over a finite horizon. This is done by
   defining a worst-case performance measure. Necessary and sufficient
   conditions, which guarantee that the above mentioned perfonnance measure
   is less than a prespecified value, are given in terms of solvability of
   differential linear matrix inequalities (DLMI). Finally, based on the
   new H-infinity metric, many uncertainties such as target maneuvers,
   heading error, and parameter variations in the missile terminal guidance
   are fully considered. Therefore, a more accurate performance prediction
   is obtained in contrast to covariance analysis.},
