@article{ WOS:001790976000001,
Author = {Saju, S. and Vengadeswaran, S.},
Title = {Hybrid deep learning strategies for robust launch vehicle data analysis
   and anomaly detection},
Journal = {INNOVATIONS IN SYSTEMS AND SOFTWARE ENGINEERING},
Year = {2026},
Volume = {22},
Number = {1},
Month = {JUN 11},
Abstract = {The avionics system of the launch vehicle performs navigation, guidance,
   control, sequencing, telemetry, tracking, and telecommand functions
   required during the entire flight duration. These systems are
   distributed across different stages of the launch vehicle and undergo
   rigorous testing to demonstrate the predicted reliability goals.
   Analyzing test data is presently a time-consuming offline process
   carried out by system design agencies. The data contain more than 1500
   parameters of on-board telemetry and almost 2000 parameters of the
   checkout system. These data are characterized by multifaceted spatial
   and temporal relationships that encapsulate dynamic system interactions
   and state transitions. Since these parameters are event-driven and
   non-stationary, anomaly detection becomes substantially difficult. These
   issues were addressed by comparing the anomaly detection capabilities of
   various modern deep learning approaches in launch vehicle test data.
   This study made it clear that increasing accuracy is necessary to
   facilitate a robust data analysis system. To improve anomaly
   identification and system validation, an integrated hybrid deep-learning
   framework that incorporates Convolutional Neural Network (CNN), Long
   Short-Term Memory (LSTM), and Gated Recurrent Unit (GRU) deep learning
   methods has been realized. The preprocessing methods were also enhanced
   to minimize compute overhead and maximize feature extraction. The goal
   of this framework is to reduce the number of false negatives and, as a
   result, avoid missing important faults. This study demonstrates that the
   hybrid deep learning approach reduces clearance time and improves the
   speed and accuracy of avionics system validation while maintaining
   strict safety and reliability requirements. Automating and improving
   anomaly detection accuracy resulted in faster decision-making, minimal
   manual involvement, and more consistent launch preparations.},
