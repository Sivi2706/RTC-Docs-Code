@inproceedings{ WOS:000175015600051,
Author = {Christian, PM and Wells, R},
Editor = {Sisti, AF and Trevisani, DA},
Title = {The Aerospace Toolbox®, a flight vehicle design, analysis, simulation,
   and software development environment (Part I:: An introduction and
   tutorial)},
