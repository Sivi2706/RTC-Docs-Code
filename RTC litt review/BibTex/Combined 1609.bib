@article{ WOS:001778447300035,
Author = {Kim, Jinseong and Lee, Gunwoo and Choi, Hyunseok and Heo, Younghun and
   Lee, Sangmoon},
Title = {Rapid Indirect Diagnosis of MEMS Gyroscope Initial Bias With On-Board
   Capability for Guided Missiles},
Journal = {IEEE TRANSACTIONS ON AEROSPACE AND ELECTRONIC SYSTEMS},
Year = {2026},
Volume = {62},
Pages = {10223-10233},
Abstract = {This article presents a rapid, on-board capable method for diagnosing
   initial bias failures in microelectro-mechanical system (MEMS)
   gyroscopes, a critical factor for the navigation accuracy of guided
   missiles. The proposed technique operates exclusively on internal
   missile data, eliminating the need for sensor disassembly or external
   tools. The method is structured as a two-stage process: first, anomaly
   detection using the gyroscope output from the Initial Alignment,
   followed by fault diagnosis using the Inertial Navigation Systems output
   from the Initial Navigation Mode. This integrated two-stage approach
   enables rapid identification of failures within seconds. Optimized for
   real-time embedded applications, the method achieves minimal
   computational overhead through simple averaging and matrix operations,
   while also offering high interpretability by linking its diagnostic
   results to physical models. Validated on a dataset of over 10 000 guided
   missile tests, the proposed method demonstrates high diagnostic accuracy
   and millisecond-level performance, confirming its effectiveness as a
   practical solution for on-board health monitoring of MEMS gyroscopes.},
