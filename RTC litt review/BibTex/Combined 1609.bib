Title = {The ST5000: a high-precision star tracker and attitude determination
   system - art. no. 70104H},
Booktitle = {SPACE TELESCOPES AND INSTRUMENTATION 2008: OPTICAL, INFRARED, AND
   MILLIMETER, PTS 1 AND 2},
