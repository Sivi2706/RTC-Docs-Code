@inproceedings{ WOS:000373647300064,
Author = {Yushkov, V. and Gvozdev, Yu. and Lykov, A. and Shershakov, V. and
   Ivanov, V. and Pozin, A. and Afanasenkov, A. and Savenkov, Yu. and
   Kuznetsov, V.},
