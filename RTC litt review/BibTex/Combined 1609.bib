Pages = {481-493},
Month = {JUL},
Abstract = {Graph labeling is a versatile tool used across diverse scientific and
   engineering fields where complex systems are represented as graphs. It
   provides a structured approach to understand, manipulate, and optimize
   these systems. By applying graph labeling techniques, researchers and
   practitioners can analyze signal flow, optimize circuit designs,
   allocate frequencies in communication networks, model molecular
   structures in X-ray crystallography, design error-correcting codes in
   coding theory, plan trajectories in missile guidance systems, and
   address numerous other challenges in fields ranging from
   telecommunications to molecular biology. In this paper, we have
   introduced the L(3, 2, 1)-labeling index of a graph and obtained bounds
   for this new parameter.},
