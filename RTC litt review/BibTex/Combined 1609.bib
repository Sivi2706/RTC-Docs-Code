   Hilton, G. and Irwin, K. D. and Kelley, R. L. and Kibourne, C. A. and
   Leman, S. W. and McCammon, D. and Porter, F. S. and Reintsema, C. D. and
   Rutherford, J. M. and Trowbridge, S. N.},
Editor = {Cabrera, B and Miller, A and Young, B},
Title = {The Detector and Readout Systems of the Micro-X High Resolution
   Microcalorimeter X-Ray Imaging Rocket},
Booktitle = {LOW TEMPERATURE DETECTORS LTD 13},
