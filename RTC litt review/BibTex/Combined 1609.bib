@article{ WOS:001498041600001,
Author = {Liu, Yekun and Zhang, Xiaoyu and Tan, Panlong and Li, Shoupeng and Dong,
   Fei},
Title = {Three-dimensional predefined-time sliding mode guidance with terminal
   angle constraints},
Journal = {ASIAN JOURNAL OF CONTROL},
Year = {2026},
Volume = {28},
Number = {3},
Pages = {1326-1339},
Month = {MAY},
Abstract = {Given the shortness terminal guidance time, the convergence time of a
   guidance law is a key performance metric. To address this challenge and
   enhance the missile warheads' effectiveness, a three-dimensional coupled
   nonlinear dynamic system with terminal line-of-sight (LOS) angle
   constraint is considered. An innovative predefined-time guidance law is
   proposed, ensuring that the convergence time is independent of initial
   conditions and parameter selection, with convergence time as an
   explicitly adjustable parameter. Firstly, based on the theory of
   predefined-time convergence, a sliding manifold is constructed to ensure
   that the LOS angle tracking error and angular rate converge to zero
   within a predefined time. Secondly, a reaching law is designed using
   K\$\$ \textbackslash{}mathcal\{K\} \$\$-class function to facilitate the
   guidance system's state convergence to the sliding manifold within the
   predefined time. Finally, to address the disturbance in the model, a
   fixed-time disturbance observer is introduced to compensate for the
   guidance law, thereby attenuating sliding mode chattering. The stability
   of the missile intercept target under the proposed guidance law is
   demonstrated using Lyapunov stability theory. Simulation results
   validate the performance of the proposed guidance strategy.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
