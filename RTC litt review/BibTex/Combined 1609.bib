@inproceedings{ WOS:000407525000049,
Author = {Li, Qiang and Strelnikov, Boris and Rapp, Markus and Luebken,
   Franz-Josef and Baumgarten, Gerd and Finke, Sebastian and Pohlmann, Rolf
   and Schumacher, Jan-Berend and Ewald, Hartmut},
Editor = {Ouwehand, L},
Title = {ACTIVE FALLING SPHERE FOR HIGH-RESOLUTION MEASUREMENTS OF DENSITY,
   TEMPERATURE, AND HORIZONTAL WINDS IN THE MIDDLE ATMOSPHERE},
Booktitle = {PROCEEDINGS OF THE 21ST ESA SYMPOSIUM ON EUROPEAN ROCKET \& BALLOON
   PROGRAMMES AND RESEARCH},
Series = {ESA Special Publications},
Year = {2013},
