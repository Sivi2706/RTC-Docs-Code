@inproceedings{ WOS:000237218500018,
Author = {Whiteman, Donald E. and Valencia, Lisa M. and Simpson, James C.},
Editor = {Lacoste, H},
Title = {Space-based range safety and future space range applications},
Booktitle = {Proceedings of the First IAASS Conference on Space Safety, a New
   Beginning},
