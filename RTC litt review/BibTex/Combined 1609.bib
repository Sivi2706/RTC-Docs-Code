@inproceedings{ WOS:000187552100026,
Author = {Ju, G and Junkins, JL},
Editor = {Vadali, SR and Mortari, D},
Title = {Overview of star tracker technology and its trends in research and
   development},
Booktitle = {JOHN L. JUNKINS ASTRODYNAMICS SYMPOSIUM},
