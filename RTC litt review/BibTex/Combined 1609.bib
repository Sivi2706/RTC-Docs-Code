@article{ WOS:000285139200025,
Author = {Marzban, S. and Mohamedpour, K.},
Title = {Calculation of the communication angles between an air vehicle and
   receiver antenna in aeronautical telemetry},
Journal = {IET MICROWAVES ANTENNAS \& PROPAGATION},
Year = {2010},
Volume = {4},
Number = {12},
Pages = {2187-2195},
Month = {DEC},
Abstract = {To determine the immediate effect of an air vehicle's manoeuvre on the
   radio link of aeronautical telemetry, it is needed to calculate instant
   angles between such an air vehicle and a receiver antenna. Having
   determined the communication angles of the air vehicle, the
   instantaneous gains from transmitter antennas can be calculated, thus
   evaluating the radio link status in terms of bit error rate (BER).
   Through calculating its communication angles, a receiver that is
   equipped with a system of auto tracking the air vehicles can be assisted
   in better tracking. For non-tracking systems, having determined the
   communication angles of the receiver antenna, the instantaneous gain
   from such a receiver antenna can be attained. However, availability of
   the communication angles is absolutely vital for evaluation of the
   real-time radio link in aeronautical telemetry. This paper proposes an
   algorithm and its relevant equations to calculate these angles. By a
   proper methodology, the proposed algorithm is then validated and the
   results are depicted using a hypothetical missile and an assumed
   airplane flight starting from earth's geographical coordinates (where
   longitude and latitude are set to zero) and extending towards the North
   Pole.},
