@inproceedings{ WOS:001472217500021,
Author = {Chen, Du and Jiang, Haomiao and Bai, Haile and Luo, Bing and Luo,
   Xiaoliang and Wen, Guangjun and Su, Jingfang and Huang, Yongjun},
Editor = {Yan, L and Duan, H and Deng, Y},
Title = {Design of an INS/CNS Integrated Navigation Joint Simulation Framework},
Booktitle = {ADVANCES IN GUIDANCE, NAVIGATION AND CONTROL, VOL 6},
Series = {Lecture Notes in Electrical Engineering},
Year = {2025},
Volume = {1342},
Pages = {214-223},
Note = {2024 International Conference on Guidance, Navigation and Control,
   Changsha, PEOPLES R CHINA, AUG 09-11, 2024},
Organization = {National University of Defense Technology},
Abstract = {INS/CNS integrated navigation is widely used in high-precision
   autonomous navigation systems for aircrafts, missiles and other space
   vehicles, which has many advantages such as high autonomy, strong
   anti-jamming ability and high accuracy. However, since it is relatively
   difficult to validate the star sensors often used in celestial
   navigation on the ground, with high cost, limited by the test
   environment and other problems, it is not suitable for the rapid
   validation of INS/CNS integrated navigation algorithms. Therefore, this
   paper designs a scalable automated simulation framework for the testing
   and validation of INS/CNS integrated navigation algorithms, generates
