@inproceedings{ WOS:000071862000053,
Author = {Eisenman, AR and Liebe, CC and Jorgensen, JL},
Editor = {Fujisada, H},
Title = {The new generation of autonomous star trackers},
Booktitle = {SENSORS, SYSTEMS, AND NEXT-GENERATION SATELLITES},
Series = {PROCEEDINGS OF THE SOCIETY OF PHOTO-OPTICAL INSTRUMENTATION ENGINEERS
   (SPIE)},
