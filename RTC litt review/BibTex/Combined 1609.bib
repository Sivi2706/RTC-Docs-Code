@inproceedings{ WOS:000179854400043,
Author = {Krishnamurty, V and Sankarasubramanian, S and Janakiraman, R and Kumar,
   JVNR},
Editor = {Battrick, B and Preyssl, C},
Title = {Knowledge based Range Safety Advisor},
Booktitle = {PROCEEDINGS OF THE JOINT ESA-NASA SPACE-FLIGHT SAFETY CONFERENCE},
Series = {ESA SPECIAL PUBLICATIONS},
Year = {2002},
Volume = {486},
Pages = {333-338},
Note = {Joint ESA-NASA Space-Flight Safety Conference, NOORDWIJK, NETHERLANDS,
   JUN 11-14, 2002},
Organization = {European Space Agcy; NASA},
Abstract = {The launch vehicle performance is monitored in real time and the Range
   Safety Officer (RSO) takes mission abort action if the vehicle poses
   danger to public. The tracking radars provide the flight parameters and
   the telemetry systems provide the launch vehicle system performance. The
   real time data processing network elements and the different processing
   software constitute the range safety real time system. In the
   conventional system, RSO has to correlate interpretations from tracking
   and telemetry data displayed in different workstations. This paper
   presents a knowledge-based system, ``Range Safety Advisor (RSA){''},
   which synthesises interpretations from tracking and telemetry sources
   and displays the correlated decision. It employs knowledge from range
   safety experts, past flight history, nominal flight performance and
   mathematical algorithms for generating pitch and yaw flight deviation
   criteria. The mathematical algorithms use geographical impact limit
   lines, impact point prediction, debris impact zone prediction and
   telemetry data processing modules. RSA presents the multiple tracking
   systems status, vehicle status and inferences in a icon-based graphic
   screen. Visualisation is used effectively to design the output screen to
   convey a very meaningful picture of the vehicle status along with very
   important parameters. This system is operational and is being used to
   assist RSO during satellite launch vehicle missions.},
