@inproceedings{ WOS:001880191900062,
Author = {Eramo, Vincenzo and Valente, Francesco and Lavacca, Francesco G. and
   Fiori, Tiziana and Papandrea, Valentino and Albano, Marta and Ciabuschi,
   Simone and Cavallini, Enrico},
