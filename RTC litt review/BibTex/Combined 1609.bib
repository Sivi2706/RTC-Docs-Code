@article{ WOS:001740812900001,
Author = {Macedo, Arthur Medeiros and Kienitz, Karl Heinz},
Title = {Comparative Analysis of Dynamic Models and Adaptive Process-Noise
   Modeling for Kalman-Based Aerial Target Tracking},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {54366-54379},
Abstract = {Accurate target tracking is essential for the effectiveness of air
   surveillance, air-traffic monitoring, and defense-support systems. This
   paper presents a comparative study of several dynamic motion models
   applied to Kalman-based filters for aerial target tracking, including
   constant-velocity, constant-acceleration, correlated-acceleration
   (Singer), constant-turn, and curvilinear models, as well as a
   multiple-model estimator based on the Interacting Multiple Model (IMM)
   framework. An online process-noise covariance matrix adaptation scheme
   is also proposed, based on a covariance-basis decomposition that enables
   interpretable adjustment of dynamic uncertainties. The method
   dynamically updates the process noise covariance matrix to maintain
   statistical consistency under varying motion regimes. A systematic
   evaluation is performed using synthetic trajectories and real tracking
   data. Results show that filters based on models consistent with the
   underlying dynamics achieve the lowest position errors and best
   statistical consistency. Moreover, simplified models combined with
   adaptive process-noise covariance matrix tuning exhibit robust and
   competitive performance across different motion conditions, while the
   IMM estimator provides strong performance in scenarios with changing
   maneuver regimes. The findings highlight the effectiveness of
   covariance-based adaptation for enhancing Kalman filter robustness in
   air target tracking applications.},
