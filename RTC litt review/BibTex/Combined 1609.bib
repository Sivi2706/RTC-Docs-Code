@inproceedings{ WOS:001409643700235,
Author = {Schneider, Marc and Fichter, Walter},
Book-Group-Author = {AIAA},
Title = {Multi-Hypothesis Guidance With Interacting Multiple Model Filter},
Booktitle = {AIAA SCITECH 2022 FORUM},
Year = {2022},
Note = {AIAA Science and Technology Forum and Exposition (AIAA SciTech Forum),
   ELECTR NETWORK, JAN 03-07, 2022},
Organization = {AIAA},
Abstract = {Most missile guidance laws are based on specific assumptions about the
   type and behavior of the target. However, this information is not
   necessarily available in time and with sufficient certainty. In fact,
   premature commitment to a specific target type and behavior can severely
   degrade missile performance. Therefore, this paper investigates a
   guidance system that can simultaneously take into account different
   hypotheses about target type and behavior. Using an interacting multiple
   model filter, the probabilities of several fundamental movement patterns
   and their respective parameters are estimated. These are then used to
   run multiple zero-effort-miss guidance laws in parallel, each assuming a
   different hypothesis. The combination of different acceleration commands
   produced by the different guidance laws is done in two ways: either a
   weighted average is calculated or the guidance system tries to keep all
   possible target trajectories reachable as long as possible. The
   conducted simulations show the performance benefits of multi-hypothesis
   guidance compared to a state-of-the-art single-hypothesis guidance law.},
