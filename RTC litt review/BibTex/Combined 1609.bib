@inproceedings{ WOS:001419060902027,
Author = {Woody, Kyle J. and Van Bibber, Conor},
Book-Group-Author = {AIAA},
Title = {Apogee Altitude Control of Sounding Rockets with an Analytic Guidance
   Algorithm},
Booktitle = {AIAA SCITECH 2025 FORUM},
Year = {2025},
Note = {2025 AIAA SCITECH Forum, Orlando, FL, JAN 06-10, 2025},
Abstract = {Sounding rockets provide a cost-effective means to conduct experiments
   in the upper atmosphere. However, reaching a precise apogee altitude is
   a challenge for sounding rockets due to atmospheric disturbances,
   variations in rocket engine performance, and inaccurate trajectory
   prediction. The use of an air brake can mitigate these problems through
   controlled deceleration and apogee correction. This paper reports a
   novel guidance and control system that tracks the acceleration required
   to reach the target apogee altitude without knowledge of the rocket's
   aerodynamic characteristics. A guidance algorithm is analytically
   derived from the kinematics of a rocket in coasting flight and
   proportional-integral control is used to actuate the air brake and track
   the guidance output. The avionics and state estimation methods are also
   presented. Preliminary analysis of the guidance algorithm shows good
   agreement with test flight data.},
