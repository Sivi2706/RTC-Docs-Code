   and Thorstenson, J. and Lyckman, L.},
Editor = {Lacoste, H},
Title = {THE MASER 11 MICROGRAVITY ROCKET FLIGHT},
Booktitle = {PROCEEDINGS OF THE 19TH ESA SYMPOSIUM ON EUROPEAN ROCKET AND BALLOON
   PROGRAMMES AND RELATED RESEARCH},
Series = {ESA Special Publications},
Year = {2009},
