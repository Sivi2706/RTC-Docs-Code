@inproceedings{ WOS:001443928500081,
Author = {Zhou, Li and Wang, Yunhui and Xue, Yijuan and Jiang, Biao and Xue, Jiao},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Research on High Reliability 1553B Bus RT Mode Data Receiving Method},
Booktitle = {PROCEEDINGS OF INTERNATIONAL CONFERENCE ON IMAGE PROCESSING, MACHINE
   LEARNING AND PATTERN RECOGNITION, IPMLP 2024},
Year = {2024},
Pages = {509-514},
Note = {1st International Conference on Image Processing Machine Learning and
   Pattern Recognition, Guangzhou, PEOPLES R CHINA, SEP 13-15, 2024},
Abstract = {As the core control communication bus in the field of aerospace and
   weapons, 1553B bus has the characteristics of high reliability, high
   real-time, reasonable error control measures, high bus efficiency, and
   is widely used in rocket, satellite, spacecraft and other space fields,
   as well as modern aircraft avionics system. RT is a slave device of the
   1553B bus, subject to the command of the bus controller, responsible for
   ready to receive and send data, and operate according to the data
   command of the bus controller, in order to ensure the reliability and
   efficiency of the 1553B bus system. In RT mode, how to receive bus
   controller commands correctly, efficiently and reliably and ensure the
   correct execution of commands has become a crucial part of RT system
   work. This paper presents three kinds of data receiving software
   implementation methods under RT mode of 1553B bus, which can realize
   real-time, accuracy and reliability of software data receiving.},
Publisher = {ASSOC COMPUTING MACHINERY},
Address = {1601 Broadway, 10th Floor, NEW YORK, NY, UNITED STATES},
Type = {Proceedings Paper},
Language = {English},
