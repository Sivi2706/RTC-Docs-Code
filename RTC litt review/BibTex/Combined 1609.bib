@inproceedings{ WOS:000380433000178,
Author = {Kada, Belkacem},
Book-Group-Author = {IEEE},
Title = {Robust Stability Analysis and Topological Dynamics of a Nonminimum Phase
   Supersonic Tactical Missile},
Booktitle = {3RD INTERNATIONAL CONFERENCE ON CONTROL, ENGINEERING \& INFORMATION
   TECHNOLOGY (CEIT 2015)},
Year = {2015},
Note = {INTERNATIONAL CONFERENCE ON CONTROL ENGINEERING \& INFORMATION
   TECHNOLOGY (CEIT), Tlemcen, ALGERIA, MAY 25-27, 2015},
Abstract = {The paper presents a novel analysis of a nonminimum supersonic vehicle
   dynamics. First, a mapping of operating points of a hypothetical
   short-range tactical missile (SRTM) system is obtained using zero
   dynamics concept for nonlinear systems within flight envelop and under
   flight constraints. Then the characteristics of nonminimum phase, model
   topologies, and poles mappings are derived via linearization of the SRTM
   dynamics. The analysis shows that the dynamics of SRTM system are often
   nonminimum phase leading to internal instability and introducing a
   performance bound on the flight control system.},
