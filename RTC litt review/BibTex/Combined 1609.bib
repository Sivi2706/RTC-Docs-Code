@inproceedings{ WOS:000380467800043,
Author = {Hadi, Yulyan Wahyu and Bambang, Riyanto T.},
Book-Group-Author = {IEEE},
Title = {Development of Hardware-in-the-loop Simultion for Rocket Guidance System},
Booktitle = {5TH INTERNATIONAL CONFERENCE ON ELECTRICAL ENGINEERING AND INFORMATICS
   2015},
