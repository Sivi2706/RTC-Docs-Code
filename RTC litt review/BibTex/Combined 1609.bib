@inproceedings{ WOS:000304032002011,
Author = {Vasta, Robert and Watson, Michael and LeBlanc, Keith},
Book-Group-Author = {ION},
Title = {NAVFEST: A Cost Effective Solution to GPS NAVWAR Testing},
Booktitle = {PROCEEDINGS OF THE 24TH INTERNATIONAL TECHNICAL MEETING OF THE SATELLITE
   DIVISION OF THE INSTITUTE OF NAVIGATION (ION GNSS 2011)},
