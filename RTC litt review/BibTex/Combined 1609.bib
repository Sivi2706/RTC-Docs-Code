Series = {COSPAR COLLOQUIA SERIES},
Year = {1999},
Volume = {10},
Pages = {114-122},
Note = {COSPAR Colloquium on Microsatellites as Research Tools, TAINAN, TAIWAN,
   DEC 14-17, 1997},
Organization = {Comm Space Res; Int Acad Astronaut; Swedish Natl Space Board; Academia
   Sin; Minist Educ; Natl Sci Council; Aeronaut \& Astronaut Soc ROC; ITRI,
   Ctr Aerosp Sci \& Technol; Tainan Hydraul Lab; Natl Cent Univ; Natl
   Cheng Kung Univ},
Abstract = {The Johns Hopkins University Applied Physics Laboratory is currently
   preparing for its next generation of low Earth orbiting and deep space
   missions. Auroral Multi-Scale (AMS) is one of those missions. The
   mission uses four miniature (36 kg each) spacecraft to perform high
   resolution multi-point electric and magnetic field measurements of
   auroral phenomena at various altitudes and latitudes. AMS uses a single
   Pegasus launch vehicle to inject the cluster into its operational orbit.
   Once deployed, the cluster maintains a tight formation-using GPS for
   position determination, an imager star tracker for attitude
   determination, and by taking advantage of atmospheric drag for position
   control. To implement missions like AMS, new technologies are required
   that up until recently did not exist. APL has been recently developing a
   new spacecraft architecture that is extremely small and low power yet
   adaptable to a variety of different mission types. This architecture
   uses several new technologies: 1) a modular, miniature, low power,
   avionics architecture; 2) a flight qualified bare die packaging
   technique called ``chip-on-board{''}; 3) a technique to mold the
   spacecraft structures, instead of machining them, that lends itself to
   mass production, and 4) aerodynamic-drag station keeping. This paper
   focuses on the implementation of the low cost, but highly capable,
   Auroral Multiscale multi-point mission, and the technology that enables
   this highly capable science mission.},
