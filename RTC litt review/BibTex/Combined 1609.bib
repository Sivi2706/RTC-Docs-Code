@article{ WOS:000327913800010,
Author = {Ray, Sabooj and Doss, Jeba Arul and Abraham, Sheena and Pradeep, N. and
   Kumar, S. Prem},
Title = {Wireless Data Acquisition System for Launch Vehicles},
