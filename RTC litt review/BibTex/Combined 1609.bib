@article{ WOS:001024846700002,
Author = {Saeed, Mohd Asim and Srivastava, Rajesh Kumar and Sehgal, Deep and Das,
   Devarshi Mrinal},
Title = {Design of a high precision CMOS programmable gain and data rate delta
   sigma ADC},
