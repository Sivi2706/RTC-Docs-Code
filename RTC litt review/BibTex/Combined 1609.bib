@inproceedings{ WOS:000323912100155,
Author = {Du En-xiang and Wang Wei},
Editor = {Chen, R and Sung, WP and Kao, JCM},
Title = {De-noising Method of a Certain Missile Homing and Control Signal Based
   on Wavelet Transform},
Booktitle = {MECHATRONICS AND INTELLIGENT MATERIALS III, PTS 1-3},
Series = {Advanced Materials Research},
Year = {2013},
Volume = {706-708},
Pages = {700-703},
Note = {3rd International Conference on Mechatronics and Intelligent Materials
   (MIM 2013), XiShuangBanNa, PEOPLES R CHINA, MAY 18-19, 2013},
Abstract = {Homing and control signal is important information which can reflect
   system performance and technical conditions of guidance system, and
   homing and control signal is one of core contents of guidance system
   detection, and de-nosing of the signal has an important meaning to the
   accuracy of guidance system detection and assessment. This paper
   introduces wavelet de-nosing method for the characteristic of homing and
   control signal and its noise signal.
   In the process of measuring the control signal of certain missile
   guidance system, the factors, such as the environment, the detection
   system, etc., which makes the noise signal mixed in the guidance control
   signal measured. It is an importance of analyzing source of the noise
   and noise characteristic and eliminating the noise produced in the
   detection procedure. Fourier Transform and short time Fourier transform
   (STFT) distinguish the control signal and noise signal in the
   characteristic of frequency by launching the signal in the
   frequency-domain, then eliminating the noise. Wavelet transform is
   multi-resolution analysis method, which can get the characterization of
   local signal information in the time-domain and frequency-domain. So it
   is widely used in the signal de-noise, especially in the signal which
   has mutation characteristics and the noise signal is difficult to
   totally eliminate in frequency-domain, which has its unique advantages.},
