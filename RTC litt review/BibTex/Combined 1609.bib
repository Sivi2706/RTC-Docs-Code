@inproceedings{ WOS:000355752400015,
Author = {MacWilliams, Kara J. and Tao, Zheng and Edwards, David N.},
Book-Group-Author = {IEEE},
Title = {COMMERCIAL SPACE TRANSPORTATION SURVEILLANCE NEEDS ASSESSMENT},
Booktitle = {2014 INTEGRATED COMMUNICATIONS, NAVIGATION AND SURVEILLANCE CONFERENCE
   (ICNS)},
Series = {Integration Communications Navigation and Surveillance Conference},
Year = {2014},
Note = {Conference on Integrated Communications, Navigation and Surveillance
   (ICNS), Herndon, VA, APR 08-10, 2014},
Abstract = {Integrating growing Commercial Space Transportation (CST) operations
   into the National Airspace System (NAS) is an emerging challenge for the
   Federal Aviation Administration (FAA). This industry consists of new
   players, ideas, launch methods, and vehicle designs, in addition to
   traditional vertical rocket launches. Integrating commercial space
   vehicle operations in an efficient manner that minimizes impacts on
   other NAS users is essential for the future growth, development, and
   sustainability of the NAS.
   As the CST industry grows, the current approach of sterilizing large
   portions of airspace for each launch will increase the costs for other
   NAS users and limit launches for this nascent industry. Finding an
   economical means for the FAA to surveil the wide ranging types of
   commercial space vehicles is essential to enabling less restrictive and
   more dynamic separation services provided by Air Traffic Control (ATC).
   This paper describes a high-level CST surveillance needs assessment. The
   analysis was based on the existing and planned surveillance
   infrastructure in the United States (U.S.) through the next 10 years. It
   focused on the unique ground-based and airborne surveillance
   capabilities necessary for the integration of CST operations into the
   NAS.
   Using several representative commercial space vehicle flight profiles,
   the analysis identified specific performance gaps and potential
   solutions in the existing and planned surveillance systems. This paper
   summarizes the CST surveillance needs assessment including describing
   the performance characteristics of each flight profile, candidate
   surveillance solutions, potential modifications to current avionics and
   standards, and potential enhancements to emerging ATC automation
   platforms required to accommodate the commercial space vehicle
   performance characteristics as described in the scenarios.},
