@article{ WOS:000245877300011,
Author = {Hwang, Seung-Hyun and Kim, Hyo-Min and Kim, Jhoon and Lee, Eun-Seok and
   Lee, Dong-Hun and Jang, Minwhan and Son, De-Rac and Cho, Gwang-Rae},
Title = {Overview of scientific payloads onboard the KSR-III rocket},
Journal = {ACTA ASTRONAUTICA},
