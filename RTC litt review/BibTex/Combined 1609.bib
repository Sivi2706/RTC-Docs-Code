@inproceedings{ WOS:001329858400050,
Author = {Ipek, Gulhas and Dalkiran, Atilay and Dilibal, Savas},
Editor = {Badica, C and Ivanovic, M and Koprinkova-Hristova, P and Leon, F and Manolopoulos, Y and Yildirim, T and Ucar, A},
Title = {Development of Hybrid Actuator System for Recovery of the Model Rockets},
Booktitle = {2024 INTERNATIONAL CONFERENCE ON INNOVATIONS IN INTELLIGENT SYSTEMS AND
   APPLICATIONS, INISTA},
Series = {IEEE International Symposium on Innovations in Intelligent Systems and
   Applications},
Year = {2024},
Note = {18th International Conference on Innovations in Intelligent Systems and
   Applications (INISTA), Univ Craiova, Craiova, ROMANIA, SEP 04-06, 2024},
Organization = {Syncro Soft; Fac Automat, Comp \& Elec, Dept Comp \& Informat Technol;
   Fac Econ \& Business Adm, Dept Stat \& Business Informat; Fac Math \&
   Nat Sci, Dept Informat; Doctoral Sch Constantin Belea; Intelligent
   Distributed Syst Res Grp},
Abstract = {Model rockets are the advanced mechatronic systems established through
   the design, manufacturing, and integration of the model-scale
   mechatronic sub-systems for a rocket mechanism capable of operating at
   low altitudes. The safe recovery and reusability of model rockets are
   prominent tasks to address. Various actuator systems are used in model
   rockets to solve the safe recovery problem by safely releasing and
   recovering the payloads that they carry at specific altitudes, allowing
   the rockets to be recovered. Traditionally, model rockets have employed
   recovery units powered by gunpowder. This research aims to design a
   novel hybrid actuator system integrating mechanical components with
   pressurized gas and servo motor components as an alternative to
   traditional gunpowder systems to enhance reliability and safety. The
   objective is to develop a prototype of a hybrid recovery actuator system
   using CO2 tubes and servo motors. The principle behind the designed
   recovery system relies on the release of CO2 gas, which facilitates the
   separation of the rocket motor body from the main body. This principle
   is based on the mechanism within the designed actuator system, which
   functions by releasing the potential energy stored in compressed
   springs. Servo motors triggered by signals from the rocket's flight
   computer release the springs, allowing the CO2 gas to escape. The
   released gas separates the rocket bodies, ensuring a safe descent.
   Within the scope of this research, the efficiency and effectiveness of
   the CO2 based hybrid recovery actuator system are evaluated through the
   production of a prototype. The experimental results unveiled that the
   development of the CO2 based hybrid recovery actuator system enables
   safe and successful recovery of model rockets. To achieve the timely
   release of the CO2 gas in the recovery system, the required pressure is
   determined via experimental studies for the separation of rocket bodies,
   ensuring a safe descent.},
