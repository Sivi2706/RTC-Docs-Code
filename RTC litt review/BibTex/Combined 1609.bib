@article{ WOS:000332969500001,
Author = {Zhang, Bo and Wang, Shushan and Cao, Mengyu and Xu, Yuxin},
Title = {Impacts of Deflection Nose on Ballistic Trajectory Control Law},
Journal = {MATHEMATICAL PROBLEMS IN ENGINEERING},
Year = {2014},
Volume = {2014},
Abstract = {The deflection of projectile nose is aimed at changing the motion of the
   projectile in flight with the theory of motion control and changing the
   exterior ballistics so as to change its range and increase its accuracy.
   The law of external ballistics with the deflectable nose is considered
   as the basis of the design of a flight control system and an important
   part in the process of projectile development. Based on the existing
   rigid external ballistic model, this paper establishes an external
   ballistic calculation model for deflectable nose projectile and further
   establishes the solving programs accordingly. Different angle of attack,
   velocity, coefficients of lift, resistance, and moment under the
   deflection can be obtained in this paper based on the previous
   experiments and emulation researches. In the end, the author pointed out
   the laws on the impaction of external ballistic trajectory by the
   deflection of nose of the missile.},
