@inproceedings{ WOS:001668643200017,
Author = {Zhu, Kuibao and Tian, Ze and Liu, Shunli and Ma, Jinhuang and Yu,
   Minghao and Chen, Xin and Li, Chuan},
Editor = {Zhou, P},
Title = {Optical System Design for Distributed Semi-Active Laser Seeking},
Booktitle = {AOPC 2025: LASER TECHNOLOGY AND APPLICATIONS},
Series = {Proceedings of SPIE},
Year = {2025},
Volume = {13956},
Note = {2025 Applied Optics and Photonics China-AOPC-Laser Technology and
   Applications, Beijing, PEOPLES R CHINA, JUN 24-27, 2025},
Organization = {The International Society for Optics and Photonics},
Abstract = {To achieve aperture miniaturization, structural simplification, and
   cost-effectiveness in man-portable guided munitions, this study proposes
   a distributed aperture semi-active laser detection system integrated
   into missile wings using non-imaging optical principles. The design
   employs four spatially distributed optical modules, each comprising
   precision optical lenses coupled with avalanche photodiode (APD)
   detectors. Geometrically optimized coordination enables
   angular-dependent signal modulation, where luminous flux on each
   detector varies proportionally with the incident angle. This facilitates
   differential signal processing for spatial target localization via
   comparative analysis of multi-channel outputs.
   The methodology starts with system performance benchmarking, beginning
   with optical parameter derivation via radiometric calculations and
   geometric optics. Initial lens configuration uses parametric
   optimization and similarity matching with optical databases. Subsequent
   design optimization implements constraint programming, incorporating
   surface curvature boundaries, material dispersion, and
   manufacturability. Performance metrics include spot footprint mapping,
   spot diagrams, and out-of-focus aberrations.Concurrently, a novel target
   localization algorithm uses differential signal processing in the
   system's linear response region. Within the +/- 6 degrees linear
   detection zone, it executes vector decomposition of multi-channel
   intensities via coordinate transformation matrices for precise azimuth
   resolution.
   Simulations demonstrated: +/- 6 degrees linear FOV and +/- 16 degrees
   full FOV; a 2.5km maximum detection range under clear conditions
   (visibility >10km); and <0.02 degrees angular accuracy via adaptive
   noise suppression. These metrics align with laser-guided munition
   expectations, providing significant weight reduction, cost savings, and
   accuracy improvements over conventional quadrant detectors. By balancing
   optical performance and structural efficiency, the structure
   demonstrates feasibility for next-generation compact guidance systems.},
