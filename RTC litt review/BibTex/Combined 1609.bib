@inproceedings{ WOS:000075547000002,
Author = {Sanneman, P and Blackman, K and Gonzalez, M and Speer, D},
Editor = {Culp, RD and Igli, DA},
Title = {New Millennium Earth Orbiter-1 mission: Attitude control requirements
   and capabilities},
Booktitle = {GUIDANCE AND CONTROL 1998},
Series = {ADVANCES IN THE ASTRONAUTICAL SCIENCES},
Year = {1998},
Volume = {98},
Pages = {21-40},
Note = {Annual American-Astronautical-Society Rocky Mountain Guidance and
   Control Conference, BRECKENRIDGE, CO, FEB 04-08, 1998},
Organization = {Amer Astronaut Soc},
Abstract = {As part of NASA's New Millennium Program (NMP), the Earth Orbiter \#1
   (EO-1) mission is focused on the development and flight testing of new
   remote sensing, spacecraft, and operations technologies that could be
   applied to 21st century NASA missions. This Earth observing spacecraft,
   developed through the Goddard Space Flight Center (GSFC), will provide
   flight validation of the Advanced Land Imager (ALI), a Landsat-type
   hyper-spectral Earth science instrument being built by the MIT Lincoln
   Laboratory. The pointing and stability requirements for this
   ``push-broom{''} imaging instrument are the main drivers of attitude
   control performance. In particular, the Wedge Imaging Spectrometer (WIS)
   requires tight yaw attitude control accuracy to preserve the spectral
   purity of observed targets. Image targeting requires onboard calculation
   and compensation for local ground track motion based on orbit
   inclination and landmass shift due to Earth rotation.
   The EO-1 Attitude Control Subsystem (ACS) is three-axis stabilized with
   on-axis reaction wheels for control actuation and a hydrazine propulsion
   system for Delta V capability. Pointing requirements for the roll,
   pitch, and yaw axes are 0.02 degrees, 0.02 degrees, and 0.01 degrees
   2-sigma respectively, and the ACS supports cross-track pointing of
   +/-6.50 degrees about the roll axis. The on-board attitude determination
   shall use a six-state Kalman Filter executing at 1 Hz, with absolute
   attitude information provided from an autonomous star tracker.
   Sub-arcsecond jitter requirements will be met by adjusting the operating
   profiles of the on-board actuators, There are ACS operating modes for
   ``B-dot{''} despin following launch vehicle separation, initial sun
   acquisition, nadir-pointed science data collection, generic slew
   maneuvers for calibrations, and thruster controlled Delta-Velocity
   maneuvers for orbit adjustments and close formation flight.
   In addition to the remote sensing instruments, the ACS interacts with
   three other New Millennium technology experiments: the Pulsed Plasma
   Thruster for closed-loop pitch axis control; the X-Band Phased Array
   Antenna for beam steering commands; and the Enhanced Formation Flying
   demonstration of autonomous navigation and orbit maintenance in
   formation flight with Landsat-7.},
Publisher = {UNIVELT INC},
Address = {PO BOX 28130, SAN DIEGO, CA 92128 USA},
Type = {Proceedings Paper},
Language = {English},
Affiliation = {Sanneman, P (Corresponding Author), Welch Engn Ltd, Suite 450,15200 Shady Grove Rd, Rockville, MD 20850 USA.
