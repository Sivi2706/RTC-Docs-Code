   IEEE},
Title = {Realization of fault tolerant control using μ-synthesis for the reusable
   launch vehicle},
Booktitle = {SICE 2002: PROCEEDINGS OF THE 41ST SICE ANNUAL CONFERENCE, VOLS 1-5},
Year = {2002},
Pages = {169-174},
Note = {41st Annual Conference of the
   Society-of-Instrument-and-Control-Engineers (SICE 2002), OSAKA, JAPAN,
   AUG 05-07, 2002},
Organization = {Soc Instrument \& Control Engineers},
Abstract = {The reusable launch vehicles fly glidingly without any thrusts in the
   returning phase. In this phase, one of the most possible and important
   faults in the airframe is a jamming of the elevon. In order to make the
   control system tolerant to this failure the flight control system is
   required to keep the stability and the performance even if such failure
   occurs. Since this kind of faults can be modeled as a structured
   parameter deviation from robust control point of view, this paper
   presents some new ideas to realize the fault tolerant flight control
   system based on the mu-synthesis, and apply it to the reusable launch
   vehicle HOPE-X (H-H-Orbiting Plane-Experimental) as an example. Also,
   some simulations are demonstrated to verify the usefulness of the
   proposed method.},
