Pages = {5844-5848},
Note = {Chinese Automation Congress (CAC), Shanghai, PEOPLES R CHINA, NOV 06-08,
   2020},
Organization = {IEEE; CAA; IEEE Syst, Man, \& Cybernet Soc},
Abstract = {Precise attacking of the vital regions of the threatening targets can be
   achieved by using the imaging air-to-ground missiles (AGMs), and a
   guidance control method suitable for the stable control of the imaging
   AGM is proposed in this paper. Components of the guidance control system
   are determined on the basis of the guidance property analysis of the
   imaging seekers, and the calculation method of target pointing is given
   based on the inertial navigation system (INS). Stable missile body
   control is realized by fusing tilt stability control, attitude control,
   height control, gravity compensation control, environmental adoption
   compensation control, and impact angle constraint control together.
   Experimental results on real collected data have verified the
   effectiveness of the proposed method.},
