@inproceedings{ WOS:001409500402060,
Author = {Raymer, Daniel P. and French, James and Finger, Felix and Gomez, Arturo
   and Singh, Jaspreet and Pillai, Ramlingam Gyanasampath and Monjon,
   Matheus and de Souza, Joabe Marcos and Levy, Aviv},
