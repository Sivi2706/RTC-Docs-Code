Title = {Guidance Flight with the Unmanned Airship Steered by a Homing Seeker},
Booktitle = {2014 11TH WORLD CONGRESS ON INTELLIGENT CONTROL AND AUTOMATION (WCICA)},
Year = {2014},
Pages = {3810-3814},
Note = {11th World Congress on Intelligent Control and Automation, Shenyang,
   PEOPLES R CHINA, JUN 29-JUL 04, 2014},
Abstract = {A method for simulating guidance process with the unmanned aircraft
   steered by a homing seeker according to missile guidance laws is put
   forward and verified by field flight test. Based on the segmented PID
   controller of the longitudinal control channel of the airship flight
   control system, an unmanned airship is piloted by the target information
   produced by a homing TV seeker loaded on the airship to realize guidance
   flight according to the preset guidance law successfully. By the method,
   one can simulate the double-close-loop guidance control process, one of
   the valuable applications of which is to be used in electronic warfare
   test as the jammed object so as to demonstrate visually and verify the
   electronic jamming effect on missiles.},
