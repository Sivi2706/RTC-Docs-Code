@article{ WOS:001677088300001,
Author = {Lungu, Mihai and Grigorie, Teodor Lucian and But, Florentin Alin and
   Chen, Mou and Flores, Gerardo},
Title = {Integrated software and hardware platform for the guidance of the
   rockets with backstepping controller and strap-down inertial navigation
   system},
Journal = {AEROSPACE SCIENCE AND TECHNOLOGY},
Year = {2026},
Volume = {172},
Month = {MAY},
Abstract = {This work presents a novel technological hardware and software platform,
   with applications in the monitoring, guidance, and control of suborbital
   rockets. The software and hardware platform has two experimental
   components: 1) a rocket virtual model (RVM), implemented as a Java
   software simulator in a dedicated computer, together with a
   reconfigurable software for simulating the disturbances induced by the
   inertial sensors instrumenting the space vehicle, as well as a
   configuration, execution, and visualization interface for modifying the
   ``thrust{''} profiles and choosing the type and the characteristics of
   the rocket; 2) a Raspberry Pi Single-Board Computer (RP-SBC), equipped
   with onboard I/O hardware, and dedicated software, that implements a
   backstepping controller and a strap-down inertial navigation system
   (SD-INS) using an inertial navigation algorithm based on the quaternion
   algebra and a dedicated numerical integration method which minimizes the
   commutation errors. The rocket dynamics is enriched with disturbances
   using Orekit (Java space dynamics library enabling the design of
   numerical/semi-analytic propagators for space vehicles). The validation
   is done in two steps: i) Model-in-the-loop (MIL) - the rocket simulator,
   the backstepping controller, and the SD-INS run on the same computer;
   ii) Hardware-in-the-loop (HIL) - the controller and the SD-INS are
   embedded in an RP-SBC communicating with the RVM over TCP/IP.},
