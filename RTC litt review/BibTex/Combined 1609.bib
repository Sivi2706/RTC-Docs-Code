@article{ WOS:001893862800001,
Author = {Pang, Yang and Zhao, Zhenyang and Zhu, Xuewei and Li, Zongya and Wang,
   Zhenkai and Sun, Peng and Yuan, Zhengguo and Cai, Xiaowen and Cai,
   Qingzhong},
Title = {A Novel Fast Transfer Alignment and Gyroscopic Bias Estimation Method
   Applied to the Prelaunch of Co-Base Mounted Autonomous Drones},
Journal = {IEEE-ASME TRANSACTIONS ON MECHATRONICS},
Year = {2026},
Month = {2026 OCT 1},
Abstract = {In this article, an analytical transfer alignment algorithm is proposed
   which is applicable to the process of autonomous drones transported and
   launched by a launch vehicle. The proposed method novelly combines the
   principle of coordinate transformation with the error model of gyro
   output to establish an analytical model of transfer alignment. The
   method makes a linearized approximation of the analytical transfer
   alignment model by using a rotation vector method, and then, the
   estimation models of misalignment angles and gyro bias for inertial
   navigation systems (INSs) on board of drones are established. The method
   does not rely on prior INS information. Within the tested range (maximum
   absolute initial component: 23.777 degrees), two iterations were
   sufficient when the first-step residual entered the small-angle region.
   Otherwise, further iterations may be required. From the simulation
   results, it can be seen that the proposed method effectively compensates
   more than 70\% of the gyro bias. In four vehiclemounted experiments, the
   repeatability estimation accuracy of the proposed method for the
   misalignment angles was 0.02 degrees and 0.23 degrees under the
   conditions of small and large misalignment angles, respectively.},
Publisher = {IEEE-INST ELECTRICAL ELECTRONICS ENGINEERS INC},
Address = {445 HOES LANE, PISCATAWAY, NJ 08855-4141 USA},
Type = {Article; Early Access},
Language = {English},
