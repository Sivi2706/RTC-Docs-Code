Book-Group-Author = {IEEE},
Title = {Adapting the SpaceCube v2.0 Data Processing System for Mission-Unique
   Application Requirements},
Booktitle = {2015 NASA/ESA CONFERENCE ON ADAPTIVE HARDWARE AND SYSTEMS (AHS)},
