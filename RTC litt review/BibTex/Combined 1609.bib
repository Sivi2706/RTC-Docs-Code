   Felice, F. and Di Stefano, G. and Drakoy, P. and Ibba, R. and Mari, M.
   and Masi, S. and Musso, I. and Palangio, P. and Peterzen, S. and Romeo,
   G. and Spinelli, G. and Spoto, D. and Urbini, G.},
Title = {PEGASO: An ultra light long duration stratospheric payload for polar
   regions flights},
Journal = {ADVANCES IN SPACE RESEARCH},
Year = {2008},
