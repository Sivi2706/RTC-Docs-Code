@inproceedings{ WOS:000393905902123,
Author = {Yang Baoqing and Bi Yongtao and He Fenghua and Yao Yu},
Editor = {Li, W and Zhao, Q},
Title = {Determination of Switch Time of Lateral Thrust for Blended Control
   System under Target Maneuver},
Booktitle = {PROCEEDINGS OF THE 31ST CHINESE CONTROL CONFERENCE},
