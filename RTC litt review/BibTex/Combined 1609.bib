@article{ WOS:000414847600019,
Author = {Zhou, Lesong and Sheng, Zheng and Fan, Zhiqiang and Liao, Qixiang},
Title = {Data Analysis of the TK-1G Sounding Rocket Installed with a Satellite
   Navigation System},
Journal = {ATMOSPHERE},
Year = {2017},
Volume = {8},
Number = {10},
Month = {OCT},
Abstract = {This article gives an in-depth analysis of the experimental data of the
   TK-1G sounding rocket installed with the satellite navigation system. It
   turns out that the data acquisition rate of the rocket sonde is high,
   making the collection of complete trajectory and meteorological data
   possible. By comparing the rocket sonde measurements with those obtained
   by virtue of other methods, we find that the rocket sonde can be
   relatively precise in measuring atmospheric parameters within the scope
   of 20-60 km above the ground. This establishes the fact that the TK-1G
   sounding rocket system is effective in detecting near-space atmospheric
   environment.},
