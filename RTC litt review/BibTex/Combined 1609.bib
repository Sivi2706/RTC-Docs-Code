@article{ WOS:000369233600010,
Author = {Zhao, Handong and Li, Zhipeng},
Title = {Ultra-tight GPS/IMU Integration based Long-Range Rocket Projectile
   Navigation},
Journal = {DEFENCE SCIENCE JOURNAL},
Year = {2016},
Volume = {66},
Number = {1},
Pages = {64-70},
Month = {JAN},
Abstract = {Accurate navigation is important for long-range rocket projectile's
   precise striking. For getting a stable and high-performance navigation
   result, a ultra-tight global position system (GPS), inertial measuring
   unit integration (IMU)-based navigation approach is proposed. In this
   study, high-accuracy position information output from IMU in a short
   time to assist the carrier phase tracking in the GPS receiver, and then
   fused the output information of IMU and GPS based on federated filter.
   Meanwhile, introduced the cubature kalman filter as the local filter to
   replace the unscented kalman filter, and improved it with strong
   tracking principle, then, improved the federated filter with vector
   sharing theory. Lastly simulation was carried out based on the real
   ballistic data, from the estimation error statistic figure. The
   navigation accuracy of the proposed method is higher than traditional
   method.},
