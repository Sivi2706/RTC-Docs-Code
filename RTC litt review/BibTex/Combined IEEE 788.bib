  year={2002},
  volume={},
  number={},
  pages={15-18 vol.1},
  abstract={The Inertial Navigation and Guidance system (ING) with fiber gyros (FOGs) was developed for the ISAS (Institute of Space and Astronautical Science) M-V rocket. The M-V-1 rocket was successfully launched in February 1997. A series of M-V rockets was launched three times and FOG-INGs worked well in all flights. This paper presents the breakthrough points with the flight data of M-V-1 rocket's ING.},
  keywords={Inertial navigation;Rockets;Vibrations;Electric shock;Packaging;Instruction sets;Central Processing Unit;Circuit testing;Satellite broadcasting;Probes},
  doi={10.1109/OFS.2002.1000491},
  ISSN={},
  month={May},}@INPROCEEDINGS{11567004,
  author={Liu, Sheng and Yang, Jungang and Li, Wenchao and Liu, Chuan},
  booktitle={2026 5th International Conference on Electronic Information Engineering, Big Data and Computer Technology (EIBDCT)}, 
  title={Smooth Adaptive Enhancement Algorithm for Telemetry Images Based on HSV Space}, 
  year={2026},
  volume={},
  number={},
  pages={132-136},
  abstract={Due to the effects of transmission noise, smoke, low illumination, or strong light sources, rocket telemetry images suffer from visual quality degradation such as overall darkness and blurriness, low contrast, and background noise. This paper proposes a smooth adaptive image enhancement algorithm based on the HSV space. Building upon the traditional HSV method, the algorithm partitions image regions via multi-scale edge perception, designs an adaptive fusion strategy based on the mean image brightness to achieve collaborative optimization of details and edges, and incorporates adaptive saturation correction to preserve color naturalness, thereby realizing adaptive fusion enhancement for telemetry images throughout the entire flight. Experimental results show that the proposed algorithm outperforms traditional methods in quantitative metrics including peak signal-to-noise ratio (PSNR) and structural similarity (SSIM), effectively improving the quality of low-quality images.},
  keywords={Algorithms;Lighting;Telemetry;Rockets;Image enhancement;PSNR;Brightness;Printing;Color;Degradation;telemetry image;edge perception;adaptive fusion;low-light enhancement},
  doi={10.1109/EIBDCT69742.2026.11567004},
  ISSN={},
  month={April},}@INPROCEEDINGS{11090906,
  author={Zhang, Baochao and Wang, Haoning and Guo, Jie and Wan, Yangyang and Xiang, Yan and Tang, Shengjing},
  booktitle={2025 37th Chinese Control and Decision Conference (CCDC)}, 
  title={Coordinated Decision-Making of Heading and Morphing for a Morphing Reusable Launch Vehicle via Multi-Agent Reinforcement Learning}, 
  year={2025},
  volume={},
  number={},
  pages={5305-5311},
  abstract={The application of single agent reinforcement learning faces significant challenges in coordinated decision-making of heading and morphing for morphing reusable launch vehicles. By applying mutli-agent reinforcement learning, this paper proposes a coordinated decision-making method that is capable of determining heading and morphing command simultaneously. Firstly, the coordinated decision-making framework is established specifically for the morphing reusable launch vehicle. The heading and morphing decision-making agents are designed to execute the mission of reaching designated location and avoiding no-fly zones along trajectory. A multi-stage training strategy is developed to accelerate the training process. Simulation results show the effectiveness and superiority of the proposed method over the coordinated decision-making method based on single agent reinforcement learning. Compared with the fixed-wing reusable launch vehicle, the morphing reusable launch vehicle with the proposed method performs less number of bank angle reversal.},
  keywords={Training;Simulation;Decision making;Reinforcement learning;Trajectory;Vehicle dynamics;Faces;Convergence;Coordinated decision-making;Heading control;Morphing strategy;Multi-agent reinforcement learning;Morphing reusable launch vehicle},
  doi={10.1109/CCDC65474.2025.11090906},
  ISSN={1948-9447},
  month={May},}@INPROCEEDINGS{1234185,
  author={Chen, J.C. and Wang, C.C. and Taggart, D. and Ditata, E.},
  booktitle={2003 IEEE Aerospace Conference Proceedings (Cat. No.03TH8652)}, 
  title={Modeling an off-nominal launch vehicle trajectory for range safety link analysis}, 
  year={2003},
