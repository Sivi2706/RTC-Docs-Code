  number={},
  pages={323-348},
  abstract={This chapter contains sections titled: Introduction, Electronic modeling of differentiation and integration, The capacitor as differentiator and integrator, Amplification, Differentiators and integrators, Electronic modeling of differential equations, Multiplier, square, and cube devices, Divider, Square root device, Device for modeling arbitrary functions, The A4 rocket, Equations of motion and control of the rocket, Remote control of the rocket, Automatic guidance of the rocket, The “Mischgerät”, Conclusion},
