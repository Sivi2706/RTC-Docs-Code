  year={2013},
  volume={32},
  number={5},
  pages={38-44},
  abstract={The software performing navigation, guidance, control, and mission-sequencing functionalities embedded in the flight computer system (FCS) of a satellite launch vehicle must be highly dependable. The presence of faults in the embedded flight software affects its dependability and may even jeopardize the entire mission, resulting in a huge loss to the space agency concerned. There are many techniques available to achieve high dependability and can be classified under fault avoidance, fault removal and fault tolerance.},
  keywords={Satellites;Software engineering;Navigation;Space missions;Aeronautics engineering},
  doi={10.1109/MPOT.2012.2236150},
