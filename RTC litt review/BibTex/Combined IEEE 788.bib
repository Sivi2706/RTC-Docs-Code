  volume={40},
  number={6},
  pages={1989-1997},
  abstract={The Stretched Rohini Satellite Series-C (SROSS-C) was launched into a near-Earth orbit by the Indian Augmented Satellite Launch Vehicle (ASLV-D3) on May 20, 1992. A gamma ray burst (GRB) experimental package for detecting and measuring temporal and spectral characteristics of celestial GRBs was one two main payloads onboard SROSS-C. A microprocessor-based electronics unit was designed and developed for payload data handling, control of payload operation in different modes, and telemetering burst data to ground stations. The electronic instrumentation functioned well during mission lifetime. The electronic instrumentation and its satisfactory performance during the mission period are presented.<>},
  keywords={Instruments;Gamma ray bursts;Payloads;Satellites;Vehicles;Electronics packaging;Gamma ray detection;Gamma ray detectors;Extraterrestrial measurements;Data handling},
  doi={10.1109/23.273454},
  ISSN={1558-1578},
  month={Dec},}@INPROCEEDINGS{6232512,
  author={Bertrand, A. and Schaffar, A. and Gineste, P. N.},
  booktitle={2012 ESA Workshop on Aerospace EMC}, 
  title={Extension of the qualification range of the ARIANE 5 launcher to the radiated electromagnetic transmissions of the satellites operating in Ka band}, 
  year={2012},
  volume={},
  number={},
  pages={1-6},
  abstract={The present paper highlights the main results of a study aiming at extending the qualification range of the ARIANE 5 launcher with respect to the electromagnetic radiated emissions at the payloads/launcher interface in the Ka band (18-40 GHz). This study comes as an answer to the evolution of the payloads' needs, which on the one hand are using this frequency band more and more often and for which, on the other hand, the request for telemetry transmission during the launcher's flight is increasingly strong. This study has been performed in 2008/2011, in the frame of both a CNES and an ESA contracts. Several tests have been performed, at various levels, completed by some numerical modelling. The study has led to the modification of the launcher's general specification of electromagnetic compatibility.},
  keywords={Cavity resonators;Payloads;Satellites;Couplings;Electromagnetics;Antennas;Receivers},
  doi={},
  ISSN={},
  month={May},}@ARTICLE{5005394,
  author={Pelc, Christopher E.},
  journal={IEEE Aerospace and Electronic Systems Magazine}, 
  title={GPS Program Status}, 
  year={1987},
  volume={2},
  number={5},
  pages={18-21},
  abstract={The Navstar Global Positioning System (GPS) Program is composed of three segments - Space, Control, and User Equipment. The Space segment is responsible for the development and launch of the GPS satellite constellation. The Control segment is responsible for monitoring the satellite telemetry and providing updated navigation information to the satellites. The User Equipment (UE) segment is responsible for the development and procurement of the GPS receivers for a variety of host vehicle platforms. Recently, approval was given to the User segment to enter Low Rate Initial Production (LRIP). This approval marks the beginning of Phase III (production and deployment) of the GPS program. This paper will discuss the overall status of all three segments with an emphasis on the User Equipment segment as it enters the production phase of the program.},
  keywords={Global Positioning System;Reliability;Aerospace electronics},
  doi={10.1109/MAES.1987.5005394},
  ISSN={1557-959X},
  month={May},}@INPROCEEDINGS{11193279,
  author={Yue, Chenyang and Zhang, Zhixiang and Liu, Boyu and Du, Zhaoqian and Ji, Binyuan and Li, Faxin},
  booktitle={2025 5th International Conference on Computer Vision, Application and Algorithm (CVAA)}, 
  title={Optimization of Surveillance Placement in Rocket Debris Drop zone Based on Weight System and Improved NSGA-III}, 
  year={2025},
  volume={},
  number={},
  pages={292-299},
  abstract={The monitoring and timely detection of rocket debris drop are critical challenges in space launch missions, particularly when the debris guidance system malfunctions. Existing telemetry and tracking equipment are limited by distance and line-of-sight constraints, making it difficult to capture impact events. To address this issue, we propose an observation methodology for rocket debris drop zone and optimizes its deployment strategy. A distance decay-based weight system has been formulated to characterize spatial significance, followed by the establishment of a multi objective optimization model that simultaneously minimizes deployment costs, camera quantity, and maximizes weighted coverage performance. Subsequently, the Non-dominated Sorting Genetic Algorithm (NSGA-III) has been enhanced through adaptive dynamic adjustment strategies and repair operators. Finally, deployment optimization experiment was conducted on simulated scenarios. Results indicate that the improved NSGA-III demonstrates superior convergence performance, effectively escaping local optima and enhancing search efficiency while maintaining Pareto front diversity. The proposed model and methodology provide a scientifically rigorous foundation for rocket debris drop zone monitoring system design.},
  keywords={Rockets;Costs;Surveillance;Heuristic algorithms;Optimization models;Space missions;Maintenance engineering;Telemetry;Optimization;System analysis and design;surveillance placement;multi objective optimization;NSGA-III;dynamic adjustment},
  doi={10.1109/CVAA66438.2025.11193279},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{878223,
  author={Fox, J.J. and Glass, B.J.},
  booktitle={2000 IEEE Aerospace Conference. Proceedings (Cat. No.00TH8484)}, 
  title={Impact of integrated vehicle health management (IVHM) technologies on ground operations for reusable launch vehicles (RLVs) and spacecraft}, 
  year={2000},
  volume={2},
  number={},
  pages={179-186 vol.2},
  abstract={Incorporation of Integrated Vehicle Health Management (IVHM) technologies into launch vehicle and spacecraft designs offers the potential for significant savings in operations costs. IVHM has three basic objectives. First is more autonomous operation in flight and on the ground, which directly translates to reduced workload on the ground controller team through reduction of raw vehicle data into "health summary information." Next is reduced ground processing of reusable vehicles due to more performance of system health checks in flight rather than back on the ground as well as more automated ground servicing and checkout. Lastly is enhanced vehicle safety and reliability due to increased capability to monitor system health using modern sensing systems inside even the harsh environment of an engine combustion chamber as well as through prediction of pending failures. The "integrated" piece of IVHM is the total integration of flight and ground IVHM elements. The three elements of flight IVHM are advanced light weight/low power sensors, extensive real-time data processing and analysis and distributed data acquisition architecture with high-density mass storage. The two elements of ground IVHM are evolved control room architectures with advanced applications and automated ground processing systems. The status of current flight experiments on the Space Shuttle, Deep Space-1, X-33, X-34 and X-37 is presented.},
  keywords={Technology management;Remotely operated vehicles;Space vehicles;Space technology;Automatic control;Control systems;Land vehicles;Road vehicles;Mobile robots;Costs},
  doi={10.1109/AERO.2000.878223},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{1426744,
  author={Tetlow, M.R. and Schottle, U.M. and Evans, M.E. and Schneider, G.M.},
  booktitle={2004 5th Asian Control Conference (IEEE Cat. No.04EX904)}, 
  title={Performance of a predictive guidance system for booster flyback}, 
  year={2004},
  volume={2},
  number={},
  pages={745-753 Vol.2},
  abstract={The aim of this study is to develop and test a robust guidance strategy for use on the flyback mission of a winged launch booster. The guidance system employs a numerical Newton-Raphson restoration technique to update steering parameters, coupled with heuristic logic, to improve robustness. The guidance system uses a prediction of the final state of the launch vehicle to close the feedback loop and is therefore called "predictive guidance".},
  keywords={Navigation;Vehicles;Robustness;Wind speed;Computer errors;Costs;Australia;Space technology;System testing;Virtual environment},
  doi={},
  ISSN={},
  month={July},}@INPROCEEDINGS{8985514,
