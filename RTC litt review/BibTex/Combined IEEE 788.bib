  booktitle={2019 IEEE 13th International Conference on Telecommunication Systems, Services, and Applications (TSSA)}, 
  title={Prototype of CanSat with Auto-gyro Payload for Small Satellite Education}, 
  year={2019},
  volume={},
  number={},
  pages={243-248},
  abstract={This paper is about structure and payload for CanSat. The structure on CanSat must fit on a space rocket and protect the payload from all disruption. The structure made from PLA+ carbon fiber that makes it light and strong. On the structure, there is a blade for descent control that makes CanSat down slowly. The payload on CanSat was chosen by a mission that CanSat brings a sensor accurately. Mission on this CanSat is descent control with science payload. The payload that fit with structure and can operate well. The main contribution of this paper is a proposed structure and payload that can be a reference for other CanSat. Our results on this research are structure and payload can operate the mission with small damage on structure.},
  keywords={Temperature sensors;Optical fiber sensors;Temperature distribution;Atmospheric measurements;Atmospheric modeling;Small satellites;Telecommunications;Telemetry;Carbon;Payloads;CanSat;Structure;Payload;Mission},
  doi={10.1109/TSSA48701.2019.8985514},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{8554434,
  author={Krishnan, Ranjani and Lalithambika, V R},
  booktitle={2018 International Conference on Advances in Computing, Communications and Informatics (ICACCI)}, 
  title={A Comparison of AFDX and 1553B Protocols Using Formal Verification}, 
  year={2018},
  volume={},
  number={},
  pages={1617-1623},
  abstract={Safety critical systems like aircrafts, launch vehicles and satellites require a reliable communication protocol to guarantee their functioning without errors. Equally important is the validation and verification of the hardware and software in such systems to avoid unexpected faults during flight. A comparison of two widely used standards, AFDX and MIL-STD- 1553B, is attempted through formal verification in this work. The robustness of AFDX protocol, used in aviation, is validated by model checking with SPIN. Similarly, the MIL-STD-1553B protocol, widely used in the launch vehicle arena, is modelled and verified using SPIN. Each element in both protocols is represented as a process, along with necessary channels and timing parameters, and random errors are simulated. The required specifications are modelled using equivalent Linear Temporal Logic (LTL) properties. On simulation and verification, some of the properties are violated for AFDX, while all the properties are found to be satisfied for the 1553B model, thus proving the robustness of the 1553B protocol and its suitability for aerospace and military applications.},
  keywords={Protocols;Aerospace electronics;Military standards;Transmitters;Receivers;Reliability;Standards organizations;Safety critical systems;Aircraft;Launch Vehicle Avionics;Embedded Software;Communication Protocol;AFDX protocol;MIL-STD-1553 standard;SPIN model checker;Verification;LTL},
  doi={10.1109/ICACCI.2018.8554434},
  ISSN={},
  month={Sep.},}@ARTICLE{8766187,
  author={Muraleedharan, Deepa and Haridasan, Priya and Samad, A.K. Abdul and Varier, G. Subha and Vinod, P.},
  journal={IEEE Aerospace and Electronic Systems Magazine}, 
  title={Reconfigurable Wavelet Based Real Time Imaging System for Low Bit Rate Telemetry Space Missions}, 
  year={2019},
  volume={34},
  number={5},
  pages={22-29},
  abstract={The design of a Wavelet -based Imaging System for Space missions is discussed in this paper. Capturing images of interest in launch vehicles is a multidisciplinary area involving teams from various branches of engineering; however, this paper specifically focuses on the design of the space -qualified imaging system that can work at low bit rates. The features of the system, design of various parameters, compression algorithm and its parameter selection, tests carried out to make the system space worthy are explained. The system is being used in various missions of ISRO to capture multiple events of interest. Finally, this paper shows some examples of the successful application of this system to recent missions.},
  keywords={Cameras;Image coding;Real-time systems;Telemetry;Transform coding;Streaming media},
