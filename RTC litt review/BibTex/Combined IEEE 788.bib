  year={2012},
  volume={},
  number={},
  pages={1-4},
  abstract={The frequency requirements of the spacecraft TT&C(Tracking, Telemetry & Command) are growing rapidly. The frequency utilization is faced with the situation of large numbers of wireless devices on the satellites and launch vehicle, the wide occupied band, narrow frequency band interval. The frequency bands allocated to the space operation service are becoming more congested. For using frequency more efficiently, satisfying the electromagnetic compatibility (EMC) among the satellite, the launch vehicle and the earth stations, the unwanted emission suppression applying to the different modulation and data rates is presented. The new unwanted emission masks take into account the modulation, data rate, the actual filtering capabilities of the system and will decrease the required guard bandwidth to the adjacent band users.},
  keywords={Bandwidth;Frequency modulation;Attenuation;Frequency domain analysis;Space vehicles},
  doi={10.1109/ICEF.2012.6310335},
  ISSN={},
  month={June},}@INPROCEEDINGS{9528089,
  author={Gopan, Indu and S, Muhammed Suhail and Joy, Sherly and KK, Mukundan},
  booktitle={2021 8th International Conference on Smart Computing and Communications (ICSCC)}, 
  title={A Novel Approach to Solve Sporadic Interrogation in Tracking System during Transonic Ascent Flight of Satellite Launch Vehicles}, 
  year={2021},
  volume={},
  number={},
  pages={124-128},
  abstract={Tracking a launch vehicle is of paramount importance, not only for knowing the instantaneous position of the vehicle, but also for taking appropriate and critical real time decisions related to Range safety. Tracking System also provides antenna positioning information for Telemetry, Telecommand and Optical Tracking stations. Active tracking systems consisting of C Band Radar ground station and onboard C Band Transponder provide the necessary input data in real time to the Range Safety Officer for taking necessary decisions. In the ascent phase of Launch Vehicle mission, during the transonic regime, sporadic interrogation is registered on onboard C-Band Transponders and large number of extra echo pulses are observed on Radar displays. Large fluctuations are also observed in signals received onboard and at ground during this time period. Response of the onboard transponders to the additional interrogation pulses lead to the original uplink pulse being missed, thereby causing loss of track by Radars. This paper discusses on the tracking system, the observations during transonic regime, its analysis and the unique solution implemented. Pulse position coding technique has been successfully employed in a novel way in the tracking system to overcome the difficulties caused due to erroneous interrogation and the design has been effectively demonstrated in flight.},
  keywords={C-band;Spaceborne radar;Scattering;Radar tracking;Real-time systems;Encoding;Safety;mach;Prandtl-Glauert singularities;pulse position coding;radar;sporadic interrogation;tracking system;transonic regime;transponder},
  doi={10.1109/ICSCC51209.2021.9528089},
  ISSN={},
  month={July},}@INPROCEEDINGS{9843477,
  author={Wheeler, Cody and Berg, Peter and Ricks, Mason and Jinright, Ashley and Millar, Chandler and Lane, Tristan},
  booktitle={2022 IEEE Aerospace Conference (AERO)}, 
