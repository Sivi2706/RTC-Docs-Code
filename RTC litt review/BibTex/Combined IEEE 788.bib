  title={Command guidance of Telstar launch vehicle}, 
  year={1963},
  volume={42},
  number={5},
  pages={2153-2168},
  abstract={The Telstar I satellite was launched into orbit by a three-stage Delta launch vehicle guided by the Bell Telephone Laboratories command guidance system. The Delta program is a National Aeronautics and Space Administration sponsored series of missile flights designed to place various scientific payloads into orbit around the earth. This paper discusses the theory of the guidance equations employed by the command guidance system in the Delta program},
  keywords={},
  doi={10.1002/j.1538-7305.1963.tb00962.x},
  ISSN={0005-8580},
  month={Sep.},}@INPROCEEDINGS{5959044,
  author={Sreelal, S. and Varghese, Bibin},
  booktitle={2011 International Conference on Electronic Devices, Systems and Applications (ICEDSA)}, 
  title={Frequency domain adaptive sampling technique for aerospace instrumentation and telemetry applications}, 
  year={2011},
  volume={},
  number={},
  pages={286-289},
  abstract={Adaptive sampling is a signal processing technique that has been widely employed in the fields of audio coding and sensor networking. A manifestation of the technique for instrumentation and telemetry applications wherein the signal is down-sampled based on frequency domain analysis is described here. The implementation of the technique at system level is explained and the hardware configuration and software flow needed to support it are illustrated. Two applications of the technique viz. data compression and health monitoring are then described in the context of aerospace instrumentation and telemetry systems. The enhancement in efficiency that it enables for data synthesis and analysis is brought out.},
  keywords={Frequency domain analysis;Telemetry;Adaptive systems;Data compression;Digital signal processing;Vehicles;Time domain analysis;Adaptive Sampling;Instrumentation;Frequency domain;Data Compression;Vehicle Health Management},
  doi={10.1109/ICEDSA.2011.5959044},
  ISSN={2159-2055},
  month={April},}@INPROCEEDINGS{9045028,
  author={Wang, Ying and Lu, Juan and Hao, Chen and Wang, Haibing and Zhou, Qihang},
  booktitle={2018 Eighth International Conference on Instrumentation & Measurement, Computer, Communication and Control (IMCCC)}, 
  title={Applicable to Launch Vehicle Data Integrated Design Method of Wireless Sensor Network Research}, 
  year={2018},
  volume={},
  number={},
  pages={221-225},
  abstract={Wireless sensor network technology is one of the computer science technologies developing rapidly in recent years. Based on advantages of flexibility in network topology technology, intelligent in data acquisition, low power consumption in network operation, wireless sensor network is used to obtain the carrier rocket test in the process of flight data has become the research emphasis in the field of aerospace test. This paper mainly introduces the rocket wireless sensor network topology, data synchronously in the network, integrated transmission encoding and redundancy, and provides technical support for engineering application.},
  keywords={Wireless sensor networks;Rockets;Protocols;Power demand;Network topology;Redundancy;Encoding;Robustness;Topology;Telemetry;Wireless sensor network;Integrated transmission encoding;Data synchronously;Carrier rocket},
  doi={10.1109/IMCCC.2018.00054},
  ISSN={2373-6844},
  month={July},}@INPROCEEDINGS{11564506,
  author={Wang, Wenbo and Yang, Jing and Fang, Yu and Li, Wenquan},
  booktitle={2026 5th International Conference on Electronics, Integrated Circuits and Communication Technology (EICCT)}, 
  title={Research on Dynamic Preprocessing and Collaborative Filtering Methods for Rocket Flight Telemetry Data}, 
  year={2026},
  volume={},
  number={},
  pages={1123-1128},
  abstract={Rocket flight telemetry data is known for its high dimensionality, strong nonlinearity, dynamic time variation, and significant noise interference. This paper focuses on the data preprocessing stage and proposes a dynamic preprocessing and collaborative filtering method. The method consists of three main parts. First, an improved dynamic time warping algorithm is introduced. By incorporating the Itakura parallelogram constraint and an adaptive window mechanism, accurate alignment of asynchronous multi-sensor data is achieved. Second, a wavelet Kalman collaborative filtering framework is constructed. The adaptive wavelet denoising part uses a dynamic threshold, while the Kalman filter part integrates a rocket dynamics model. This forms a processing chain of frequency domain denoising followed by time domain estimation, allowing the complementary strengths of the two filtering techniques to be fully utilized. Third, a multi-parameter fusion decision state machine is introduced. This enables adaptive adjustment of filtering parameters according to different flight phases such as liftoff, booster separation, and attitude adjustment. Experimental results on a simulated rocket flight telemetry dataset show that the average time series alignment error is reduced by 42.3 percent, the signal to noise ratio is improved by 4.6 dB, and the data quality score increases by 18.7 percent. Furthermore, the computational efficiency is improved by 35.2 percent compared to traditional methods. This method provides reliable data support for subsequent rocket flight parameter analysis and anomaly detection.},
  keywords={Timing;Rockets;Kalman filters;Noise reduction;Filters;Signal to noise ratio;Filtering;Noise;Telemetry;Equations;Rocket Telemetry Data;Dynamic Time Warping;Wavelet Kalman Collaborative Filtering;Adaptive Filtering;Data Preprocessing},
  doi={10.1109/EICCT69950.2026.11564506},
  ISSN={},
  month={April},}@INPROCEEDINGS{9665182,
  author={Nugroho, Larasmoyo and Andiarti, Rika and Akmeliawati, Rini and Juliarsyah, Rizanto M. and Khoifan, Abdul and Prayogo, Yulian Surya and Wijaya, Sastra Kusuma},
  booktitle={2021 IEEE International Conference on Aerospace Electronics and Remote Sensing Technology (ICARES)}, 
  title={Visually Augmented Guidance System Realization for Landing Rocket Model}, 
  year={2021},
  volume={},
  number={},
  pages={1-7},
  abstract={UAV's auto landing based on GPS data is considered to be unprecise, because GPS inaccuracy is inherently attributed to the low rate of satellite signal update. Besides of that, GPS data does not pay attention to the condition of the area and allows landing in any hazardous place. The visually augmented precision landing (VAPL) guidance system proposed in this paper guides the landing rocket model (LRM) to conduct vertical-takeoff vertical-landing (VTVL) maneuvers by fusing data from vision sensors, GPS and even ultrasonic as navigational aids. This system uses the MAVlink protocol to communicate data between the sensor board and the flight controller. The difficulty of tracking object using visual sensor is caused by many factors i.e. light intensity, color saturation, parallax, and aspect angle segmentation. This paper addresses those obstacles by refining calibration procedure and replace area segmentation method to proportional feedback method. Unwanted inverted flight response could be dealt with the improved program algorithm. The results show that the proportional feedback method approach can reduce the error in area segmentation method significantly, from 100% error to maximum value of accuracy up to 80%. In this study, the landing rocket model could land on the target, but data errors still exist due to the mistakes produced by the sensor vision when focusing on the target while discriminating it from the larger block area. The miss distance between the LRM to the target is approximately 1 meter. Therefore, the proposed VAPL could be considered more precise than a solely GPS-guided landing system that has average miss distance 3 meters.},
  keywords={Meters;Rockets;Visualization;Satellites;System realization;Vision sensors;Cameras;landing rocket model;visual imaging sensor;precision landing guidance system;MAVlink protocol;flight controller},
  doi={10.1109/ICARES53960.2021.9665182},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11320151,
  author={Gong, Lvjie and Li, Yihong and Jia, Weimin and Zhao, Jianwei and Jin, Wei},
  booktitle={2025 International Conference on Electronic Information, Computer and Aerospace Remote Sensing (EICARS)}, 
  title={Joint Telemetry Modulation Scheme with LDPC Coding-Based 16QAM-COFDM for the Aerospace Telemetry System}, 
  year={2025},
  volume={},
  number={},
  pages={54-60},
  abstract={In order to address the challenges of limited spectrum resources and insufficient anti-interference capability in aerospace telemetry systems, we proposes a 16QAM-COFDM joint telemetry modulation scheme with LDPC coding. Firstly, OFDM technology is exploited with the 16QAM signal model, to disperse the signal across a series of mutually orthogonal narrowband subcarriers, which enables flexible adaptation to different frequency band resource. Then, LDPC channel coding is uitilized to improve the system's interference resistance and transmission reliability, which substantially reduces the computational complexity of encoding and decoding by the sparse parity-check matrix. Finally, various simulation tests are conducted to verify the effectiveness of the proposed method. Simulation results demonstrate that the proposed modulation scheme significantly enhances the spectral efficiency and reliability of information transmission, which provides technical support for telemetry systems in diverse scenarios such as high-orbit satellites, deep-space probes, and near-Earth spacecraft.},
  keywords={Wireless communication;Satellites;Spectral efficiency;Simulation;OFDM;Parity check codes;Telemetry;Reliability;Computational complexity;Channel coding;Space telemetry systems;16QAM-COFDM;LDPC coding;Spectral efficiency;Transmission reliability},
  doi={10.1109/EICARS68214.2025.11320151},
