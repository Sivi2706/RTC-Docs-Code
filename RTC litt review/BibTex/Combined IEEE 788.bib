  pages={215-218},
  abstract={Cubesats have become popular and wide-spread in recent years. Since space environment differs radically from conditions on Earth and it is not possible to carry out repairs after launch, much attention must be paid to design and reliability. In present paper requirements for an electrical power supply (EPS) unit are discussed. Worst case scenarios are analyzed and possible solutions are provided. Designed and tested prototype is capable of providing power to the spacecraft even if as much as 1/2 of boards subunits are malfunctioning. Satellite carrying present design is expected to be launched in 2018.},
  keywords={Batteries;Space vehicles;Microcontrollers;Satellites;Temperature measurement;Aerospace electronics;energy harvesting;power converters;cubesats;space electronics},
  doi={10.1109/BEC.2016.7743767},
  ISSN={2382-820X},
  month={Oct},}@INPROCEEDINGS{4045642,
  author={Brusch, Richard G.},
  booktitle={1976 IEEE Conference on Decision and Control including the 15th Symposium on Adaptive Processes}, 
