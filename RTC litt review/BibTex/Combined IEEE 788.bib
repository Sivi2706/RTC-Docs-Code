  volume={},
  number={},
  pages={1-15},
  abstract={In the era of development of space technology, miniaturization plays a vital role in low cost small satellite missions. The versatile application capabilities and low cost of Pico/Nano satellites missions make them attractive for a wide scope of space exploration projects. This paper outlines the steps involved in design, development and fabrication of a Pico-satellite `STUDSAT': STUDent SATellite along with the development of ground station that is capable of communicating with STUDSAT. It elaborates upon the different subsystems in the satellite. The satellite falls in the category of pico satellites, where the mass of satellite is restricted to 1 Kg and volume to 1.1 liters. The overall dimension of the satellite is (10 × 10 × 13.5) cm. The satellite is capable of capturing images of ground resolution 90 meters at an altitude of 680 Kms. The STUDSAT was launched with ISRO's PSLV C-15 on 12th July 2010 as a secondary payload. Further, the paper elaborates on the beacon and telemetry data that were received from the satellite. The satellite mission was terminated officially after 3 months from its launch date. The paper also presents the analysis on failures that had caused early termination of STUDSAT mission.},
  keywords={Satellites;Magnetometers;Payloads;Pulse width modulation;Telemetry;Lead;Coils;Pico/Nano Satellite;Camera;Student;Launch;Space Technology;Satellite Communication System;Power System;Attitude Determination & Control System;Structure Integration},
  doi={10.1109/AERO.2011.5747469},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{11524173,
  author={Shaman, Naiyar H. and Walton, Robert O.},
  booktitle={2026 New Trends in Civil Aviation (NTCA)}, 
  title={Navigating the Future of Space Exploration: An Overview of Reusable Launch Vehicles}, 
  year={2026},
  volume={},
  number={},
  pages={325-330},
  abstract={This study provides a structured overview of reusable launch vehicles (RLVs), integrating technological, economic, and environmental perspectives based on a narrative review of 23 studies published between 2016 and 2024. The analysis identifies key advances in propulsion, thermal protection, and guidance systems that enable increasing levels of reusability and operational reliability. From an economic perspective, RLVs offer the potential to reduce launch costs through repeated use and higher flight rates, while supporting emerging business models such as Space-as-a-Service. However, their viability depends on substantial upfront investment and sustained demand. Environmental findings indicate that while reusability can reduce manufacturing impacts, increased launch frequency may offset these benefits and contribute to orbital congestion. Overall, RLVs represent a critical component of future space transportation, though challenges related to cost efficiency, sustainability, and regulation remain unresolved.},
  keywords={Electromagnetic launching;Electrothermal launching;Costing;Costs;Rockets;Modeling;Reviews;Vehicles;Sustainable development;Propulsion;reusable launch vehicles;space transportation;launch economics;propulsion systems;environmental sustainability;space policy;commercialization of space},
  doi={10.23919/NTCA68808.2026.11524173},
  ISSN={2694-7854},
  month={April},}@INPROCEEDINGS{9843280,
  author={Moore, Robert R. and Sirohi, Richa},
