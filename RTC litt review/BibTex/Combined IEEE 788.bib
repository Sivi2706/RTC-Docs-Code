  month={April},}@INPROCEEDINGS{9856370,
  author={Eramo, Vincenzo and Valente, Francesco and Lavacca, Francesco G. and Fiori, Tiziana and Papandrea, Valentino and Albano, Marta and Ciabuschi, Simone},
  booktitle={2022 IEEE 9th International Workshop on Metrology for AeroSpace (MetroAeroSpace)}, 
  title={Flexible Time Triggered Ethernet: A Cost Efficient COTS-Based Technology for the Development of Launcher Networks}, 
  year={2022},
  volume={},
  number={},
  pages={97-102},
  abstract={The future development of launch vehicles provides for an increase of operational flexibility, obtained by introducing avionics based on advanced sensing devices distributed throughout the launcher. Needs for high bandwidth communications make currently used MIL-STD-1553B not sufficient anymore, since it only offers a limited bandwidth (1 Mbps) bus solution. This work proposes a new launcher network based on Commercial-off-The-Shelf (COTS) Ethernet technology, with a bandwidth increase to at least 100 Mbps and support of safety critical for the transport of Guide, Navigation and Control (GNC) messages. The temporal requirements of the GNC messages are guaranteed by formulating an optimization problem whose objective is the minimization of the used bandwidth. The results show how the proposed solution allows for a low bandwidth consumption and the respect of the GNC messages temporal requirements.},
  keywords={Scheduling algorithms;Navigation;Bandwidth;Ethernet;Aerospace electronics;Network architecture;Delays;Flexible Time Triggered Ethernet;TTEthernet;Optimization Problem},
  doi={10.1109/MetroAeroSpace54187.2022.9856370},
