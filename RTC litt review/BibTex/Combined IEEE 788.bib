  isbn={9781119772156},
  url={https://ieeexplore.ieee.org/document/9966280},}@INPROCEEDINGS{10542892,
  author={Hu, B. and Feng, K. and Li, L.},
  booktitle={3rd International Conference on Mechanical, Aerospace and Automotive Engineering (CMAAE 2023)}, 
  title={Research and application of component-based software technology for digital flight accompaniment system}, 
  year={2023},
  volume={2023},
  number={},
  pages={325-328},
  abstract={Due to the complexity of the electrical system composition and flight missions of new-generation launch vehicles, advanced digital technology has been adopted to ensure the successful completion of rocket flight missions and the safe and stable flight during the subsequent maintenance period. This study focuses on the construction and application of a digital twin and copilot system based on digital twin technology. By constructing a digital model of the rocket, the virtual-to-real mapping is achieved through semi-physical data-driven or telemetry data-driven approaches. This provides simulation and computational support for pre-mission simulation prediction, in-flight digital copilot, and post-mission status evaluation, which is very important in ensuring flight stability and supporting the integration of experimental resources.Motivated by the emerging needs of the next generation of reusable space vehicles, an autonomous integrated guidance and control system is developed that provides a safe approach to the highly constrained and nonlinear reentry problem.},
  keywords={},
  doi={10.1049/icp.2024.0683},
  ISSN={},
  month={Dec},}@ARTICLE{259424,
  author={Lala, J.H. and Harper, R.E.},
  journal={Proceedings of the IEEE}, 
  title={Architectural principles for safety-critical real-time applications}, 
  year={1994},
  volume={82},
  number={1},
  pages={25-40},
  abstract={This paper addresses the general area of computer architectures for safety-critical real time applications. The maximum acceptable probability of failure for these applications ranges from about 10/sup /spl minus/4/ to 10/sup /spl minus/10/ per hour depending on whether it is a military or civil application. Typical examples include commercial and military aircraft fly-by-wire, full authority engine control, satellite and launch vehicle control, ground transport vehicles, etc. Realtime response requirements for these applications are also very demanding, with correct control inputs required every 10 to 100 ms, depending on the application. These dual goals of ultrahigh reliability and real-time response necessitate computer systems that are quite different from other dependable systems in their architecture, design and development methodology, validation and verification, and operational philosophy. This paper highlights these differences by describing each of these aspects of safety-critical systems. Architectural principles and techniques to address these unique requirements are described.<>},
  keywords={Application software;Computer architecture;Military aircraft;Military computing;Land vehicles;Road vehicles;Engines;Military satellites;Real time systems;Design methodology},
