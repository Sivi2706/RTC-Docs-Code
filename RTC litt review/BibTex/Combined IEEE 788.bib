  abstract={},
  keywords={Vehicle safety;Vehicle dynamics;Aerodynamics;Space vehicles;Aerospace safety;Mathematical model;Acceleration;Telemetry;Land vehicles;Road vehicles},
  doi={10.1109/AERO.2003.1234185},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{6836371,
  author={Schiller, G.J.},
  booktitle={2014 IEEE Aerospace Conference}, 
  title={Innovation at ULA- It really is Rocket Science}, 
  year={2014},
  volume={},
  number={},
  pages={1-8},
  abstract={Innovation comes in many flavors, from organizational alignment, human resources, processes that support business and product execution, and products that define the enterprise. United Launch Alliance (ULA) origins stem from Lockheed Martin and Boeing when they revolutionized global space access with the introduction of their respective Atlas V and Delta IV rockets in the formulation of the Evolved Expendable Launch Vehicle Program. The long history of innovation that resulted in these vehicles continues today at ULA, ensuring that the Atlas and Delta families will continue to provide reliable, cost-effective space transportation for decades to come. ULA overcame a variety of challenges during the process of combining people, processes, and products from two disparate and competing companies into the world-class, “one-team”, multiple product lines company that exists today. Innovation was required throughout while still leveraging 100 years of combined expertise between the two original teams. While not quite characterized as “Rocket Science”, organizational structure and extensive cross fertilization of employees evolved to fine-tune the one-team construct. Processes, analyses, and tools were evaluated, tested, and updated to ensure the final suite comprised the best-of-the-best. Continuous improvement labeled “Perfect Product Delivery” highlights ULA's focus on increasing efficiency throughout the enterprise through constant innovation. Finally, the rocket science part of the equation, ULA continues to invest in product line innovation to provide increased performance, additional capability and flexibility, and open up new and exciting markets.},
  keywords={Reliability;Games;Payloads;Transportation;Cultural differences;Engines;Decision support systems},
  doi={10.1109/AERO.2014.6836371},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{6492700,
  author={Weiqi Xie and Yuanwen Cai and Jingbo Yao and Chaojun Xin},
  booktitle={International Conference on Automatic Control and Artificial Intelligence (ACAI 2012)}, 
  title={Design and implementation of the LIMU pulse counting system}, 
  year={2012},
  volume={},
  number={},
  pages={778-781},
  abstract={The sense organs of the launch vehicle control system are of great important in maintaining the launch vehicle attitude stability. Based on the deep analysis of the digital pulse signals from the telemetry interface of laser gyroscope inertial measuring unit (Laser Gyroscope Inertial Measuring Unit-LIMU), the digital pulse signal counting system is designed based on FPGA, and the functions and components of hardware are detailed introduced. At last, the system is simulated in the Libero IDE development environment with VHDL. The results show that the system has the virtue of higher reliability, lower cost, less source requirement, shorter development cycle and has good application value.},
  keywords={Launch Vehicle Control System LIMU FPGA},
  doi={10.1049/cp.2012.1093},
  ISSN={},
  month={March},}@INPROCEEDINGS{6698498,
  author={Nurhafid, Alfi and Trilaksono, Bambang Riyanto and Sasongko, Rianto Adhy and Riyadl, Ahmad and Irwanto, Herma Yudhi},
  booktitle={2013 3rd International Conference on Instrumentation, Communications, Information Technology and Biomedical Engineering (ICICI-BME)}, 
  title={Modelling and simulation of RKX200 rocket flight dynamics}, 
  year={2013},
  volume={},
  number={},
  pages={230-236},
  abstract={In this paper, modelling and simulation of RKX200 rocket flight dynamics are presented. The dynamics model is constructed by first-principle method based on forces and moments acting the rocket rigid body. In the development of the model, the aerodynamics coefficients are determined by using missile DATCOM software. A six Degree of Freedom (DoF) nonlinear model, as well as linear decoupled longitudinal and lateral-directional models are constructed for representing the flight dynamics of the rocket. The resulting models are numerically modelled and simulated using Simulink™ while its motion visualization is constructed using FlightGear™. Further, the dynamics model and the visualization application then are integrated and tested in Hardware In The Loop Simulation (HILS) environment.},
  keywords={Aerodynamics;Rockets;Numerical models;Mathematical model;Computational modeling;Equations;modelling;HILS;flight dynamics;simulation;flightgear},
  doi={10.1109/ICICI-BME.2013.6698498},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11171127,
