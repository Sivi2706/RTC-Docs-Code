@INPROCEEDINGS{10070203,
  author={Andrade, Rodrigo and Moraes, Alison and Motta, Felipe},
  booktitle={2022 Symposium on Internet of Things (SIoT)}, 
  title={IoT-Based Sounding Rocket Telemetry System}, 
  year={2022},
  volume={},
  number={},
  pages={1-4},
  abstract={Sounding rockets are essential for scientific and technological development. They are a relatively brief and not-so-expensive form of access to space. Rocket avionics is very complex and has many interfaces with ground crews before launch. Simplifying data exchange and making it more reliable and efficient is always very important. In this work, an IOT-based telemetry system for sounding rockets is proposed. Such architecture is expected to make data exchange and launch operation more efficient. The adaptations to achieve this goal are presented as well as the results of a proof of concept carried out with Heltec's LoRa 32 radio platform. The preliminary results of this work showed that an IoT-based telemetry can be used in sounding rocket projects, being able to successfully transmit and receive data.},
  keywords={Rockets;Aerospace electronics;Social Internet of Things;Telemetry;Reliability;airborne telemetry;sounding rockets;avionics},
  doi={10.1109/SIoT56383.2022.10070203},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10946509,
  author={Liu, Ran and Lu, Manhong and Zhang, Xianhui and Yang, Wentao},
  booktitle={2024 IEEE 24th International Conference on Communication Technology (ICCT)}, 
  title={Application of TTE Bus Technology in Launch Vehicle Telemetry System}, 
  year={2024},
  volume={},
  number={},
  pages={1153-1157},
  abstract={With the gradual development of the manned lunar landing program, the new generation of launch vehicles is undertaking arduous tasks, in which the telemetry system of the launch vehicle plays a vital role in flight test and data acquisition. TTE (Time-triggered Ethernet) bus technology has gradually become an ideal choice for launch vehicle telemetry system because of its high reliability, real-time and flexibility. This paper discusses the basic principle of TTE bus technology and its specific application in telemetry system, and compares it with traditional telemetry system. Obviously, TTE bus technology not only improves the efficiency of data transmission, but also enhances the fault tolerance of the system, which provides strong support for the system control of the launch vehicle and the accurate data acquisition of each equipment. The research results show that TTE bus technology has broad application prospects in future aerospace missions.},
  keywords={Synthesizers;Data acquisition;Ethernet;Switches;Aerospace electronics;Control systems;Real-time systems;Telemetry;Synchronization;Aerospace control;Time-triggered Ethernet;telemetry system;data synthesizer;data acquisition editor},
  doi={10.1109/ICCT62411.2024.10946509},
  ISSN={2576-7828},
  month={Oct},}@INPROCEEDINGS{10009446,
  author={Pathak, Shekhar and Agarwal, Sameer and Kakumanu, Sohith and Sudhakar, Siddharth and Srinivas, G},
  booktitle={2022 6th International Conference on Electronics, Communication and Aerospace Technology}, 
  title={Design and Implementation of Flight Computer for Sounding Rockets - S3FC}, 
  year={2022},
  volume={},
  number={},
  pages={164-170},
  abstract={In sounding rockets, avionics is a vital component. Typically for sounding rockets' avionics, apogee detection, parachute deployment, and telemetry are essential functions. Any issues with avionics can pose multiple threats, potentially resulting in the loss of the entire rocket itself, if not worse. Series 3 Flight Computer (S3FC), a flight computer designed by thrustMIT, takes multiple considerations to prevent catastrophic failures, such as - neither parachute ejection event happens without ensuring that the rocket has successfully launched from the ground, the code ignores rapid fluctuations in sensor readings to avoid unintentional ejections, the Global Positioning System (GPS) location of the rocket sent to the ground station aids in avoiding contact with people during descent, telemetry uses Cyclic Redundancy Check (CRC) so that the ground station could detect if the data received is faulty, and the fabrication of the circuit board happens through commercial Printed Circuit Board (PCB) manufacturing facilities, ensuring the quality is up to the mark. The quality check during manufacturing includes verifying the usage of a suitable temperature gradient-rated material, short-circuit protection, and necessary trace tolerance. This paper aims to outline the development of a low-cost flight computer (S3FC) to achieve the above-mentioned tasks.},
  keywords={Rockets;Atmospheric modeling;Wind tunnels;Surface mount technology;Switches;Aerospace electronics;Telemetry;Recovery system;Apogee detection;Sounding rocket;Flight computer;Altimeter},
  doi={10.1109/ICECA55336.2022.10009446},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9298264,
  author={S., Sreelal and Chauhan, Akshay and S., Thiruppathirajan and Singh, Haresh Kumar},
  booktitle={2020 IEEE International Conference for Innovation in Technology (INOCON)}, 
  title={An Adaptive Signal Conditioning System for Launch Vehicle Telemetry Applications}, 
  year={2020},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper deals with the design and development of an embedded microcontroller based Adaptive Signal Conditioning System (ASCS). The system is especially relevant to applications such as launch vehicle telemetry where the number of parameters to be acquired is large as well as their types and dynamic ranges vary over a wide band. We bring out the salient aspects of the system design by way of both the hardware and software to show how it supports adaptability of all the major signal conditioning parameters such as gain, offset and bandwidth. The test results are also brought out to establish the system functionality. Its application potential is then discussed to show the advancement that it offers for telemetry in the context of advanced Space Transportation Systems and next generation missions such as Reusable Launch Vehicles and Human Space Flight.},
  keywords={Telemetry;Bandwidth;Microcontrollers;Software;Adaptive systems;Bridge circuits;Aerospace electronics;Adaptive;Signal Conditioning;Gain;Offset;Bandwidth;Telemetry Systems},
  doi={10.1109/INOCON50539.2020.9298264},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{9853385,
  author={Li, Pengcheng and Chen, Haidong and Li, Shipeng and Qi, Junqing and Lian, Yanze},
  booktitle={2022 International Conference on Computer Engineering and Artificial Intelligence (ICCEAI)}, 
  title={Research on Intelligent Anomaly Detection Algorithm of Launch Vehicle Telemetry Data}, 
  year={2022},
  volume={},
  number={},
  pages={760-764},
  abstract={In the field of launch vehicles, high launch density, heavy work intensity and large data volume have brought the traditional automatic anomaly detection with incomplete coverage, and complex design of criterion, which influencing performance evaluation of launch vehicle. In order to fully mine the data variation law implied in the massive telemetry data, the intelligent anomaly detection algorithm is proposed and designed as a beneficial supplement to the traditional anomaly detection algorithm, and improve the anomaly detection coverage and efficiency. With the telemetry data generated by the liquid launch vehicle taken as the research object, and the intelligent anomaly detection algorithm is compared with the traditional algorithm. It is shown that the algorithm proposed adapts to the anomaly detection scenarios with frequency anomaly and frame loss, which may be difficult for traditional algorithms to design anomaly detection criteria, and the average anomaly detection performance is improved by nearly 30% and the variance is reduced by 85%, providing a reference for improving anomaly detection system and applying intelligent anomaly detection algorithms in aerospace.},
  keywords={Performance evaluation;Liquids;Neural networks;Stacking;Interference;Telemetry;Artificial intelligence;launch vehicle;stacking;anomaly detection},
  doi={10.1109/ICCEAI55464.2022.00160},
  ISSN={},
  month={July},}@INPROCEEDINGS{6576044,
  author={Vidya, L and Vivekananad, V and ShyamKumar, U. and Mishra, Deepak and Lakshminarayanan, R.},
  booktitle={2013 Annual International Conference on Emerging Research Areas and 2013 International Conference on Microelectronics, Communications and Renewable Energy}, 
  title={Feasibility study of applying compressed sensing recovery algorithms for launch vehicle telemetry}, 
  year={2013},
  volume={},
  number={},
  pages={1-4},
  abstract={Compressed Sensing (CS) is a new signal acquisition technology that enables the reduction in the number of measurements required for recovery of sparse or compressible signal in some basis. Signal recovery is carried out with the help of optimization techniques. Here we are conducting a review of some of these algorithms and trying to find the best algorithm to make use of that in launch vehicle telemetry system.},
  keywords={Matching pursuit algorithms;Telemetry;Least squares approximations;Compressed sensing;Vectors;Approximation algorithms;Compressed Sensing (CS);Artificial Neural Network (ANN);recovery precision;convergence rate;measurement matrix;III generation Launch Vehicle (LVM3);Telemetry},
  doi={10.1109/AICERA-ICMiCR.2013.6576044},
  ISSN={},
  month={June},}@INPROCEEDINGS{11239995,
  author={Zhi, Quanquan and Guo, Jieyu and Yuan, Hao and Yang, Xinyu and Ren, Cong},
  booktitle={2025 International Conference on Equipment Intelligent Operation and Maintenance (ICEIOM)}, 
  title={An Anomaly Analysis Method for Rocket Telemetry Data Based on SincNet-LSTM}, 
  year={2025},
  volume={},
  number={},
  pages={1479-1485},
  abstract={Combining the respective advantages of the SincNet neural network and the Long Short-Term Memory (LSTM) network, an anomaly analysis method for rocket telemetry data based on SincNet-LSTM is proposed. SincNet is utilized to precisely identify and extract feature vectors from the time-series structure of rocket telemetry data. The feature vectors output by the SincNet layer, along with the corresponding target vectors, are used as inputs. After training the LSTM network model, prediction results are obtained. The average error between the prediction results and the original data is calculated. Then, based on a non-parametric threshold calculation method, a threshold is determined to judge whether the telemetry data is anomalous, ultimately achieving rocket anomaly detection. The feasibility and effectiveness of the SincNet-LSTM analysis method are verified using telemetry data from a certain type of rocket.},
  keywords={Training;Rockets;Neural networks;Predictive models;Feature extraction;Vectors;Telemetry;Long short term memory;Anomaly detection;Testing;LSTM;rocket telemetry data;anomaly detection;trend forecasting},
  doi={10.1109/ICEIOM65271.2025.11239995},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{7180721,
  author={Poli, Matteo and Bressanin, Nicola and Madonna, Alberto and Pezzato, Mattia and Di Iorio, Eugenio and Mastrangelo, Andrea and Rodighiero, Federico and Venturelli, Giovanni and Debei, Stefano and Bettanini, Carlo},
  booktitle={2015 IEEE Metrology for Aerospace (MetroAeroSpace)}, 
  title={A sounding rocket as a test bench for cost effective measurements: Development of a sounding rocket demonstrator test bench for aerospace technologies and atmospheric measurements}, 
  year={2015},
  volume={},
  number={},
  pages={574-579},
  abstract={The Nimbus Project team, made of young engineers and university students, has developed a sounding rocket with the main aim to engineer a reusable, cost-effective test bench. This makes it possible to field test many aerospace technologies as guidance or reentry systems, enable airborne atmospheric measurements and high altitude students' experiments. The modular architecture allows the use of different payloads, composite material structures increase lightness while off-the-shelf components reduce costs; ease of transportation and usability qualify it as an extremely versatile platform. The system is scalable to carry heavier payloads and to perform scientific tests at higher altitudes. The technology demonstrator is going to reach an altitude of 1000m with cost-effective technology and components. Demonstrator's subsystems (rocket motor, main frame, chute deploy system, etc) have been both ground and flight tested and have shown an optimal accordance between theoretical model and testing. The demonstrator launch took place on 29th March 2015.},
  keywords={sounding rocket;rocket propulsion;cost-effective;atmospheric measurements;modular architecture;reusable},
  doi={10.1109/MetroAeroSpace.2015.7180721},
  ISSN={},
  month={June},}@INPROCEEDINGS{9726417,
  author={Beegum, S. Femina and Joseph, Manoj and Joyas, Saji and Mukundan, K.K.},
  booktitle={2021 IEEE Indian Conference on Antennas and Propagation (InCAP)}, 
  title={Circularly Polarized Compact Wideband Microstrip Patch Antenna for Launch Vehicle Telemetry Applications in S Band}, 
  year={2021},
  volume={},
  number={},
  pages={942-945},
  abstract={This paper presents a dual feed Circularly Polarized Compact Wideband Microstrip Patch Antenna for Launch Vehicle Telemetry Applications in S Band. The proposed dual polarized antenna employs a stripline quadrature hybrid coupler and has a 10dB impedance bandwidth of 930MHz (37%) from 2.08GHz to 3.00GHz while the 3dB axial Ratio bandwidth is 540MHz (22%) from 2.13GHz to 2.67GHz. The antenna has a maximum gain of 7.00dBi with 0.5dBi variation over the 3dB axial ratio bandwidth. The quadrature hybrid based design of the antenna using RT/Duroid 6002 substrate allows its use as either RHCP antenna or LHCP antenna.},
  keywords={Satellite antennas;Patch antennas;Stripline;Microstrip antennas;Telemetry;Microstrip;Impedance;S band;launch vehicle telemetry;quadrature hybrid;stripline coupler;wideband antenna;circularly polarized antenna;RT/Duroid;space application},
  doi={10.1109/InCAP52216.2021.9726417},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9198525,
  author={Beegum, S. Femina and Chacko, Thomas and Mukundan, K.K.},
  booktitle={2020 IEEE International Conference on Electronics, Computing and Communication Technologies (CONECCT)}, 
  title={Analysis of S Band Antenna Switching Schemes for Launch Vehicle Telemetry Applications}, 
  year={2020},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents the analysis of different types of antenna switching schemes for launch vehicle telemetry applications at S band. Performance comparison based on antenna coverage factor is carried out for six different configurations with and without antenna switching. The switching schemes employ either two or four antenna elements. The design of S band Microstrip patch antenna, which is used as basic antenna element for all these analysis, is also presented. This antenna has 6.7dB simulated gain at 2.25GHz and 10 dB bandwidth of 162 MHz, centered at 2.266 GHz. The gain analysis for all configurations is carried out at 2.25GHz. The configuration with four antenna elements and 4 Way switching shows the best performance based on coverage factor.},
  keywords={Switches;Antenna radiation patterns;Microstrip antennas;Gain;Telemetry;Microstrip;Antenna coverage factor;Antenna switching;Launch vehicle;Microstrip antenna;Telemetry},
  doi={10.1109/CONECCT50063.2020.9198525},
  ISSN={},
  month={July},}@INPROCEEDINGS{185914,
  author={Fateih, S.},
  booktitle={IEEE PLANS 92 Position Location and Navigation Symposium Record}, 
  title={Telemetry package for Super Loki sounding rocket}, 
  year={1992},
  volume={},
  number={},
  pages={558-},
  abstract={Summary form only given. Given the special requirements of the payload area of the Super Loki sounding rocket the author examines two options for the telemetry package. The first option consists in relying totally on GPS (Global Positioning System) antenna and a translator attached to the vehicle. This translator will continuously download the navigation messages picked from GPS satellites to a ground station. On the ground these navigation messages can be analyzed. The second option consists in using commercially available small accelerometers or gyroscopes to develop a quasi-inertial navigation unit. This unit either processes the accelerometer's output onboard or downloads it to a ground station for further analysis. A comparative study has been performed to analyze these two options to select the optimal in terms of weight, performance, and cost. The development and design of systems, subsystems, and components required to build a prototype has also been considered.<>},
  keywords={Telemetry;Packaging;Rockets;Global Positioning System;Satellite navigation systems;Satellite ground stations;Payloads;Vehicles;Accelerometers;Gyroscopes},
  doi={10.1109/PLANS.1992.185914},
  ISSN={},
  month={March},}@INPROCEEDINGS{7573250,
  author={Poli, Matteo and Madonna, Alberto and Pezzato, Mattia and Trevisi, Filippo and Di Iorio, Eugenio and Scalzi, Davide and Nalin, Francesco and Debei, Stefano and Bettanini, Carlo},
  booktitle={2016 IEEE Metrology for Aerospace (MetroAeroSpace)}, 
  title={Improving a sounding rocket technology demonstrator for experimental measurements}, 
  year={2016},
  volume={},
  number={},
  pages={408-412},
  abstract={Sounding rockets are a widely used test bench in the aerospace field that allow the testing of a huge quantity of products, parts ed experiments. However they are often expensive and require a long development cycle before launch. In this scenario, the Nimbus project team has developed a sounding rocket with the main purpose of engineering a reusable, cost-effective test bench, which is scalable to carry heavier payloads. It has already flown multiple times and, since the first version of the rocket, many upgrades have been introduced in order to improve its performances. To demonstrate its reusability in a short time, the rocket has been launched twice in two consecutive days.},
  keywords={Rockets;Payloads;Software;Sensors;Acceleration;Accelerometers;Sounding rocket;Technology Demonstrator;Reusability;COTS;Improvements;Student},
  doi={10.1109/MetroAeroSpace.2016.7573250},
  ISSN={},
  month={June},}@INPROCEEDINGS{6281894,
  author={R., Arjun and M. I., Mohammed Shahim and Kumar G., Santhosh},
  booktitle={2012 International Conference on Data Science & Engineering (ICDSE)}, 
  title={Integrated environment for launch vehicle telemetry data management}, 
  year={2012},
  volume={},
  number={},
  pages={171-174},
  abstract={The telemetry data processing operation intended for a given mission are pre-defined by an onboard telemetry configuration, mission trajectory and overall telemetry methodology have stabilized lately for ISRO vehicles. The given problem on telemetry data processing is reduced through hierarchical problem reduction whereby the sequencing of operations evolves as the control task and operations on data as the function task. The function task Input, Output and execution criteria are captured into tables which are examined by the control task and then schedules when the function task when the criteria is being met.},
  keywords={Telemetry;Databases;Data processing;Software;Vehicles;Standards;Phase change materials;Data Management;Telemetry processing;Automation},
  doi={10.1109/ICDSE.2012.6281894},
  ISSN={},
  month={July},}@INPROCEEDINGS{11170905,
  author={S., Sreelal and S., Sajin and P., Priya and Varghese, Bibin and S., Sreekumar},
  booktitle={2025 IEEE Space, Aerospace and Defence Conference (SPACE)}, 
  title={End-to-End Reconfigurability of Avionic Systems for Space Missions}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper discusses the design and development of Avionic Systems that are amenable for reconfiguration. The avionic system for any space mission is composed of interconnected subsystems that perform a specific function that is a part of the intended functionality. For instance, the telemetry system is composed of sensors, signal conditioners, digitizers, data aggregators and RF transmitter systems that constitute the end-to-end signal chain. We examine how state-of-the-art technologies like mixed-domain VLSI and Embedded systems with advanced interfaces can be utilized for realization of all these subsystems with soft programmable features so as to render the entire system reconfigurable from end-to-end. Such a system design gives enormous advantages ranging from reuse of hardware from mission to mission to on-the-fly reconfiguration to satisfy the requirements during various phases of a specific mission. This is especially important in the context of advanced space missions like Re-entry Launch Vehicles (RLV), Space Stations and Lunar and Inter-planetary missions.},
  keywords={Space vehicles;Embedded systems;Transmitters;Space missions;Space technology;Aerospace electronics;Very large scale integration;Hardware;Telemetry;System analysis and design;Avionic Systems;Telemetry Systems;Reconfiguration;Programmable;VLSI;Embedded Systems},
  doi={10.1109/SPACE65882.2025.11170905},
  ISSN={},
  month={July},}@INPROCEEDINGS{10363529,
  author={S, Sajin and P, Priya and U S, Divya and Singh, Haresh Kumar and B, Vidya S and P M, Anand and P., Pradeep Kumar and C, Finitha K and S, Sreelal and S, Sreekumar and A K, Abdul Samad and P., Vinod},
  booktitle={2023 IEEE International Conference on Recent Advances in Systems Science and Engineering (RASSE)}, 
  title={A Miniaturised Low-Cost Telemetry System for Small Satellite Launch Vehicles}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={There is an increasing demand world over for launch services for small satellites. The Small Satellite Launch Vehicle (SSLV) of the Indian Space Research Organization (ISRO) is developed for the purpose of on-demand launching of small satellites to low earth orbit in a fast turn-around mode. The avionics system for SSLV thus needs to be low cost, miniaturized and simpler in architecture, making it amenable to mass production and fast integration. The telemetry system for SSLV is developed with a view to acquire the launch vehicle performance parameters and provide a formatted, serialized telemetry data. Low cost industrial grade, low form factor state of the art electronic components, with high level of functional integration, is used in the subsystem designs. The designs also implement processing in re-programmable Field Programmable Gate Arrays (FPGA) and use indigenous components wherever available to mitigate obsolescence-related issues. The miniaturized telemetry system has flown successfully in two missions. The flight data is analyzed and the performance of the system is normal. The new system provides a considerable reduction in size, mass, power and cost compared to the telemetry systems used in conventional launch vehicles without sacrificing the stringent performance and reliability requirements of aerospace application. This makes it a suitable candidate for future space missions like Reusable Launch Vehicle (RLV) and inter-planetary missions.},
  keywords={Space vehicles;Sigma-delta modulation;Costs;Measurement units;Space missions;Small satellites;Aerospace electronics;Telemetry System;Miniaturized Avionics;Small Satellite Launch Vehicle (SSLV);Telemetry Handler Unit (THU);Acquisition Unit (AU);Structural Measurement Unit (SMU)},
  doi={10.1109/RASSE60029.2023.10363529},
  ISSN={},
  month={Nov},}@ARTICLE{7160660,
  author={Prades, Jérémie and Ghiotto, Anthony and Kerhervé, Eric and Wu, Ke},
  journal={IEEE Antennas and Wireless Propagation Letters}, 
  title={Broadband Sounding Rocket Antenna for Dual-Band Telemetric and Payload Data Transmission}, 
  year={2016},
  volume={15},
  number={},
  pages={540-543},
  abstract={This letter presents and investigates a broadband sounding rocket antenna developed for dual-band data transmission of telemetric and payload systems. This single-element antenna permits the use of both the well-established 869.4-869.65 MHz and 2.4-2.4835 GHz frequency bands available in Europe to implement a redundant transmission of telemetric and tracking data desired for reliability. Furthermore, the available spectrum in the upper band offers a high-speed wireless link for transmitting payload data. To preserve the mechanical integrity and aerodynamics of rocket, the antenna is integrated in its nose cone. The proposed low-cost and low-weight structure is based on printed circuit board (PCB) pieces assembled in a LEGO-like manner to form a broadband three-dimensional (3-D) biconical antenna, which is fed by a diplexer integrated in its base. A prototype has been fabricated and validated using a reduced-length fuselage in a near-field measurement system.},
  keywords={Broadband antennas;Rockets;Antenna measurements;Antenna radiation patterns;Gain;Broadband communication;Biconical antenna;broadband antenna;diplexer;sounding rocket antenna;telemetry},
  doi={10.1109/LAWP.2015.2457338},
  ISSN={1548-5757},
  month={},}@INPROCEEDINGS{10649330,
  author={Ma, Yen-Huai and Lee, Kuan-Hsun and Shieh, Tzong-Hann and Yeh, Chun-Liang and Lin, Hsien-Sheng},
  booktitle={2024 IEEE International Workshop on Electromagnetics: Applications and Student Innovation Competition (iWEM)}, 
  title={Applying LoRA Communication Technology to UAV Telemetry System and Payload Design}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The UAV telemetry system is a completely independent Wireless Systems control module that can be installed into any UAV payload without interfering with other subsystems. In this paper, the telemetry system of the sounding rocket will be used as the experimental object. The telemetry system of the sounding rocket is designed into a small and lightweight control box and a lightweight launch console to facilitate testing and operation before launch. The console connects the launch pad and the sounding rocket module through LoRA communication technology. During the flight, LoRA telemetry monitoring signals can collect various rocket flight data (such as rocket body roll, pitch and yaw direction) and rocket internal function inspection and transmit it back to the base station. This paper will explain the components of the flight attitude measurement system of the sounding rocket guidance control system, and analyze and discuss the actual launch data of the sounding rocket.},
  keywords={Wireless communication;Rockets;LoRa;Inspection;Autonomous aerial vehicles;Communications technology;Telemetry;Wireless Systems;UAV telemetry system;LoRA},
  doi={10.1109/iWEM59914.2024.10649330},
  ISSN={2835-7655},
  month={July},}@INPROCEEDINGS{10612326,
  author={Renwarin, Rezki Benedikto and Prasetyo, Agus Dwi and Pascawati, Anita and Munir, Achmad},
  booktitle={2024 9th International Conference on Smart and Sustainable Technologies (SpliTech)}, 
  title={Development of Semi-Conformal Antennas for Telemetry and GPS Applications on Experimental Rocket}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The telemetry and Global Positioning System (GPS) systems are crucial for experimental rocket communication systems. Such systems need antennas to receive data and send it to the ground station. This paper deals with the development of semi-conformal antennas implementable on an experimental rocket. The proposed semi-conformal antennas are intended to work at the frequencies of 0.91 GHz and 2.45 GHz for radio telemetry, and 1.575 GHz for GPS L1. The antennas are designed on a 0.254 mm thick Rogers/Duroid 5880 dielectric substrate with the relative permittivity of 2.2 and the dimensions of $\mathbf{228.6}\ \mathbf{mm} \times \mathbf{304.8}\ \mathbf{mm}$. The characterization results show the reflection coefficients of -14.93 dB, -19.1 dB, and -23.93 dB are achieved with the -10 dB bandwidth of 2.9 MHz, 2 MHz, and 10.4 MHz at three desirable frequencies, respectively, while the isolation is less than -40 dB. Right-Hand Circular Polarization (RHCP) GPS antenna is also obtained well indicated by the axial ratio value lower than 3 dB at the frequency of 1.575 GHz. The proposed antennas have nearly omnidirectional patterns with low gain achievement.},
  keywords={Rockets;Slot antennas;Bandwidth;Reflector antennas;Reflection coefficient;Telemetry;Antennas;Conformal antenna;dual-band;GPS L1;insertion slot;telemetry;triangular antenna},
  doi={10.23919/SpliTech61897.2024.10612326},
  ISSN={},
  month={June},}@INPROCEEDINGS{9976324,
  author={Moschidis, Philippos and Bithas, Petros S.},
  booktitle={2022 Panhellenic Conference on Electronics & Telecommunications (PACET)}, 
  title={Arduino Rocket Flight Computer}, 
  year={2022},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper describes the construction of a flight computer, using a small model rocket, which is built with materials that can be easily obtained. In this context, a comparison of the flight data with those of the simulation has been performed. Based on this framework, an introduction to the flight computer will be given and then its construction together with all its sensors and its programming will be described.Moreover, a detailed analysis of the rocket used will be given. In particular, the design concept will be presented, with the help of a computer program (OpenRocket), in conjunction with the materials used, the procedure followed for its construction, and finally, the test launches carried out up to the final launch. Entering the last chapter, the flight data of the simulation will be presented, followed by the data of the launch that was carried out and analysed using a numerical computational and programming language. Finally, a comparison between the two data sets will be made.},
  keywords={Rockets;Three-dimensional displays;Computational modeling;Nose;Sensor phenomena and characterization;Programming;Data models;Arduino;Flight Computer;Matlab;Microcontroller;Project},
  doi={10.1109/PACET56979.2022.9976324},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{177140,
  author={Fernandez, M.},
  booktitle={IEEE/AIAA 10th Digital Avionics Systems Conference}, 
  title={Preliminary design results of a fault-tolerant launch vehicle guidance system}, 
  year={1991},
  volume={},
  number={},
  pages={32-37},
  abstract={Papers by M. Fernandez and D.A. Tazartes (9th Digital avionics Syst. Conf., Oct. 1990) and by D.A. Tazartes and J. Mark (9th Digital Avionics Syst. Conf., Oct. 1990), which addressed the topics of requirements architecture and implementation, provided the basis for the design of a fault-tolerant launch vehicle guidance and control system. It was stated in the two papers that the recommended fault-tolerant architecture has significant advantages compared to existing and forecasted, single-string systems. The trade-offs reported in previous papers were refined during a preliminary design effort and the resulting design is presented.<>},
  keywords={Fault tolerant systems;Vehicles;Navigation;Costs;Control systems;Process control;Availability;Portable media players;Aerospace materials;Design optimization},
  doi={10.1109/DASC.1991.177140},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10490808,
  author={Kurdianto and Salman and Rahardiyanti, Kandi and Nugroho, Yuniarto Wimbo and Laksono, Shandi Prio and Artono, Endro and Adi, Andreas Prasetya and Sudiana, Oka and Arisandi, Effendi Dodi and Jihad, Bagus Hayatul and Hakiki and Wicaksono, Bagus},
  booktitle={2023 IEEE Asia-Pacific Conference on Geoscience, Electronics and Remote Sensing Technology (AGERS)}, 
  title={Design and Testing of Data Communication System Integration on RX-450.03 Sounding Rocket}, 
  year={2023},
  volume={},
  number={},
  pages={34-42},
  abstract={The RX-450 rocket is a ballistic rocket with a diameter of 450mm. It is equipped with avionic sensors such as accelerometers and gyroscopes coupled to a microprocessor, RF systems with frequencies of 900 MHz and 2.4 GHz, and a navigation system/Global Positioning System (GPS). The objective of the research was to build a data communication system that could be attached to the rocket, and then conduct a rocket flight test to identify the characteristics of the rocket dynamics during flight. Based on the data collected, it was observed that the rocket accelerated up to 10g in the 17th second. Additionally, the GPS data was lost at 36.25 Km in the 66th second.},
  keywords={Rockets;Global navigation satellite system;Satellites;Three-dimensional displays;System integration;Aerospace electronics;Sensors;avionic system;rocket;GPS;radio},
