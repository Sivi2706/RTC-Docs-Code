  doi={10.1109/ICAC3N56670.2022.10074552},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{5966942,
  author={çelebi, Mansur and Ay, Serdar and Ibrahim, Mohammed Khalil and Aydemır, Mustafa Emre and Bensaada, Messaoud and Fernando, Lewis Hennedige Jayathu Dimuthu Kumara and Akiyama, Hiroaki and Yamaura, Shusaku},
  booktitle={Proceedings of 5th International Conference on Recent Advances in Space Technologies - RAST2011}, 
  title={Design and navigation control of an advanced level CANSAT}, 
  year={2011},
  volume={},
  number={},
  pages={752-757},
  abstract={This paper presents design and navigation control of an advanced level comeback CanSat which is going to be launched to an altitude of about 400 m using an amateur rocket from ground level. The CanSat uses advanced and ultra-light microcontroller, pressure and temperature sensors, 3-axis accelerometer, 3-axis gyro, camera, GPS, IR distance measuring sensor, and RF communication module to communicate with the ground station PC. Three actuators are considered in this work for flight and ground segments control. They are the motor driven propeller, elevator and rudder. For the flight segment, parachute and attitude control are used to control the CanSat descent rate, attitude and heading. For the ground segment control; both the propeller and the rear landing gear of the CanSat is used for heading toward a predefined location on the ground. The rear landing gear is connected to the rudder rotational axis. An indigenous navigation control and electronic circuit design with the test results also are presented in this paper.},
  keywords={Propellers;Global Positioning System;Gears;Rockets;Elevators;Testing;Servomotors;CanSat;Satellite;Rocket;Launch;Navigation Control Algorithm},
  doi={10.1109/RAST.2011.5966942},
  ISSN={},
  month={June},}@ARTICLE{273454,
  author={Sharma, M.R. and Upadhyaya, N. and Murthy, N.S. and Umapathy, C.N. and Sreenivasaiah, K.V.},
