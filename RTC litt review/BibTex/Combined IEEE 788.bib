  doi={10.1109/AERO.2003.1235195},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{1000491,
  author={Nasu, J. and Saito, K. and Kurokawa, A. and Hayashi, F. and Nakatani, I.},
  booktitle={2002 15th Optical Fiber Sensors Conference Technical Digest. OFS 2002(Cat. No.02EX533)}, 
