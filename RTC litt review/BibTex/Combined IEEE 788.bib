  abstract={This paper presents a high-performance $\mathbf{5 G} / \mathbf{6 G}$ communication framework for deep-space missions, integrating multi-level artificial intelligence (AI) to support autonomous and resilient operations beyond Earth. Unlike conceptual proposals, this framework builds upon a series of award-winning prototypes and extensive field deployments, including U.S. Army and Indo-PACOM demonstrations, with proven results in low-latency edge processing, network slicing, and distributed AI. The paper details how these technologies, validated in terrestrial and military environments, can be adapted for space applications to address challenges such as extreme latency, bandwidth constraints, environmental resilience, and mission autonomy. We present operational case studies and quantitative metrics demonstrating significant improvements in mission responsiveness, data prioritization, and autonomous reliability supported by Technology Readiness Level (TRL) assessments and experimental measurements. Critical challenges including radiation resilience, cybersecurity, and power efficiency are analyzed, alongside a practical roadmap for space deployment and future evolution toward 6G integration and federated AI learning across distributed space assets.},
  keywords={Space missions;Telemetry;Space exploration;Space technology;Aerospace and electronic systems;Aerospace engineering;Payloads;Aerospace electronics;Jamming;Military aircraft;5G/6G communication;deep-space networks;Multiaccess Edge Computing (MEC);network slicing;multi-level AI;autonomous spacecraft;distributed intelligence;deep-space communication;interplanetary networking},
  doi={10.1109/SMC-IT64853.2025.00008},
  ISSN={2836-4171},
  month={July},}@ARTICLE{11491889,
  author={Zhang, Chengjie and Fang, Zhigeng and Shi, Rui and Liu, Youpeng and Chen, Zhongwen},
  journal={IEEE Transactions on Reliability}, 
  title={Test Time Optimization for Highly Reliable Redundant Systems With Single-Machine Similarity and Nonuniform Labor-Hours}, 
  year={2026},
  volume={75},
  number={},
  pages={1744-1752},
  abstract={Reliability demonstration of highly reliable redundant systems traditionally requires large-sample, long-duration tests, resulting in prohibitively lengthy test cycles and excessive resource consumption. However, existing approaches have not fully exploited system redundancy structure and similarity to reduce test time. To address this gap, this article integrates redundancy structure, single-machine similarity, and nonuniform labor-hour information into a system-level test time minimization framework. First, an analytical expression for test time is derived by leveraging the sample-size expansion effect of redundant structures. Second, a similarity conversion coefficient is defined to incorporate single-machine similarity into the optimization model. Third, Bayesian methods are utilized to integrate prior test information. Through system-level optimization that optimally allocates reliability targets to individual units, this work achieves joint optimization of redundancy, similarity, and prior information for the first time. A case study demonstrates that the proposed approach reduces test time by up to 74% compared with conventional methods that use similarity solely for prior construction. This study provides an efficient solution for rapid reliability verification of aerospace systems, and the proposed framework is applicable to other exponential lifetime systems with redundant architectures.},
  keywords={Aerospace control;Aerospace and electronic systems;Telemetry;Missiles;Space missions;Aerospace electronics;Circuits;Printed circuits;Circuits and systems;Telemetry;High-reliability constraints;labor-hour variability;redundant systems;single-machine similarity evaluation;test time optimization},
  doi={10.1109/TR.2026.3686549},
