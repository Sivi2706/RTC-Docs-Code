  year={2022},
  volume={},
  number={},
  pages={1-10},
  abstract={The Mars Sample Return (MSR) campaign is an unprecedented attempt in the return of Martian samples back to Earth. The ascent from the surface will be performed by the Mars Ascent Vehicle (MAV), a critical element in the mission that National Aeronautics and Space Administration (NASA) Marshall Space Flight Center (MSFC) is developing. To this end, innovations in flight software development, verification, and validation are occurring. The MAV flight computer will run Core Flight System (cFS), an open-source software environment developed by NASA Goddard Space Flight Center (GSFC). NASA Marshall's MAV Mission and Fault Management (M&FM) Team has implemented an emulation of two applications of this architecture: Limit Checker and Stored Command. Using an emulation of the functionalities of these applications allows for rapid prototyping of table-based algorithms. Further, M&FM is leveraging an in-house, low-fidelity but high-throughput State Analysis Model (SAM), an integrated MATLAB Stateflow Plant and Software model. This model is run in parallel with the cFS emulation for full flyout testing of the M&FM algorithms, verification of intent of these algorithms, and for future auto-generation of application-ingestible M&FM tables. The tables can then be delivered to the MAV Flight Software (FSW) team in a seamless process, reducing the cost of traditional FSW development and the risk of starting M&FM FSW development at later points in the NASA program life cycle.},
  keywords={Space vehicles;Mars;Analytical models;Technological innovation;Space missions;NASA;Emulation},
  doi={10.1109/AERO53065.2022.9843477},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{685854,
  author={Dallas, S.S.},
  booktitle={1998 IEEE Aerospace Conference Proceedings (Cat. No.98TH8339)}, 
  title={Space Interferometry Mission}, 
  year={1998},
  volume={5},
  number={},
  pages={443-456 vol.5},
  abstract={The Space Interferometry Mission (SIM) flight system will be launched in June of 2005 into a nearly circular orbit around the Earth. A Delta II 7920 launch vehicle will boost the SIM flight system from the Vandenberg Air Force Base into Earth orbit. Over the next three months, the flight system will be calibrated and prepared for the science observation phase. During the science observation phase, data will be collected and returned from a precision optical interferometer on-board the spacecraft for five years and will enable fundamental new discoveries in both Galactic and extragalactic astronomy. SIM will perform unparalleled wide-angle astrometry with an angular accuracy of at least 4 microarcsecs (/spl mu/as), roughly a factor of 250 over the current state of the art, and narrow-angle astrometry with an angular accuracy of 0.6-1 /spl mu/as. This precision enables the measurement of distances to sufficiently bright objects in the Galaxy by direct parallax with no more than 10% error and makes possible highly accurate proper motion measurements of objects. As a consequence, SIM will allow studies of the kinematics of both isolated stars and composite systems over a large fraction of the Galaxy and of large-scale transverse motions out to 100 Mpc.},
  keywords={Space missions;Earth;Optical interferometry;Motion measurement;Space vehicles;Astronomy;Extraterrestrial measurements;Kinematics;Interconnected systems;Large-scale systems},
  doi={10.1109/AERO.1998.685854},
