  month={March},}@ARTICLE{10962340,
  author={S, Safeer S and Sreekantan, Anoop Chandrika and N., Radhika V.},
  journal={IEEE Sensors Letters}, 
  title={An Efficient Multiphase Integration-Type Linear Digital Thermistor Front-End}, 
  year={2025},
  volume={9},
  number={5},
  pages={1-4},
  abstract={This letter proffers a new integrating-type linearizing digitizer (ILD) for thermistors. The proposed ILD, in its basic form, employs an enhanced integrating-type digitizer, equipped with a couple of linearizing resistors. It works based on a novel triple-phase methodology and renders a linear direct-digital indication of temperature. The schemes use a simple architecture and do not require special parts, such as matched references and logarithmic amplifier, which are needed in prior thermistor-front-ends. Two variants of ILD, which are tailored for shorter and longer operational spans, are also discussed in this letter. The performance of the proposed schemes is analyzed and brought-forth using simulation and detailed experimental studies. Results showcase the ability of ILD (and its variant) to act as an accurate linearizing digital front-end over wide span.},
  keywords={Thermistors;Resistors;Mathematical models;Temperature;Temperature sensors;Table lookup;Switches;Accuracy;Training;Timing;Thermal sensors;integrating digitizer;interfacing electronics;linearizer;thermistor;triple-phase operation},
