  month={Oct},}@INPROCEEDINGS{6187306,
  author={Paschall, Steve and Brady, Tye},
  booktitle={2012 IEEE Aerospace Conference}, 
  title={Demonstration of a safe & precise planetary landing system on-board a terrestrial rocket}, 
  year={2012},
  volume={},
  number={},
  pages={1-8},
  abstract={The Autonomous Landing and Hazard Avoidance Technology (ALHAT) Project is a multiyear NASA technology development effort focused on A(utonomous)-GNC and sensor technology to enable safe and precise planetary landings. The culmination of this project work involves field testing of the developed technology in a relevant terrestrial environment. These tests will demonstrate the capability of the ALHAT AGNC and sensor system, raising the Technology Readiness Level (TRL), in preparation for a next generation planetary lander. With this system, a next generation lander will be capable of safe and precise landings regardless of local lighting conditions. At least two independent terrestrial rocket systems will be utilized for demonstration of aspects of the ALHAT system. This paper discusses the use of the commercial Masten Space Systems terrestrial rocket for ALHAT demonstration purposes. This demonstration is being performed through the NASA Flight Opportunities program. This Terrestrial Test Rocket (TTR) will have the ALHAT AGNC software and hardware system integrated with Masten as a secondary, independent GNC system that will fly the vehicle closed-loop through highly dynamic lunar- and Mars-like approach and landing trajectories. With the AGNC system demonstrated, advanced ALHAT sensor systems will then be incorporated with the TTR, enabling autonomous hazard detection and avoidance in conjunction with a highly precise landing. Details of the hardware and software integration process with Masten are discussed along with performance results from recent tests.},
  keywords={Vehicles;Software;Trajectory;Rockets;Hazards;Testing;Navigation},
  doi={10.1109/AERO.2012.6187306},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{10441654,
  author={Sharma, Harsh and Sehgal, Abhinav and Jindal, Harsh and Dutta, Aditi and Sharma, Bhawna},
  booktitle={2023 International Conference on Advanced Computing & Communication Technologies (ICACCTech)}, 
  title={Designing and Developing a CanSat for Environmental Monitoring and Scientific Exploration}, 
  year={2023},
  volume={},
  number={},
  pages={358-363},
  abstract={This research paper outlines the technical requirements for designing and building a CanSat. The CanSat must be no more than 0.700 kg and fit inside a cylindrical body with a diameter of 0.125 m and a height of 0.310 m. The container must be designed to be launched from a rocket and withstand 15 Gs of launch acceleration and 30 Gs of shockwaves. The CanSat must include essential sensors and provide real-time data on position, altitude, pressure, temperature, orientation, and power information. It must also be designed with a readily accessible battery compartment and a descent control system that includes a first parachute and a second descent control device. Communications must be established through the use of an XBEE radio, and the ground station must be designed and operated by the team. Additionally, the CanSat must be designed to aid recovery and have an external power switch with an indicator light or sound for turning on or off. Overall, this research paper provides a comprehensive guide for designing and building a CanSat that meets all of the requirements for participation in an Indian competition. By following these guidelines, teams can ensure that their CanSat is safe, reliable, and capable of providing real-time data during flight.},
  keywords={Temperature sensors;Technical requirements;Temperature distribution;Buildings;Turning;Real-time systems;Telemetry;telemetry;sensor subsystem;flight and ground subsystem;CanSat design;descent},
  doi={10.1109/ICACCTech61146.2023.00065},
