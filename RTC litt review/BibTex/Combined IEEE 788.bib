  isbn={9781468607123},
  url={https://ieeexplore.ieee.org/document/11118985},}@INBOOK{9966280,
  author={Core, Steven E. and Hull, Scott and Barrera, Thomas P.},
  booktitle={Spacecraft Lithium-Ion Battery Power Systems}, 
  title={Ground Processing and Mission Operations}, 
  year={2023},
  volume={},
  number={},
  pages={257-281},
  abstract={Satellite and launch vehicle (LV) lithium&#x2010;ion battery (LIB) ground operations at the manufacturing, system test, and launch site facilities are a critical next step in the battery life cycle. Compliance to established hardware environmental, interface, system safety, and range safety requirements during LIB operations ensures safe and reliable ground and launch site processing operations. In addition, pre&#x2010;launch electrical verification checks, hardware inspections, and environmental controls of the integrated satellite electrical power subsystem (EPS) are necessary to demonstrate and maintain an LIB's nominal performance prior to and during launch operations. A successful post&#x2010;launch mission and on&#x2010;orbit operations validate the adherence to design, assembly, integration, and test (AI&amp;T) processes and requirements needed to meet EPS and satellite mission objectives. At the end of mission (EOM) operations, safe satellite disposal includes passivation of the EPS. This chapter describes the ground, launch site, and on&#x2010;orbit mission operations of satellite LIB power systems. The general requirements for safe satellite and LV orbital stage EPS passivation at the EOM are also discussed. A special focus on hard and soft passivation techniques of LIB energy storage power systems is provided.},
  keywords={Satellites;Batteries;Transportation;Testing;Space vehicles;Inspection;Temperature sensors},
