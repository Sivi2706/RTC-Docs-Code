  booktitle={2023 3rd International Conference on Innovative Research in Applied Science, Engineering and Technology (IRASET)}, 
  title={Analysis of The Effects of Composite Materials on the Rocket Nosecone on Vswr Value of 900MHZ Antenna Frequency}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={A rocket with a diameter of 100 mm is a ballistic rocket equipped with an avionics system as a system that can determine the dynamics of the rocket during glide flight. The avionics system has an antenna acting as a transmitter with a frequency of 900 MHz. The avionics system is attached into a nosecone made from a composite of glass, carbon and nylon fibres. Before conducting flight tests of a rocket, measurements are required to obtain the flight data of the rocket. To obtain rocket flight data, the expected VSWR values for antenna is less than 2. This antenna VSWR measurement was performed with the avionics system mounted on a nose cone which made of various types of composite materials, including material types with expected VSWR values of less than 2. The results an antenna VSWR value of less than 1.5 to greater than 2 is obtained at a frequency of 902MHz - 928MHz.},
  keywords={Antenna measurements;Rockets;Composite materials;Transmitting antennas;Nose;Glass;Aerospace electronics;avionic system;rocket;VSWR antenna;nosecone},
  doi={10.1109/IRASET57153.2023.10152912},
  ISSN={},
  month={May},}@INPROCEEDINGS{11262452,
  author={Liu, Xiaoqin and Pei, Xiaolong and Ding, Zhihu and Li, Xinru},
  booktitle={2025 2nd International Conference on Telecommunications and Power Electronics (TELEPE)}, 
  title={Influence Factor Analysis of Rocket Launcher Projectile Concentration Based on Feature Extraction}, 
  year={2025},
  volume={},
  number={},
  pages={228-231},
  abstract={By introducing the loading and launching process, theoretical analysis and simulation experiments of the rocket projectile, the influence of the blocking force on the initial velocity, rotational speed, direction and pitch angular displacement of the rocket projectile was explored. By establishing the characteristic equation and interior ballistic model of the rocket projectile, it was concluded that the characteristic quantity of the initial disturbance of the rocket projectile was locking force, it had a significant impact on the direction and pitch angular displacement of the rocket projectile. The distribution of the impact point of the rocket projectile under the condition of the locking force of N was quantitatively represented by using the normal distribution with (X, Y) as the mathematical expectation. The results show that the locking force is a sudden force. The increase of the locking force will lead to the increase of the dispersion of the impact point and the decrease of the shooting density. Under the condition of meeting the locking performance requirements, it should be reduced as much as possible.},
  keywords={Rockets;Projectiles;Force;Velocity control;Loading;Feature extraction;Mathematical models;Power electronics;Telecommunications;Dispersion;Aviation rocket launcher;Locking force;Projectile dispersion;Feature extraction},
  doi={10.1109/TELEPE66277.2025.00046},
  ISSN={},
  month={May},}@INPROCEEDINGS{5073209,
  author={Guo, Bo and Bai, Jinping},
  booktitle={2009 International Workshop on Intelligent Systems and Applications}, 
  title={The Simulation of Launch Vehicle Guidance System}, 
  year={2009},
  volume={},
  number={},
  pages={1-4},
  abstract={Based on the CZ series launch vehicle as research object, focused on the mathematical model of guidance calculating subsystem of launch vehicle, the simulation model of the subsystem is established in Matlab/Simulink. The subsystem is divided into a series of independent functional units, such as error compensation unit, space-borne computer unit, calculation guidance unit etc. Firstly, models for each unit of whole guidance system are established according to the structure of the system and these separated models are integrated in Matlab/Simulink environment. Finally, comparing with the real measured data, the results show that the model is accurate.},
  keywords={Vehicles;Navigation;Object oriented modeling;Mathematical model;Computational modeling;Computer simulation;Analytical models;Equations;Numerical simulation;MATLAB},
  doi={10.1109/IWISA.2009.5073209},
  ISSN={},
  month={May},}@INPROCEEDINGS{10054272,
  author={Mukundan, Mijaz and Samuel, Jishy and Sudar, I and Babu, J Suresh and Padmakumar, E S},
  booktitle={2022 IEEE 7th International Conference on Recent Advances and Innovations in Engineering (ICRAIE)}, 
  title={A Statistical Framework for Analysis of Chamber Pressure Spikes in Solid Rocket Motors}, 
  year={2022},
  volume={7},
  number={},
  pages={178-181},
  abstract={Solid rocket motors (SRM) are one of the most reliable and powerful engines for rocket propulsion, their simplicity and ability to generate high thrust makes them an ideal candidate for boosters in launch vehicles like Polar Satellite Launch Vehicle (PSLV) and Geosynchronous Satellite Launch Vehicle (GSLV). The thrust-time profile of the SRMs are carefully designed to meet the mission demands by choosing the right casting geometry and configuration of the solid propellants. It is however noticed that in many of the launches, spikes or ’blips’ occur in the chamber pressure of the SRM which has a significant impact on the vehicle oscillatory disturbance acceleration components. This paper proposes a statistical framework to study the historical launch data available to identify, isolate and study these spikes and quantify their impact on these affected acceleration components. For root cause analysis, aging of propellants and difference in burn rates of segments in the SRM are also taken into consideration.},
  keywords={Geometry;Rockets;Technological innovation;Root cause analysis;Propellants;Solids;Reliability;prominence;peak detection;correlation;SRM},
  doi={10.1109/ICRAIE56454.2022.10054272},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11722826,
  author={Datta, Somoshree and N, Vipin and S, Lini K and M, Amritha Mathew and PR, Ajayalal},
  booktitle={2026 3rd International Conference on Trends in Engineering Systems and Technologies (ICTEST)}, 
  title={Unsupervised Anomaly Detection in Cryogenic Upper Stage Rocket Engine Ground Test Telemetry Using Sliding Window Autoencoders}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Cryogenic upper-stage rocket engines generate extensive high-frequency telemetry data during ground tests to verify performance prior to flight. Early detection of anomalous behavior in such data is critical for safety and mission success, yet remains challenging due to the scarcity of labeled fault examples and the inherent complexity of engine dynamics. This paper presents an unsupervised anomaly detection framework based on a sliding-window autoencoder for analyzing cryogenic engine ground test telemetry. The proposed approach learns nominal engine behavior directly from unlabeled sensor time-series data and identifies anomalous deviations using reconstruction error as an anomaly score. A sliding-window representation with configurable overlap enables fine-grained temporal localization of anomalies, while z-score normalization ensures robustness across diverse operating regimes. The autoencoder architecture, comprising symmetric encoder-decoder networks with a compressed latent representation, captures complex temporal dependencies in multivariate sensor streams. Window-level anomaly scores are aggregated to provide sensor- and experiment-level health summaries using percentile-based thresholding. Experimental evaluation on real ground test data demonstrates robust detection performance, with validation supported by proxy analysis using synthetically injected anomalies. Results indicate significant improvements in sensitivity and specificity compared to conventional threshold-based monitoring methods, highlighting the framework's suitability for operational deployment in safetycritical aerospace ground test environments where false alarms must be minimized while ensuring comprehensive fault coverage.},
  keywords={Windows;Testing;Image sensors;Modeling;Engines;Timing;Anomaly detection;Telemetry;Grounding;Labeling;Unsupervised anomaly detection;cryogenic rocket engine;ground test telemetry;autoencoder;time-series analysis;sliding window;engine health monitoring},
  doi={10.1109/ICTEST69239.2026.11722826},
  ISSN={},
  month={July},}@INPROCEEDINGS{7802832,
  author={Puttonen, Jani and Zhang, Jie and Puchko, Oleksandr and Kurjenniemi, Janne and Kim, Haesik and Paaso, Henna and Seppänen, Janne and Järvensivu, Pertti and Salaris, Paolo and Masci, Aldo and Romanato, Roberto and Di Lanzo, Domenico and Falzini, Stefano and Martini, Gialuca and Pagnani, Alberto and Buchanan, Neil and Sanches, Ignacio Aguillar},
  booktitle={2016 International Workshop on Tracking, Telemetry and Command Systems for Space Applications (TTC)}, 
  title={Robust telemetry system for future launchers}, 
  year={2016},
  volume={},
  number={},
  pages={1-8},
  abstract={This article presents a consideration of a new robust telemetry (TM) system for future launchers. The main target is to increase the maximum data rate of TM system to at least 5 Mbps with improvements such as more efficient physical layer, advanced antenna solutions, lossless data compression, satellite relays, and adaptive coding and modulation (ACM). An extension module for Network Simulator 3 (ns-3) for launch vehicle (LV) TM communications was developed, which is capable of evaluating the system performance and potential gains of the proposed enhancements. The results show that the proposed telemetry system can reach close to the target capacity with new physical layer modulation and coding scheme and the performance may be further improved with retro directive antenna array and satellite relays.},
  keywords={Telemetry;Physical layer;Helical antennas;Satellites;Relays;Modulation;Antenna arrays;launch vehicle;telemetry;system simulator;network simulator 3;ns-3;performance analysis;consultative committee for space data systems;CCSDS;european space agency;ESA},
  doi={},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10808964,
  author={Rahmat, Mirza Zulfikar and Nugroho, Prapto and Utomo, Dzuhri Radityo and Widada, Wahyu and Priyadana, Ikhwannuary Raditya},
  booktitle={2024 16th International Conference on Information Technology and Electrical Engineering (ICITEE)}, 
  title={Simulation of PCM/FM Telemetry Data Encoder Based on IRIG-106 Standard in Matlab Simulink}, 
  year={2024},
  volume={},
  number={},
  pages={165-170},
  abstract={The telemetry data encoder, a component of the PCM/FM transmitter system in the rocket telemetry (TM), adheres to the IRIG-106 standard. It’s used to gather data from sensors that monitor various rocket flight parameters, such as inertia, combustion pressure, temperature, etc. These encoders are typically developed and manufactured by defense-oriented industries, and due to their specialized applications, information about their development is rarely published. This paper elucidates the operational principles of the rocket TM system, with a specific focus on the TM data encoder module. The TM data encoder is designed and simulated using Matlab Simulink, and it’s capable of acquiring two types of input: analog sources and digital sources. The simulation uses a dataset of analog sensor acquisition results from previous tests to accurately represent the measured parameters, while actual hardware such as INS modules and cameras are used for digital sources. The performance of the simulation is evaluated by comparing the output signal of the TM data encoder simulation with the output of the Zodiac CMA, a device that complies with the IRIG-106 standard. The simulation results reveal that the output signal closely mirrors that of the actual TM data encoder Zodiac CMA. The sampling time for one TM data encoder parameter is designed to be 7.8125 µs, resulting in a bit rate of 1.024 Mbps. The latency that occurs during the process is 8.4355 µs.},
  keywords={Temperature sensors;Rockets;Software packages;Transmitters;Simulation;Hardware;Sensors;Telemetry;MATLAB;Standards;Telemetry;IRIG-106;PCM/FM Transmitter;TM data encoder;Matlab simulink},
  doi={10.1109/ICITEE62483.2024.10808964},
  ISSN={2766-0419},
  month={Oct},}@INPROCEEDINGS{8832390,
  author={Jianguo, Guo and Shengjiang, Yang and Jun, Zhou},
  booktitle={2019 Chinese Control And Decision Conference (CCDC)}, 
  title={New Iterative Guidance for Launch Vehicle with Quadratic Optimization}, 
  year={2019},
  volume={},
  number={},
  pages={5346-5349},
  abstract={This paper investigates the iterative guidance mode for launch vehicle. In order to improve the precision of the guidance system and minimize the flight time, the iterative guidance mode derived from quadratic optimization method, to obtain minimal energy control for launch vehicle. At the same time, the optimal control vector of the guidance command is obtained based on the Hamiltonian equation, and the analytical solutions and the initial value of the adjoint variables are obtained by double integration. Finally, numerical simulation is demonstrated that the performance of the new iterative guidance mode for launch vehicle can achieve the desired performance. In addition, 500 times Monte-Carlo simulation results show the performance of the iterative guidance mode is better than the traditional iterative guidance.},
  keywords={Orbits;Mathematical model;Iterative methods;Optimal control;Monte Carlo methods;Performance analysis;Numerical simulation;Iterative guidance;Launch vehicle;Optimal control;Quadratic optimization;Monte-Carlo Method},
  doi={10.1109/CCDC.2019.8832390},
