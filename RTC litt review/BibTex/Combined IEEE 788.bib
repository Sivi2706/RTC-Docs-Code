  title={Advanced, low-cost rocket engine controller}, 
  year={1997},
  volume={2},
  number={},
  pages={8.3-16},
  abstract={The rapid growth in demand for spacecraft launch services has spawned a need for a variety of new, innovative, and low-cost propulsion technologies. Advanced, low-cost rocket engine controllers are a critical part of the technology required. Future rocket engine controllers will require numerous features not widely available today including low recurring and non-recurring cost, adaptability to different engines, engine health management capability, protection against single-event radiation effects, and fault tolerant options.},
  keywords={Rockets;Engines;Space technology;Propulsion;Industrial control;Space vehicles;Size control;Valves;Actuators;Costs},
  doi={10.1109/DASC.1997.637277},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9034034,
  author={Lübken, André and Drobczyk, Martin and Häseker, Janis Sebastian and Budroweit, Jan},
