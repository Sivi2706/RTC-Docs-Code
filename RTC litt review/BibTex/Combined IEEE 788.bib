  year={2009},
  volume={1},
  number={},
  pages={439-442},
  abstract={Adapting the CZ series launch vehicle as research object, and according to multi-scale Modeling, the simulation model of the Launch Vehicle guidance subsystem was established and simulated in Matlab/Simulink. A series of relatively independent mathematical model such as rocket instantaneous velocity, instantaneous displacement, earth gravity acceleration, navigation guidance equation etc were built at first. Then the sub simulation models of these units were built in Matlab/Simulink. The model of guidance calculating subsystem of Launch Vehicle was acquired by means of integration on the Basis of their Logical Relationships. Comparing with the real sampling data, the results showed that the model was sound and the method was validity.},
  keywords={Navigation;Mathematical model;Rockets;Acceleration;Space technology;Gravity;Space vehicles;Control systems;Earth;Computational modeling;Launch Vehicle;guidance;modeling and simulation;Matlab/Simulink},
  doi={10.1109/ICIE.2009.234},
  ISSN={},
  month={July},}@INPROCEEDINGS{10668309,
  author={Vaheed, Sheikh Abdul and Vaddavalli, Dilipkumar and Muralikrishna, A and Mathew, Binny},
  booktitle={2024 IEEE Space, Aerospace and Defence Conference (SPACE)}, 
  title={Onboard Power Distribution and Measurement for Launch Vehicle Avionics System with reduced Umbilical Interface}, 
  year={2024},
  volume={},
  number={},
  pages={634-637},
  abstract={The Launch vehicle avionics rely on batteries for flight power, but for ground testing, batteries are impractical. Power supplies simulate batteries for each avionic subsystem, requiring complex ground systems and interfaces. During launch countdown, power must seamlessly transition from external to internal sources. This paper proposes an advanced, reliable power distribution system using a unified bus, minimizing interconnects, enhancing redundancy, and reducing mass. It discusses system configuration, design constraints, and fault protection techniques to ensure reliability during critical phases.},
  keywords={Power measurement;Power supplies;Redundancy;Power distribution;Switches;Aerospace electronics;Reliability engineering;Power distribution;power supplies;batteries;switch;current;1553;RS485;Umbilical},
  doi={10.1109/SPACE63117.2024.10668309},
  ISSN={},
  month={July},}@INPROCEEDINGS{6865994,
  author={Marrocchi, Luca and Biz, Diego and Marchetti, Maurizio and Cecconelli, Andrea and Loperfido, Daniele and Paggi, Mirko and Baldacchini, Matteo},
  booktitle={2014 IEEE Metrology for Aerospace (MetroAeroSpace)}, 
  title={High performance, high configurability modular telemetry system for launch vehicles}, 
  year={2014},
  volume={},
  number={},
  pages={594-598},
  abstract={Launch vehicles and their evolution have shown increasing interest in performing additional and different measurements based on the specific application and mission. Into this frame an high configurable and high performance acquisition system can address the demand of having a customized measurement plan based on the flight needs. For the first two launches of VEGA European launcher TEMIS has developed and successfully performed an additional telemetry system to comply the heterogeneous needs in a single package.},
  keywords={Telemetry;Streaming media;Power supplies;Sensor systems;Vehicles;Data handling;telemetry;data handling;transmission system;sensors acquisition},
  doi={10.1109/MetroAeroSpace.2014.6865994},
  ISSN={},
  month={May},}@INPROCEEDINGS{9649645,
  author={Pascawati, Anita and Rahardiyanti, Kandi and Fakhri, Muh. and Riyadl, Ahmad and Artono, Endro and Kurdianto and Aziz, Muhammad Reza Kahar},
  booktitle={2021 International Conference on Computer System, Information Technology, and Electrical Engineering (COSITE)}, 
  title={Blade Antenna 2.4 GHz for Rocket Applications}, 
  year={2021},
  volume={},
  number={},
  pages={204-208},
  abstract={This paper proposes a new antenna design that can be used for sounding rocket telemetry with the shape of inverted-F or blade. The shape is designed for a good radiation pattern and also with a good aerodynamic shape to minimize drag and heat resulted from the friction with the air. Furthermore, the carrier frequency used in the proposed antenna is 2.4 GHz. Hence, the proposed antenna is designed with perfect electric conductor (PEC) materials and specific dimension. The proposed single blade antenna has sectoral radiation pattern with maximum gain of 3.69 dB. On the other hand, when dual blade antennas are mounted on the conducting cylinder of rocket, the radiation pattern of antenna become omni-directional with maximum gain of 4.13 dB. Moreover, the results show that the single blade antenna has impedance bandwidth of 670 MHz with the frequency range of 2.17 – 2.84 GHz. We expect that our design contributes to the rocket science and technology.},
  keywords={Heating systems;Rockets;Shape;Blades;Friction;Drag;Resonant frequency;blade;inverted-F;antenna;radiation pattern;rocket},
  doi={10.1109/COSITE52651.2021.9649645},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10548283,
  author={Xu, Cong and Ling, Zhen and Xu, Pengfei and Sui, Qiangqiang},
  booktitle={2024 7th International Conference on Advanced Algorithms and Control Engineering (ICAACE)}, 
  title={Design of Open Modular Avionics for Launch Vehicle Test and Launch Control System}, 
  year={2024},
  volume={},
  number={},
  pages={1238-1242},
  abstract={The test and launch control system is a critical component of launch vehicles. In this study, an open, modular avionics for the test and launch control system is presented and developed to improve the capabilities in standardized, universal design as well as in intelligent and networked applications. The system, which is based on a hierarchical bus architecture and generalized hardware modules and software components, forms a comprehensive package of standard service functions. It enables the individual adaptation of functional units to different application scenarios, significantly improving the integrated assembly and development capabilities of the system on the shelf. By utilizing a unified information and communication service network and basic software and hardware components, this system creates a solid foundation for modular upgrades, functional restructuring at the device level, and fault tolerance and recovery capabilities at the system level. It provides robust technical support for the development and operation of high quality, efficient and effective new generation launch vehicle test and launch control systems.},
  keywords={Technological innovation;Computer architecture;Aerospace electronics;Control systems;Solids;Software;Hardware;test and launch control system;launch vehicles;open modular;avionics},
  doi={10.1109/ICAACE61206.2024.10548283},
  ISSN={},
  month={March},}@INPROCEEDINGS{11179204,
  author={Chen, Yifan and Zhu, Huagang and Wang, Xueyun},
  booktitle={2025 44th Chinese Control Conference (CCC)}, 
  title={Optimal Guidance for Reusable Launch Vehicle in Reentry Phase Based on Adaptive Dynamic Programming with Experience Replay}, 
  year={2025},
  volume={},
  number={},
  pages={2808-2813},
  abstract={An optimal tracking guidance method for Reusable Launch Vehicles (RLV) in the reentry phase is proposed based on improved Adaptive Dynamic Programming (ADP) with experience replay (ER). An actor-critic ADP with novel network weight tuning algorithms is developed. By introducing the experience replay technique, the persistence of the excitation requirement can be assessed while updating the critic neural network. Therefore, the generalization performance is improved for the ADP-based controller. Simulation of the RLV guidance system under model uncertainty is conducted. Better performances in terms of smoothness and accuracy are achieved compared with noise expansion, demonstrating the effectiveness and advantages of the proposed method for the optimal trajectory-tracking guidance of RLV.},
  keywords={Adaptive systems;Uncertainty;Navigation;Simulation;Heuristic algorithms;Noise;Dynamic programming;Trajectory;Feedback control;Tuning;Adaptive dynamic programming;Online actor-critic learning;Reusable Launch Vehicle;Experience Replay;Trajectory-tracking guidance},
  doi={10.23919/CCC64809.2025.11179204},
  ISSN={1934-1768},
  month={July},}@INPROCEEDINGS{10197935,
  author={Yanik, Tahir and Söken, Halil Ersin},
  booktitle={2023 10th International Conference on Recent Advances in Air and Space Technologies (RAST)}, 
  title={Design of a Guidance System for an Airlaunch Rocket Using Iterative Guidance Mode}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={The use of satellites in small sizes has increased in the last decades thanks to improvements in electronics and materials technology. However, the problem arises from their smaller size is the way of launching them into the operating orbit. Thus, dedicated vehicles launched in the air are now of great interest. In this paper, Iterative Guidance Mode (IGM) is applied to a hypothetical air launch rocket which can be used to insert a micro satellite into a Low Earth Orbit (LEO) orbit. The results are compared with the optimal trajectories obtained. Unlike traditional launchers, these types of vehicles can be launched from different initial conditions and the target might be different for each use. In this paper, the guidance algorithm is applied to an airlaunch rocket and its performance tested considering the specifications.},
  keywords={Space vehicles;Rockets;Satellites;Space technology;Low earth orbit satellites;Trajectory;Iterative methods;air-launch;ascent guidance;launch vehicle;IGM},
  doi={10.1109/RAST57548.2023.10197935},
  ISSN={},
  month={June},}@INPROCEEDINGS{8844189,
  author={Edwards, Paul and Jones, W. Linwood},
  booktitle={2019 ESA Workshop on Aerospace EMC (Aerospace EMC)}, 
  title={Scattering interference from large spacecraft and causal effects on launch vehicle antenna performance}, 
  year={2019},
  volume={},
  number={},
  pages={1-7},
  abstract={In this work, we investigate after the performance of an S-band, circularly polarized patch antenna installed on a Launch Vehicle (LV) compromised by the launching spacecraft structure and the unpredicted loss of critical telemetry. During any space launch, on-board Radio Frequency (RF) Telemetry, Tracking & Command (TT&C) systems must satisfy RF link requirements for monitoring of launch vehicle system health, and trajectory tracking for launch range safety. Preprogrammed flight manoeuvres attempt to provide best line-of-sight (LOS) visibility to scheduled receiving satellite and ground stations along the launch trajectory path. Traditional link margin analysis conservatively predicts telemetry margin using measured element radiation patterns for scheduled stations that are in the view. Using advanced computational electromagnetic modelling methods, the compromised radiation pattern is investigated and the causal effect on LV telemetry performance is discussed after the fact without the need for integrated system testing.},
  keywords={Telemetry;Antenna radiation patterns;Antenna measurements;Space vehicles;Payloads;Receiving antennas},
  doi={10.23919/AeroEMC.2019.8844189},
  ISSN={},
  month={May},}@INPROCEEDINGS{11431882,
  author={Ţapu, Alexandru and Drăgulinescu, Ana-Maria},
  booktitle={GLOBECOM 2025 - 2025 IEEE Global Communications Conference}, 
  title={IoT-enabled Integrated Avionic System for Supersonic Multi-purpose Rockets with Real-Time Telemetry and Autonomous Flight Control}, 
  year={2025},
  volume={},
  number={},
  pages={2964-2969},
  abstract={Recent advances in the integration of Internet of Things (IoT) technologies and sensor networks have significantly enhanced the autonomy and telemetry capabilities of aerospace systems, particularly in unmanned aerial vehicles, small satellites, and sounding rockets. However, limited attention has been given to the specific challenges posed by reusable supersonic missiles, which require compact, cost-efficient, and robust avionics capable of real-time decision-making under extreme dynamic conditions. This paper presents the design, implementation, and validation of a high-performance avionic system developed for reusable supersonic missile platforms. The system features a modular sensor suite consisting of barometric transducers, inertial measurement units (IMUs), and a GNSS receiver, supporting data acquisition rates up to 400 Hz and real-time telemetry transmission at 9.6 kbps. During test flights, the system demonstrated accurate tracking of ascent and descent phases, with apogee detection occurring at 42 seconds and 6,600 meters altitude, and maximum recorded velocity exceeding 550 m/s. The onboard software integrates optimized sensor fusion and signal processing algorithms—including Kalman and complementary filters, and quaternion-based attitude estimation—enabling nine-degree-of-freedom orientation tracking and deterministic identification of events such as engine burnout, apogee, and parachute deployment.},
  keywords={Rockets;Missiles;Transducers;Software algorithms;Aerospace electronics;Real-time systems;Software;Telemetry;Internet of Things;Vehicle dynamics;IMU;barometric sensor;orientation;data logging;rocket design},
  doi={10.1109/GLOBECOM59602.2025.11431882},
  ISSN={2576-6813},
  month={Dec},}@INPROCEEDINGS{111273,
  author={Wensley, J.H. and Uhrich, D.D.},
  booktitle={9th IEEE/AIAA/NASA Conference on Digital Avionics Systems}, 
  title={Reliability and cost considerations for launch vehicle avionics}, 
  year={1990},
  volume={},
  number={},
  pages={117-124},
  abstract={The optimum redundancy for an avionics processor can be determined from cost and reliability considerations. The use and expense of redundant architectures are examined, along with the cost and advantages of using space-qualified parts. The advanced launch system (ALS) vehicle model was used for the comparisons. Avionics redundancy models included duplex, triple modular redundancy, and quad systems. Processors were modeled as simplex, dual self-checking pairs, or triplex checking. Cost factors were those which result in the cost per launched vehicle. These included cost of launch equipment, cost of scrubbing a launch, failure investigation, repair, and the cost of money due to schedule delays. The primary conclusion reached was that the use of redundancy to achieve fault tolerance is required for higher value missions. The use of less-highly qualified parts can lower costs for less expensive payloads, but will require a culture change to allow launching with known faults. The need for greater emphasis on determination of coverage for fault-tolerant systems was demonstrated.<>},
  keywords={Vehicles;Aerospace electronics;Redundancy;Fault tolerant systems;Fault tolerance;Sensor systems;Navigation;Lakes;Cost function;Processor scheduling},
  doi={10.1109/DASC.1990.111273},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11511153,
  author={M, Likitha and A, Kumkum and Ambika and R, Krishna Kumar P and Desai, Usha},
  booktitle={2026 9th International Conference on Inventive Computation Technologies (ICICT)}, 
  title={Defect Detection in Space Craft and Launch Vehicle Sensors}, 
  year={2026},
  volume={},
  number={},
  pages={707-711},
  abstract={Reliable sensor operation is indispensable for safety and success of spacecraft and launch vehicle missions. The Liquid Propulsion Systems Centre (LPSC–B) of the Indian Space Research Organisation (ISRO), which deploys pressure transducers, thermocouples, accelerometers, and flow meters within liquid propulsion stages to monitor critical parameters throughout ground testing and flight. Sensor defects ranging from gradual bias drift to complete dropout can produce erroneous telemetry that compromises control decisions and jeopardizes mission safety. This paper presents a machine learning (ML)-based defect detection framework for spacecraft and launch vehicle sensors, developed at LPSC–B, ISRO. A Random Forest ensemble classifier is trained on eight time-domain and frequency-domain features extracted via a sliding window from raw sensor telemetry to detect five fault categories: Normal, Bias Drift, Fixed-Value Fault, Noise Spike, and Sensor Dropout. Evaluated on a 90,000-sample dataset of real LPSC telemetry and fault-injected simulation data, the system achieves 96.4% accuracy and macro F1-score of 0.963, outperforming Decision Tree, Naïve Bayes, KNN, and SVM baselines. ROC-AUC scores exceed 0.98 for all classes. The system is deployed as a real-time monitoring plug-in within LPSC ground support equipment achieving sub-50 msec inference latency.},
  keywords={Image sensors;Modeling;Random forests;Telemetry;Printing;Timing;Real-time systems;Grounding;Windows;Accuracy;spacecraft sensors;launch vehicle;fault classification;ISRO;LPSC;anomaly detection;SMOTE},
  doi={10.1109/ICICT68280.2026.11511153},
  ISSN={2767-7788},
  month={April},}@INPROCEEDINGS{9390615,
  author={Lu, Zuo and Jie, Liu},
  booktitle={2021 IEEE 5th Advanced Information Technology, Electronic and Automation Control Conference (IAEAC)}, 
  title={Research on FM telemetry and demodulation performance of ship borne rocket based on MSD}, 
  year={2021},
  volume={},
  number={},
  pages={373-375},
  abstract={In ship borne TT&C system, PCM-FM system is widely used in rocket telemetry and demodulation. In practical application, due to the interference of rocket tail flame, the attitude changes frequently, the ship rocking is larger, the remote demodulation threshold is higher and so on, as a result, the ground equipment has a high probability of error code when the signal-to-noise ratio is lower than the demodulation threshold. In view of this situation, multi-symbol detection technology (MSD) can be used to reduce the demodulation threshold, overcome the adverse effects of the environment and threshold effect. This paper analyzes and verifies the performance of MSD technology used in rocket telemetry and demodulation, and provides a new parameter configuration mode, which is useful for practical engineering.},
  keywords={Rockets;Frequency modulation;Transmitters;Interference;Telemetry;Marine vehicles;Demodulation;MSD;FM telemetry;Modulation;ship borne},
  doi={10.1109/IAEAC50856.2021.9390615},
  ISSN={2689-6621},
  month={March},}@INPROCEEDINGS{11323897,
  author={Sojatia, Aarav and Sojatia, Manan and Sethi, Kamal Kumar and Mishra, Prajal},
  booktitle={2025 IEEE 5th International Conference on ICT in Business Industry & Government (ICTBIG)}, 
  title={Designing a Theoretical AI-Based Fault Detection System for Rocket Engines}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Fault detection in rocket engines is of prime importance for mission reliability, crew safety, and maintaining the structural longevity of propulsion systems. Traditional methods of engine diagnosis often involve threshold-based monitoring, hardware redundancy, and human visual inspection, which may only be able to catch faults well after they have grown severe, leaving little time for effective intervention. Modern rocket engines incorporate increasingly sophisticated component assemblies and sensing arrays, which are generating large volumes of dynamic telemetry that traditional systems cannot parse effectively. With advances in AI, ML, and DL, today's aerospace engineers have access to powerful analytics that can much more precisely detect subtle deviations from nominal operation. The paper proposes a theoretical design for an AI-based rocket engine fault detection architecture based on recent literature related to anomaly detection, temporal neural networks, autoencoders, and physics-informed learning. It integrates multi-sensor telemetry, signal preprocessing, LSTM-based temporal modelling, autoencoder-based unsupervised anomaly detection, and physics-informed neural network checks within an ensemble decision framework with human-in-the-loop verification. Sources for verified figures are listed next to each placeholder. The design illustrates how hybrid physics-AI systems can detect combustion instability, turbopump degradation, and injector anomalies with better early warning and reliability compared to traditional threshold-based approaches.},
  keywords={Degradation;Rockets;Visualization;Fault detection;Autoencoders;Neural networks;Sensors;Telemetry;Engines;Anomaly detection;Rocket engine fault;Anomaly detection;Autoencoders;Turbopump degradation;Injector anomalies},
  doi={10.1109/ICTBIG68706.2025.11323897},
  ISSN={},
  month={Dec},}@ARTICLE{6491490,
  author={Lancelle, Daniel-Maurice and Božić, Ognjan and Köke, Hardy},
  journal={IEEE Transactions on Plasma Science}, 
  title={Flight Test Results of the Investigation of Acceleration Effects on a Gun-Launched Rocket Engine}, 
  year={2013},
  volume={41},
  number={5},
  pages={1364-1369},
  abstract={Nowadays, much research has been done in the field of electromagnetic-driven Lorentz rail accelerators (LRA). To apply this technology to launch a sophisticated payload carrying vehicle, mechanical loads due to high acceleration have to be taken into account. The German Aerospace Center (DLR) is doing research in the field of a hybrid rocket propelled payload carrier which shall be launched from an LRA. The structure of the hybrid rocket engine (HRE) is the most critical component, regarding mechanical stress. To investigate the effects of high acceleration during the launch from an LRA, an experimental setup is created. An 80% scale model of an HRE is mounted on a 155-mm howitzer shell. The experimental setup is then launched from the Panzerhaubitze 2000 with an acceleration of 3300 g. The model is equipped with strain gauge sensors to determine deformation during the acceleration phase. An acceleration sensor is integrated to measure the acceleration during launch. Data of the strain gauge bridges and the accelerometer are sampled by an electronic device mounted on the projectile, and buffered in the internal RAM. The data are transmitted to a ground station during free flight by a telemetry device, which is mounted on the howitzer shell instead of a fuse. The flight path of the projectile is tracked by different radar stations to determine the impact point, so that the experiment can be recovered. The test shows that the HRE structure can withstand the mechanical loads that are caused by high acceleration that would occur during a launch from an LRA. Therefore, an HRE is suitable for high-acceleration launch. The sampled data are compared with finite element method calculations. Differences in simulation and measurement are observed.},
  keywords={Acceleration;Strain;Projectiles;Fuels;Bridges;Solids;High acceleration;mechanical stress;railgun},
  doi={10.1109/TPS.2013.2249532},
  ISSN={1939-9375},
  month={May},}@INPROCEEDINGS{5512305,
  author={Jiang, Li and Wang, Kui-min},
  booktitle={The 2010 IEEE International Conference on Information and Automation}, 
  title={PCM/PSK high bit-rate transmission performance in Launch Vehicle multi-path channel}, 
  year={2010},
  volume={},
  number={},
  pages={1188-1193},
  abstract={With increasing demand to TT&C (telemetry, track and command), the bit-rate of a new generation Launch Vehicle in China has been increased to 10Mbps. This may result in the fading of received signal and the increasing of the receiver BER (Bit-Error-Rate), which in turn brings great uncertainty to system design. This paper investigates the most important reason of the fading of a high bit-rate telemetry channel fading. Typical characteristics of multi-path of a launch Vehicle are analyzed, and its analysis model is established. Its high bit-rate transmission performance is analyzed. The multi-path channel which effected by attenuation coefficient and delay time is analyzed and simulated. Simulation results of full-flight BER are given to show the system performance.},
  keywords={Phase change materials;Phase shift keying;Vehicles;Fading;Telemetry;Bit error rate;Uncertainty;System analysis and design;Performance analysis;Attenuation;Multi-path;TT&C;High Bit-rate;PCM/PSK},
  doi={10.1109/ICINFA.2010.5512305},
  ISSN={},
  month={June},}@INPROCEEDINGS{10493473,
  author={Renwarin, Rezki Benedikto and Munir, Achmad},
  booktitle={2024 Second International Conference on Emerging Trends in Information Technology and Engineering (ICETITE)}, 
  title={Conformal Triangular Slotted Antenna for Rocket Sounding Application}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={An antenna on the sounding rocket is necessary, so it can receive and transmit signals to the ground station. This paper presents the design and simulation of a conformal triangular slotted antenna for sounding rocket application. The proposed antenna is intended to work at the frequencies of 0.91 GHz and 2.45 GHz for radio telemetry and 1.575 GHz for Global Positioning System (GPS) channel L1. It is designed on a 0.254 mm thick Rogers/Duroid 5880 dielectric substrate with a relative permittivity of 2.2 and dimensions of 228.6 mm × 304.8 mm. The antenna consists of a 1 ×2 array for telemetry and a single element for GPS L1. The antenna is excited with proximity coupling which is fed to coaxial cable from below the substrate. The result shows that the proposed antenna can work at the frequencies of 0.91 GHz, 1.575 GHz, and 2.45 GHz with the reflection coefficient values maintained less than -10 dB. These three frequencies have fractional bandwidths of 0.85%, 1.86%, and 1.3%, respectively. The 3 dB axial ratio bandwidth for GPS L1 antenna achieves 80 MHz. Furthermore, the radiation patterns are omnidirectional with the gains at these frequencies are 2.78 dBi, -3.19 dBi, and 3.02 dBi, respectively.},
  keywords={Rockets;Slot antennas;Bandwidth;Reflector antennas;Reflection coefficient;Telemetry;Gain;conformal triangular slotted antenna;Global Positioning System (GPS);rocket sounding;telemetry},
  doi={10.1109/ic-ETITE58242.2024.10493473},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{6086351,
  author={Zhou, You and Wang, Mao-zhi},
  booktitle={2011 International Conference on Computational and Information Sciences}, 
  title={Launch Vehicle Testing Simulation System}, 
  year={2011},
  volume={},
  number={},
  pages={921-924},
  abstract={This paper presents a complete set of test simulation system with the background of launch vehicle system test. At first, this paper established the numerical simulation testing model of control system, power system, telemetry system and using system. Then based on these numerical models, this paper presented a kind of integrative simulation model of HLA and Simulink, the numerical model can be dynamically allocated in the system by this way. Through dynamic allocate the numerical model, the system can complete the total testing process from Danji-test, Fenxitong-test to Zongjiancha-test. This method geometric series expand the function of the system, and can drive the scene module with real-time. This system has good versatility and flexibility, and provided a platform for further expansion. Finally, this paper analyzed the results of the system, and the simulation results showed that the model is accurate.},
  keywords={Numerical models;Mathematical model;Solid modeling;Testing;Computational modeling;Object oriented modeling;Numerical simulation;Launch Vehicle;HLA;Matlab/Simulink;Testing simulation},
  doi={10.1109/ICCIS.2011.170},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10693396,
  author={Cantanhede, Nilton Rodrigues and Santana, Ewaldo Eder Carvalho and da Silva Júnior, Paulo Fernandes and Freire, Raimundo Carlos Silvério and Santana, Tiago Pereira and de Albuquerque Campos, Lúcio Flávio and Fernandes, Gabrielle Muniz and de Albuquerque, Maria Tereza Cunha and Macedo, Sophia Viana},
  booktitle={2024 8th International Symposium on Instrumentation Systems, Circuits and Transducers (INSCIT)}, 
  title={Location Analysis Probing Rockets in Ground with Telemetry Data}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Rocket launch centers are crucial in technological development across various fields, including meteorology, long-distance real-time communications, geoprocessing, and satellite operations. However, one of the challenges in tracking probing rockets is accurately identifying their position from the moment of launch until the initial seconds, due to ground noise that interferes with traditional radar location systems. In this study is proposed an innovative method to precisely determine the distance between the rocket and the ground telemetry station. We utilize onboard telemetry signals processed by the Acquisition and Processing Data Trajectory (APDtraj) system, developed by Delsis Aerospace for the Launch Center. This system enables the identification of the rocket's position both on the ground and during the early stages of flight, using telemetry data processed by APDtraj. This monitoring equipment alone calculated the distance between the Telemetry Station and the rocket just moments before launch lift-off with an error of only 16.844 meters from the actual position of origin. Based on our studies, we were able to measure the radial distance and location between the rocket and the telemetry station just four seconds after launch, even without reliable radar information, which is often disrupted by ground noise. This technological advancement not only enhances the efficiency of rocket launch operations but also expands overall tracking capabilities.},
  keywords={Rockets;Transducers;Satellites;Radar measurements;Spaceborne radar;Noise;Radar tracking;Real-time systems;Trajectory;Telemetry;Rocket launch;probing rocket;ground;telemetry date},
  doi={10.1109/INSCIT62583.2024.10693396},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{8545572,
  author={Kirillov, Sergey N. and Pisaka, Pavel S.},
  booktitle={2018 XIV International Scientific-Technical Conference on Actual Problems of Electronics Instrument Engineering (APEIE)}, 
  title={Algorithm of Telemetry Information Weighting Signal Processing from Territorially-Distributed Receiving Stations}, 
  year={2018},
  volume={},
  number={},
  pages={197-201},
  abstract={The issues of telemetry information processing of rocket and space technology products in the conditions of full-scale experiment are considered. The aim is to create an algorithm for weighing signal processing by those specified by the model in the form of two-component gamma distribution from territorial distributed receiving stations at a given probability of false alarm. Using full-scale telemetry information, the dependence of signal of telemetry information correct detection probability on the signal-to-noise ratio was obtained. It is shown that simultaneous use of information from five receiving stations allows to increase the average probability of correct detection of signal of telemetry information in comparison with sequential use of information from one receiving station at different signal-to-noise ratio and at a given probability of false alarm.},
  keywords={Signal processing algorithms;Fluctuations;Telemetry;Signal processing;Antennas;Fourier transforms;telemetry information;receiving stations;interfering factors;integration of telemetry information;improvement of processing quality},
  doi={10.1109/APEIE.2018.8545572},
  ISSN={2473-8573},
  month={Oct},}@INPROCEEDINGS{10329895,
  author={Pillutla, Narasimhulu and Kumar, Shishir},
  booktitle={2023 IEEE International Conference on Aerospace Electronics and Remote Sensing Technology (ICARES)}, 
  title={FPGA Implementation of High-speed Communication End System (ES) Interface for Avionics Application}, 
  year={2023},
  volume={},
  number={},
  pages={1-4},
  abstract={With the current trend of rapid development of advanced data transmission technologies in the avionics fields, the avionics buses for future Avionic applications need to cater to increased bandwidths to enable the high data transfer rates between sub-systems and the Mission Computer(MC)/On-Board Computer(OBC). Major subsystems include the Inertial Navigation System (INS), Seeker, Target Update Receiver, Warhead, Telemetry, and Global Positioning System(GPS). MC has to acquire the data from these sub-systems and carry out the required computation in real-time with periodicities of the order of 2. 5ms or 5ms with deadlines of the order of 1ms. Safety critical systems like Aircraft, Missile, Launch Vehicles, and Satellites require a reliable communication protocol to guarantee their functioning without errors. Thus, Avionics Full Duplex Switched Ethernet (AFDX) shows great potential in onboard avionic systems because of its high-speed performance, redundancy, full-duplex, deterministic, switched, and profiled network. Typical data rates are of the order of 10kbps to 1Mbps. The main objective of this paper is to design of high-speed communication End System interface for avionics applications and its implementation on FPGA.},
  keywords={Satellites;Redundancy;Switches;Aerospace electronics;Real-time systems;Safety;Telemetry;Redundancy;Deterministic;OBC/MC;AFDX},
  doi={10.1109/ICARES60489.2023.10329895},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{292978,
  author={Powell, W.R.},
  booktitle={Conference Proceedings National Telesystems Conference 1993}, 
  title={Transportable orbital tracking, telemetry and command system}, 
  year={1993},
  volume={},
  number={},
  pages={241-249},
  abstract={NASA/Goddard Space Flight Center has implemented an automated ground-based telemetry, command, and Doppler system. Its function is to support the low-earth-orbiting satellite and sounding rocket programs. This fully transportable system can be configured with the capability to provide unmanned satellite support for seven days or operator augmented automated sounding rocket launch and tracking support. An extensive overview of the evolutionary status and functional capabilities of such systems is provided.<>},
  keywords={Telemetry;Rockets;NASA;Satellite ground stations;Containers;Low earth orbit satellites;Personnel;Diversity reception;Extraterrestrial measurements;Space missions},
  doi={10.1109/NTC.1993.292978},
  ISSN={},
  month={June},}@INPROCEEDINGS{10124919,
  author={Naeem, Umair and Buchanan, Neil},
  booktitle={2023 IEEE Wireless and Microwave Technology Conference (WAMICON)}, 
  title={Conformal Retrodirective TM System for Future Generation Launch Vehicles}, 
  year={2023},
  volume={},
  number={},
  pages={89-92},
  abstract={A robust TM system is proposed for future generation of launch vehicles based on the retrodirective principle. The TM system is compatible for challenging environments, which includes high variation in attitude and acceleration of the platform. The system shows fast tracking with update rate of up to 167 Hz. The proposed system provides full 360 degrees field of view coverage to maintain the link.},
  keywords={Microwave antennas;Wireless communication;Space vehicles;Microwave technology;Telemetry;retrodirective antenna;telemetry system;space launch vehicle},
  doi={10.1109/WAMICON57636.2023.10124919},
  ISSN={},
  month={April},}@INPROCEEDINGS{5747254,
  author={Castillo, George M. and Ratkevich, Brian A.},
  booktitle={2011 Aerospace Conference}, 
  title={Single event upset testing of commercial off-the-shelf electronics for launch vehicle applications}, 
  year={2011},
  volume={},
  number={},
  pages={1-5},
  abstract={This paper presents the results and methodology of recent system-level proton testing which was performed on a COTS-based GPS receiver to be used in a launch vehicle application. Susceptibility to ionizing radiation was a concern due to a high part count and component sophistication. Testing was conducted using 50 MeV protons at the Lawrence Berkeley National Laboratory (LBNL). An approach for the testing of complex COTS components using protons of various energies is discussed in the literature, but was determined to be only partially applicable due to the design of the receiver. Therefore, a functional receiver was constructed which incorporated production components in a manner that allowed separation of the individual circuit cards and irradiation of different locations while the unit was operating as it would during flight. This approach allowed for an understanding of how upsets in isolated locations could affect the system-level response of the entire receiver. An analysis of the results allowed for a determination of a lower bound on the upset rate for a sample launch vehicle trajectory. Shortcomings and limitations to the approach described here are also discussed.},
  keywords={Testing;Protons;Vehicles;Radiation effects;Global Positioning System;Hardware;Receivers;Proton testing;GPS;system-level testing;launch vehicle;commercial off-the-shelf (COTS);upset rate estimation;EELV},
  doi={10.1109/AERO.2011.5747254},
  ISSN={1095-323X},
  month={March},}@INPROCEEDINGS{821989,
  author={Crawford, K.},
  booktitle={Gateway to the New Millennium. 18th Digital Avionics Systems Conference. Proceedings (Cat. No.99CH37033)}, 
  title={Update of the development of a low cost data acquisition system for the Space Shuttle solid rocket booster program}, 
  year={1999},
  volume={2},
  number={},
  pages={7.B.1-7.B.1},
  abstract={The Space Shuttle has been flying for seventeen years and current NASA plans show it flying for many more years. To support the current and future shuttle flight schedule, portions of the shuttle are being upgraded. One of the areas being upgraded is the avionics on the solid rocket boosters (SRB's). To develop reliable avionics hardware, the environments that they encounter during ascent, descent and water impact must be known. Past environmental data collected did not provide the high fidelity data that is required to fabricate new avionics hardware. This paper summarizes the effort to measure the SRB environments via a commercial off the shelf data acquisition system.},
  keywords={Costs;Data acquisition;Space shuttles;Solids;Rockets;Aerospace electronics;Electronic design automation and methodology;Assembly;Hardware;NASA},
  doi={10.1109/DASC.1999.821989},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{111310,
  author={Fernandez, M. and Tazartes, D.A.},
  booktitle={9th IEEE/AIAA/NASA Conference on Digital Avionics Systems}, 
  title={A fault-tolerant architecture for launch vehicle guidance and control. I. Requirement/architecture}, 
  year={1990},
  volume={},
  number={},
  pages={333-336},
  abstract={A low-cost, highly reliable guidance and control system for launch vehicles requires fault tolerance if the launch failures are to be amortized in the launch costs. A flexible architecture that meets requirements for low-cost and high reliability is presented. It provides design workarounds to optimize the system to meet its mission requirements. It is noted that if a viable launch vehicle guidance and control system is to be available it is necessary to deviate from current approaches that have basic deficiencies in their ability to significantly reduce cost and increase reliability. The requirements and architecture presented have been developed with reference to the advanced launch system program.<>},
  keywords={Fault tolerance;Navigation;Costs;Control systems;Payloads;Fault tolerant systems;NASA;Space technology;Vehicle safety;Low earth orbit satellites},
  doi={10.1109/DASC.1990.111310},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{6400201,
  author={Accettura, Antonio and Balduccini, Mauro and Carducci, Franco and De Lillis, Arturo and D'Aversa, Emanuela},
  booktitle={2012 IEEE First AESS European Conference on Satellite Telecommunications (ESTEL)}, 
  title={VEGA: The history of a European success}, 
  year={2012},
  volume={},
  number={},
  pages={1-6},
  abstract={Italy was the third country to deliver a satellite in orbit in the far 1964, since then Italy has been strongly involved on space activities at launchers, satellites and ground segments level. In particular, concerning the access to space, an evolutionary path has been implemented, starting from the first apogee motor (1977) up to the large Ariane 5 solid rocket motor boosters (1996). In the late '90 a National program begun with the objective to increase technological capabilities in the field of small launchers: Vega-K0 was born. In early 2000 the program moved from a national to a European vision and in 2003 ESA signed the contract that consolidated Vega to be e European launcher. The aim of this paper is to trace, show and to some extent justify, the evolutionary path that made Vega a technological achievement. It is worth to note that a complex program such as the development of a space launch vehicle, can be achieved only if several multidisciplinary factors act together for a common objective. For Vega, the following drives could be considered success keys that pushed, and continue to do so, the small launcher to the high frontiers of technology: (a) European and National space agencies commitments (b) Use of solid rocket motors (simple, reliable, low cost and high performance) (c) Merging European and international industrial skills focused on the project (d) Implementation of innovative technologies (such as the composite case) (e) Strong technical management dedicated to the development of each subsystem Main program phases, as well as the firing and the integrated tests that accompanied the launcher qualification, will be presented and discussed. Today Vega launcher has successfully achieved its maiden flight on 13/02/2012, releasing in orbit with high accuracy LARES, ALMASat-1 and 7 CubeSats, marking the starting point for another European success. Finally an overview of future programs enabling access to space will be shown, including the new launchers evolutions.},
  keywords={Europe;Space vehicles;Satellites;Rockets;Solids;Reluctance motors;Vega;launch vehicle;satellite;development;Italy;solid rocket motors;liquid rocket engine;ESA;ASI},
  doi={10.1109/ESTEL.2012.6400201},
  ISSN={2375-8554},
  month={Oct},}@ARTICLE{1089407,
  author={George, W. and Stinson, C.},
  journal={IEEE Transactions on Communication Technology}, 
  title={An Automated Telemetry Checkout Station for the Saturn V Systems}, 
  year={1966},
  volume={14},
  number={6},
  pages={869-871},
  abstract={This Telemetry Checkout Station (TCS) is designed to automatically perform many measurements on the Saturn V vehicle telemetry links. Its unique features include real-time digitizing and computer-controlled station setup, data processing, and self-check. Standard telemetry equipment is used to receive, demodulate, and process the various signals. Analog signals are automatically digitized and assembled into a predetermined time slot. Each word of the constructed wave train is scaled and calibrated, using stored calibration values. The data is outputted to the launch vehicle checkout equipment for final evaluation. This station handles many various automatic tests merely by changing its computer programs.},
  keywords={Telemetry;Saturn;System testing;Instruments;Performance evaluation;Automatic testing;Land vehicles;Road vehicles;Crosstalk;Calibration},
  doi={10.1109/TCOM.1966.1089407},
  ISSN={2162-2175},
  month={December},}@INPROCEEDINGS{821985,
  author={Buzzatto, J.L.},
  booktitle={Gateway to the New Millennium. 18th Digital Avionics Systems Conference. Proceedings (Cat. No.99CH37033)}, 
  title={Failure mode, effects and criticality analysis (FMECA) use in the Federal Aviation Administration (FAA) reusable launch vehicle (RLV) licensing process}, 
  year={1999},
  volume={2},
  number={},
  pages={7.A.2-7.A.2},
  abstract={The FMECA is a key analytical tool for ensuring the launch vehicle design meets the established requirements. This is the traditional approach outlined in MIL STD 1629A. A broadened FMECA process may be used to enhance the credibility of the new, commercial RLV industry. In a commercial RLV environment, a FMECA can serve two purposes. First, it can ensure operational efficiencies by identifying a Critical Components List (CCL) for maintenance purposes. The CCL focuses maintenance activity on the most justifiable tasks. Second, the FMECA can provide regulators with insight into the system features and how they contribute to overall system safety. Consequently, this paper explores broadening the traditional FMECA approach to encompass the use of this analysis in answering the questions "What can be done to most efficiently organize maintenance?" and "Is the design safe to fly?" The goal is to foster an environment that strives for the highest level of mission success. Using the CCL and the FMECA together provides an evolutionary approach that combines, through a disciplined process, the needs of the launch provider for high system reliability and quick turnarounds with the regulatory need for assuring public safety. These themes are discussed using the Kistler Aerospace Corporation (KAC) K-l reusable launch vehicle as the actual example. While FMECA results for the K-l are incomplete, the methodology used is in place. This methodology is the subject of this paper.},
  keywords={Failure analysis;FAA;Vehicles;Engines;Payloads;Hardware;Reliability;Fires;Licenses;Regulators},
  doi={10.1109/DASC.1999.821985},
  ISSN={},
  month={Oct},}@ARTICLE{1581097,
  author={Hertzman, V. and Oreshko, N. and Ekalo, A.},
  journal={IEEE Aerospace and Electronic Systems Magazine}, 
  title={Trajectory and telemetry measurements analysis using wavelets}, 
  year={2005},
  volume={20},
  number={10},
  pages={25-28},
  abstract={The purpose of the report is to present wavelet technology used to improve the performance of trajectory and telemetry data. Modern methods of detection and exclusion of anomaly measurements, main matters of de-noising the measurement and multiresolution analysis of the signals based on wavelet transforms, are considered. Wavelet tools for analysis of measurements results are implemented by SEC SPbSETU in data processing program complexes, developed for the use at Russian trial space-launching sites. Practical capabilities of wavelet technology will be demonstrated by applied program, installed in the note-book PC for processing of GPS/GLONASS raw measurements.},
  keywords={Telemetry;Wavelet analysis;Vibration measurement;Acoustic measurements;Frequency;Data processing;Multiresolution analysis;Motion measurement;Radio navigation;Signal resolution},
  doi={10.1109/MAES.2005.1581097},
  ISSN={1557-959X},
  month={Oct},}@INPROCEEDINGS{8396628,
  author={Pillai, Eric T.},
  booktitle={2018 IEEE Aerospace Conference}, 
  title={Space-capable sounding rocket design for collegiate teams}, 
  year={2018},
  volume={},
  number={},
  pages={1-13},
  abstract={This paper seeks to present a simulation - validated design for a sounding rocket that will enable collegiate teams to surpass the Karman Line for the first time in history while fulfilling three primary requirements critical to allowing collegiate teams to reach space. The design criteria include 1) the rocket must be capable of reaching an altitude of at least 100 km, 2) the rocket must be relatively easy to manufacture and free of toxic materials, and 3) the rocket must be able to return telemetry, video, and data from on board experiments. To reach 100 km, the rocket will utilize a pressure - fed bipropellant engine and lightweight CFRP (carbon fiber reinforced polymer) for much of the outer skin and control surfaces. To reduce cost and environmental impact, the engine will burn a mixture of nitrous oxide and jet fuel, one of the only pairs of readily available, non - toxic, high energy propellants. The engine will deliver an average specific impulse of 204 s with an average thrust of 11 kN. To accomplish the second goal of non - toxicity and ease of manufacturing, the rocket will be constructed from commercially available, non - toxic materials and will lack features such as ablative coatings and intricately shaped components. With the exception of the thermal coatings, the entire vehicle will be made from stainless steel, aluminum, titanium alloy, and carbon fiber. To reduce toxicity, the thermal coatings for both the nose cone and combustion chamber will be comprised of non - toxic silicon dioxide, which has the advantage of not releasing vapor when heated. Additionally, every component of the rocket except for the fuel injector face plate and thermal coatings will be made with equipment commonly found in university machine shops. To recover telemetry and experimental data, the forward section of the rocket will detach at apogee via non - explosive Frangibolts® and return to Earth via parachute. Since the remainder of the rocket will be lost, the rocket body is designed to retain aerodynamic stability after nose cone separation so that its flight can be planned to reduce risk to downrange areas. Additionally, on board Iridium transceiver equipment allows for remote control of the rocket in flight and permit the payload to be easily located and recovered upon landing. Fluid dynamics analysis completed through Autodesk CFD of the rocket's design indicates that it retains aerodynamic stability through all flight phases and is able to recover from significant course deviations while at subsonic velocity, although control authority diminishes rapidly in supersonic flight. Additionally, stress analysis on structural elements shows a retention of structural rigidity from initial engine start, through mach transitions, and until engine burnout at T+70 seconds. This design fulfills all stated design parameters with >10% margins of error across all parts and calculations, indicating that it is a viable means of enabling universities to directly access space.},
  keywords={Rockets;Engines;Fuels;Propellants;Combustion;Cooling},
  doi={10.1109/AERO.2018.8396628},
  ISSN={},
  month={March},}@INPROCEEDINGS{10142574,
  author={Robinson, Denil V. and R.S., Vivek and Gopinath, Anish and Sundaramoorthy, K. and T., Latha and Devi, Athula},
  booktitle={2023 International Conference on Power, Instrumentation, Control and Computing (PICC)}, 
  title={A 3-Point Control Scheme for a Fault Tolerant Duplex Coil BLDC Motor Based Launch Vehicle Electromechanical Actuation System}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Fault tolerance in aerospace and launch vehicle applications often entails introduction of additional identical signal or power chains to take over in case of a failure. A unique solution to failure mitigation in launch vehicle actuation system is the usage of a multi-coil motor. Such a motor consists of multiple independent stator coils driven by independent power drives. Under conditions of open coil failure, remaining coils should be able to meet the actuation demands. But a coil-short failure can degrade the performance of actuation as it will induce a breaking effect. Thus, it is pertinent that the controller be able to not only detect and distinguish between coil failures, but should initiate corrective actions to ensure performance. In this work the system under consideration is modelled under nominal and failure conditions. The suitability of an adaptive scheme in compensating the performance degradation is also studied. Simulation results validate the suitability of the adaptive scheme but also bring out certain shortcomings such as poor transient response at the time of failure and associated computational complexities. A 3-point control scheme to overcome these shortcomings while ensuring satisfactory performance of the actuation system under coil failure scenarios is proposed and validated. Simulation results corroborate the superior performance of the scheme.},
  keywords={Coils;Fault tolerance;Adaptation models;Transient response;Simulation;Computational modeling;Fault tolerant systems;adaptive control;gain scheduling;actuation systems;EMA;BLDC motor},
  doi={10.1109/PICC57976.2023.10142574},
  ISSN={},
  month={April},}@INPROCEEDINGS{282119,
  author={Nelson, K.D. and Macklin, F.L.},
  booktitle={[1992] Proceedings IEEE/AIAA 11th Digital Avionics Systems Conference}, 
  title={Flight results of the ring laser gyro based inertial navigation system for Atlas/Centaur}, 
  year={1992},
  volume={},
  number={},
  pages={440-445},
  abstract={The authors describe the Centaur modern avionics suite and discuss the inertial navigation flight performance. The integration of modern ring laser gyro and microprocessor technology into the Atlas/Centaur launch vehicle resulted in an order-of-magnitude improvement in orbital insertion accuracy over the previous gimbaled platform guidance system. The improved positioning accuracy minimizes the orbital correction burns required by the payload, which conserves valuable propellant required for station keeping. The upgrading of the avionics resulted in a factor-of-five reduction in recurring hardware cost and close to 200 lbs in weight reductions.<>},
  keywords={Ring lasers;Inertial navigation;Laser modes;Aerospace electronics;Microprocessors;Vehicles;Payloads;Propulsion;Hardware;Costs},
  doi={10.1109/DASC.1992.282119},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9557250,
  author={Cantanhede, Nilton Rodrigues and Santana, Ewaldo Eder Carvalho and da Silva Júnior, Paulo Fernandes and de Jesus Barros, Jonas and Freire, Raimundo Carlos Silvério},
  booktitle={2021 5th International Symposium on Instrumentation Systems, Circuits and Transducers (INSCIT)}, 
  title={Impact Point of Probing Rockets by Telemetry and Slant Range}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={In this work, is developing a method for obtaining the point of impact of a rocket by telemetry data and a Slant Range device. The trajectory data was obtained from a real flight path by merging the angular components of a telemetry antenna (azimuth and elevation) and the radial distance information provided by the Slant Range device. Position components were analyzed with the Telemetry antenna in automatic mode (in tracking), comparing with the tracking performance performed by the location radar. The result is obtained by the composition of the coordinates of the Telemetry-Slant Range set. A significant reduction in the search area can be used as an alternative form of use, providing additional location information for payload recovery around the actual point of impact.},
  keywords={Performance evaluation;Rockets;Transducers;Radar;Radar tracking;Radar antennas;Trajectory;Impact Point;Rocket;Telemetry;Slant Range},
  doi={10.1109/INSCIT49950.2021.9557250},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{111327,
  author={Nelson, K.D.},
  booktitle={9th IEEE/AIAA/NASA Conference on Digital Avionics Systems}, 
  title={Avionics systems for advanced launch vehicles}, 
  year={1990},
  volume={},
  number={},
  pages={430-435},
  abstract={A brief description of the successful pre-planned product improvement program used for the integration of modern avionics into the Centaur upper stage system is used to illustrate the implementation of evolutionary changes to an existing launch system. This concept can be used to leverage industry technology to existing vehicles as well as new programs. A common module approach to standard avionics processing capabilities is developed to provide a technology evolution plan to benefit existing and future systems and reduce the total development risk. Topics discussed include multipath redundant avionics, adaptive guidance, navigation & control, electromechanical actuators, integrated GPS (Global Positioning System) with the inertial navigation system, and laser ordnance initiation systems.<>},
  keywords={Aerospace electronics;Intelligent vehicles;Adaptive control;Navigation;Global Positioning System;Electrical equipment industry;Standards development;Programmable control;Optical control;Control systems},
  doi={10.1109/DASC.1990.111327},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{7034092,
  author={Manusubramanian, S and Sumitra, S and Samuel, Jishy},
  booktitle={International Conference on Information Communication and Embedded Systems (ICICES2014)}, 
  title={Comparative study of similarity measures for launch vehicle telemetry data}, 
  year={2014},
  volume={},
  number={},
  pages={1-7},
  abstract={Post flight analysis of launch vehicles involves comparative study of predicted preflight and flight telemetry time series data which are enormous, high dimensional and nonstationary. This inherent nature of data precludes use of manual methods and calls for data mining techniques for analyzing the similarity between the preflight and flight datasets. Hence different similarity measures like distance measures, correlation coefficients, Dynamic Time Warping (DTW) and Hidden Markov Models (HMM) are applied to the nonstationary time series data of launch vehicles. In the absence of shifts, Euclidean distance was found to be the best similarity measure while v-shift Euclidean distance gave good performance if only vertical shifts were present. Applying HMM after demeaning the data was found to give better performance in detecting similarity even when both horizontal and vertical shifts were present.},
  keywords={Hidden Markov models;Euclidean distance;Vehicles;Telemetry;Time series analysis;Time measurement;Correlation coefficient;Launch vehicle;Post flight analysis;Nonstationary time series;Data mining;Similarity measures;Hidden Markov Models (HMM);Dynamic Time Warping (DTW)},
  doi={10.1109/ICICES.2014.7034092},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{111311,
  author={Tazartes, D.A. and Mark, J.G.},
  booktitle={9th IEEE/AIAA/NASA Conference on Digital Avionics Systems}, 
  title={A fault-tolerant architecture for launch vehicle guidance and control. II. Implementation}, 
  year={1990},
  volume={},
  number={},
  pages={337-343},
  abstract={For pt.I see ibid., p.333-6 (Oct. 1990). It is indicated that fault-tolerant guidance and control systems can be employed to meet the goals of the advanced launch system. Proven redundancy management techniques are proposed for implementation in such guidance systems. The methods discussed provide a high probability of failure detection while maintaining a low probability for false alarms. A hardware architecture that stresses robustness, simplicity, and ease of verification is advocated. The channelized repartition of instruments and electronics can be modified to support different requirements and applications. The issue of simultaneous or dormant failures is addressed. The fault-tolerant architecture and implementation discussed is considered to provide excellent reliability and probability of mission success, while maintaining very reasonable costs.<>},
  keywords={Fault tolerance;Vehicles;Navigation;Fault tolerant systems;Control systems;Redundancy;Hardware;Stress;Robustness;Instruments},
  doi={10.1109/DASC.1990.111311},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{7352502,
  author={Hadi, Yulyan Wahyu and Bambang, Riyanto T.},
  booktitle={2015 International Conference on Electrical Engineering and Informatics (ICEEI)}, 
  title={Development of hardware-in-the-loop simultion for rocket guidance system}, 
  year={2015},
  volume={},
  number={},
  pages={229-234},
  abstract={This paper focused on the design and implementation of the autopilot and Proportional Navigation based guidance system on the rocket. Autopilot system is implemented with three-loop autopilot scheme with pitch and yaw acceleration command input, and two-loop autopilot to keep the roll angle fixed. Autopilot system is designed by using linear models of rockets on the state of Mach 0.7 and angle of attack 0°. Autopilot control command is obtained from the guidance system. Guidance system processing kinematics and dynamics of rockets, as well as target sensing inputs, into acceleration command in order to obtain desired movement of a rocket. Flight attitude, angular rate, and inertia of rockets are provided by the navigation system. While the target sensing inputs in the form of Line of Sight (LOS) are obtained from the seeker. Guidance and autopilot system are implemented on the ARM-based board, TWR-K60D100M, while navigation system and nonlinear models are implemented in MATLAB using the Hardware-in-the-Loop Simulation (HILS). The results showed that the designed autopilot is stable with acceptable performance in nonlinear models testing and also in digital implementation. Integration with the navigation system and HILS implementation indicate that the system is able to hit a moving target and resulted less than 5 meters final position error in windy conditions.},
  keywords={Rockets;Navigation;Acceleration;Gain;MATLAB;Testing;Kalman filters;guidance;autopilot;proportional navigation;embedded system;HILS},
  doi={10.1109/ICEEI.2015.7352502},
  ISSN={2155-6830},
  month={Aug},}@INPROCEEDINGS{6325034,
  author={Lancelle, D. and Božić, O. and Köke, H.},
  booktitle={2012 16th International Symposium on Electromagnetic Launch Technology}, 
  title={Flight test results of investigation of acceleration effects on a gun launched rocket engine}, 
  year={2012},
