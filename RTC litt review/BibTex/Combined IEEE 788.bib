  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={The rising frequency of space launches poses new challenges for North Atlantic Air Traffic Management, especially due to potential debris risks from launch failures. Large hazard areas may be required. However, their actual operational impact on air traffic is not well understood. Current procedures avoid hazard areas entirely, leading to disruptions such as inefficiencies in flight time and fuel use. This study explores the potential of dynamically managed hazard areas and tactical evacuation strategies to mitigate these effects while maintaining safety. We develop a fast-time simulation environment using the open-source simulator BlueSky, incorporating realistic hazard areas, reconstructed traffic based on real data and wind data. Simulations assess the number of affected aircraft, flight time and the impact of evacuation strategies on fuel consumption, flown distance and potential loss of separation. Results show that evacuation strategies, especially the shortest path method, can significantly reduce flight time in hazard areas with minimal impact on fuel consumption and flown distance (<1%). While the speed-up method may cause PLOS due to overtaking, safety levels are generally preserved. This study develops an open-source simulation environment to validate different impact of space activities on the Air Traffic Management in the North Atlantic airspace. The initial findings provide key insights into safety and operational efficiency aspects regarding tactical management of space launch activities and their impact on North Atlantic Air Traffic Management. Refining the new strategies could maintain operational efficiency at a high level while space activities continue to grow.},
  keywords={Rockets;Refining;Contingency management;Aerospace electronics;Hazards;Air traffic control;Fuels;Aircraft;air traffic management;North Atlantic airspace;new space;new entrants;rocket launches;hazard areas;contingency management;launch integration},
  doi={10.1109/DASC66011.2025.11257417},
  ISSN={2155-7209},
  month={Sep.},}@INPROCEEDINGS{6698510,
