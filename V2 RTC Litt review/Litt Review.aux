\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \emph  {Non-exclusive lexical signals} in the 1148 broad candidates: navigation/IMU/barometric/GPS (501), telemetry (423), flight computer/avionics (238), recovery/deployment (132), fault tolerance/redundancy (93), storage/logging (56), power/energy (27). Counts use documented regular expressions, not actual installed-hardware frequencies.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:topics}{{3}{6}{\emph {Non-exclusive lexical signals} in the 1148 broad candidates: navigation/IMU/barometric/GPS (501), telemetry (423), flight computer/avionics (238), recovery/deployment (132), fault tolerance/redundancy (93), storage/logging (56), power/energy (27). Counts use documented regular expressions, not actual installed-hardware frequencies}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Eligibility status of the \emph  {seven manually extracted competition/competition-linked examples}. Only one has a published measured apogee within 3 km (Tamkang's demonstration); four are nominal 3-km-class projects, and two are lower-altitude competition-linked projects. No prevalence, reliability or success-rate inference is warranted \blx@tocontentsinit {0}\cite {stargazer2026,astg2021aves,astg2022aves2,zlamala2024,nfu2026,zapadlo2023,kadlec2024}.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:classes}{{4}{6}{Eligibility status of the \emph {seven manually extracted competition/competition-linked examples}. Only one has a published measured apogee within 3 km (Tamkang's demonstration); four are nominal 3-km-class projects, and two are lower-altitude competition-linked projects. No prevalence, reliability or success-rate inference is warranted \cite {stargazer2026,astg2021aves,astg2022aves2,zlamala2024,nfu2026,zapadlo2023,kadlec2024}}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Descriptive design comparison, not performance evidence.} AVES II's published preflight inventory reports 2 BMP390 plus 2 MS5607 barometers (4 total), 2 BMI088 IMUs, 2 H3LIS331DL high-g sensors, 2 SAM-M8Q GNSS receivers, and 2 SD cards \blx@tocontentsinit {0}\cite {astg2022aves2}. The proposed RTC allocation includes 3 barometers, 3 MPU6050 IMUs, 1 baseline ADXL375 high-g sensor, 1 organiser GPS beacon and 1 logger SD; this proposal is \emph  {unqualified}, with separate FRAM checkpoints excluded from the SD count. Counts describe architecture only; higher counts do not establish greater reliability.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:aves2}{{5}{6}{\textbf {Descriptive design comparison, not performance evidence.} AVES II's published preflight inventory reports 2 BMP390 plus 2 MS5607 barometers (4 total), 2 BMI088 IMUs, 2 H3LIS331DL high-g sensors, 2 SAM-M8Q GNSS receivers, and 2 SD cards \cite {astg2022aves2}. The proposed RTC allocation includes 3 barometers, 3 MPU6050 IMUs, 1 baseline ADXL375 high-g sensor, 1 organiser GPS beacon and 1 logger SD; this proposal is \emph {unqualified}, with separate FRAM checkpoints excluded from the SD count. Counts describe architecture only; higher counts do not establish greater reliability}{figure.5}{}}
